import "TerminalPage.idl";

namespace TerminalApp
{
    [default_interface] runtimeclass TabRowControl : Windows.UI.Xaml.Controls.ContentPresenter,
                                                     Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        TabRowControl();
        Microsoft.UI.Xaml.Controls.TabView TabView { get; };
        Boolean ShowElevationShield;
        Boolean ShowWorkspacesButton;
        String WorkspaceName;

        String SlotBadge { get; };
        Boolean ShowSlotBadge { get; };
        String SlotBadgeTooltipTitle { get; };
        String BuildCommit { get; };
        String BuildBranch { get; };
        String BuildTime { get; };
        String BuildExePath { get; };

        Boolean PromotionAvailable;
        String PromotionDescription;
        event Windows.Foundation.TypedEventHandler<Object, Object> PromoteRequested;
        event Windows.Foundation.TypedEventHandler<Object, Object> CopyBuildInfoRequested;

        // The control pipe badge (doc/control-pipe.md). Hidden until this window
        // sees a pipe request, then a count of the ones not yet looked at; its
        // flyout lists the latest few and links to the Activity page for the rest.
        Boolean ShowPipeActivity { get; };
        Boolean HasUnseenPipeCalls { get; };
        String UnseenPipeCallCount { get; };
        void AddControlPipeCall(ControlPipeCall call);
        event Windows.Foundation.TypedEventHandler<Object, Object> ShowAllControlPipeCallsRequested;
    }
}
