<ContentPresenter x:Class="TerminalApp.TabRowControl"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="using:TerminalApp"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:mtu="using:Microsoft.Terminal.UI"
                  xmlns:mux="using:Microsoft.UI.Xaml.Controls"
                  Background="{ThemeResource TabViewBackground}"
                  mc:Ignorable="d">

    <!--
        GH#13143: Make sure that the Background is actually TabViewBackground
        here, not Transparent. This is load bearing, for showTabsInTitlebar=false.
    -->

    <!--
        Set the padding to -1 on the bottom. This prevents a small 1px gap that
        can appear on 150% scale displays between the tab item and the content.
        The 1 on top helps keep the tab the correct relative height within the
        tab row.
    -->

    <mux:TabView x:Name="TabView"
                 VerticalAlignment="Bottom"
                 HorizontalContentAlignment="Stretch"
                 AllowDropTabs="True"
                 Background="Transparent"
                 CanDragTabs="True"
                 CanReorderTabs="True"
                 IsAddTabButtonVisible="false"
                 TabWidthMode="Equal">

        <mux:TabView.TabStripHeader>
            <StackPanel Orientation="Horizontal">
                <!--  EA18 is the "Shield" glyph  -->
                <FontIcon x:Uid="ElevationShield"
                          Margin="9,4,0,4"
                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                          FontSize="16"
                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                          Glyph="&#xEA18;"
                          Visibility="{x:Bind ShowElevationShield, Mode=OneWay}" />

                <!--  Workspace/windows button  -->
                <Button x:Name="WorkspaceDropdown"
                        x:Uid="WorkspaceDropdown"
                        Margin="4,0,0,4"
                        Padding="8,0,0,0"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        Visibility="{x:Bind ShowWorkspacesButton, Mode=OneWay}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <!--  EE40 is the "TaskViewSettings" glyph  -->
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="12"
                                      Glyph="&#xEE40;" />
                            <TextBlock x:Name="WorkspaceNameText"
                                       Padding="0,0,8,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Text="{x:Bind WorkspaceName, Mode=OneWay}"
                                       Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(WorkspaceName), Mode=OneWay}" />
                        </StackPanel>
                    </Button.Content>
                    <Button.Flyout>
                        <MenuFlyout x:Name="WorkspaceFlyout" />
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </mux:TabView.TabStripHeader>

        <mux:TabView.TabStripFooter>
            <Grid>
                <!--
                    Two columns, because a single cell is what made the badge
                    invisible for as long as it existed. TabStripFooter is sized to
                    its content, NOT stretched across the tab row, so it measured
                    exactly the width of the new tab button; HorizontalAlignment
                    ="Right" then right-aligned the badge INSIDE that button rather
                    than against the caption buttons, and since the badge was
                    declared first the button painted straight over it. Measured on
                    a live window: badge x 476..512, button x 439..535.

                    Giving each its own auto-width column makes the overlap
                    impossible rather than merely unlikely, and the footer grows to
                    fit both.
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Remove this border after WinUI 2.8  -->
                <Border Grid.ColumnSpan="2"
                        Height="1"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                <!--
                    Which local slot this window is (DEV / TEST), and - in the Dev
                    slot only - an offer to promote a newer build that a deploy has
                    staged. Sits just outboard of the new tab button, and hidden
                    entirely on a normal install so it costs a real user nothing.
                -->
                <StackPanel Grid.Column="1"
                            Margin="4,4,8,6"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">

                    <!--
                        The control pipe badge (doc/control-pipe.md). Collapsed until
                        this window sees a pipe request, so a Terminal nothing drives
                        looks exactly as it did; from then on it stays, with a count of
                        the requests since its list was last opened. The list itself
                        is built in OnPipeActivityFlyoutOpening, and its last row
                        opens the Activity page for everything else.

                        MinWidth/MinHeight zeroed for the reason SlotBadgeButton
                        gives below: the default Button style would grow it.
                    -->
                    <Button x:Name="PipeActivityButton"
                            x:Uid="PipeActivityButton"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Visibility="{x:Bind ShowPipeActivity, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                            <!--  E8AF is the "Remote" glyph  -->
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="11"
                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                      Glyph="&#xE8AF;" />
                            <TextBlock VerticalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       Text="{x:Bind UnseenPipeCallCount, Mode=OneWay}"
                                       Visibility="{x:Bind HasUnseenPipeCalls, Mode=OneWay}" />
                        </StackPanel>
                        <Button.Flyout>
                            <!--
                                As wide as its longest row, up to the monitor's width:
                                the stock presenter caps a flyout at 456 and scrolls
                                sideways past that, which here only hid the ends of
                                rows. Unconstrained so it is not held to the window;
                                the content's MaxWidth is set from the monitor in
                                _rebuildPipeActivityList, and rows trim beyond it.
                            -->
                            <Flyout Opening="OnPipeActivityFlyoutOpening"
                                    Placement="BottomEdgeAlignedRight"
                                    ShouldConstrainToRootBounds="False">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="MaxWidth" Value="9999" />
                                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>
                                <StackPanel MinWidth="320"
                                            Spacing="6">
                                    <!--
                                        The rows are built in code; these give a grouped
                                        row's count the Activity page's accent pill, with
                                        brushes that follow the theme.
                                    -->
                                    <StackPanel.Resources>
                                        <Style x:Key="PipeCountPillStyle"
                                               TargetType="Border">
                                            <Setter Property="Padding" Value="6,0,6,1" />
                                            <Setter Property="CornerRadius" Value="3" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </Style>
                                        <Style x:Key="PipeCountTextStyle"
                                               TargetType="TextBlock">
                                            <Setter Property="FontSize" Value="11" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                        </Style>
                                    </StackPanel.Resources>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!--
                        Deliberately a separate control rather than a state of the
                        badge: the badge says what you are running, which is true at
                        all times, and this says something is waiting, which is not.
                        Collapsed unless there is something to promote, so the normal
                        Dev window looks exactly as it did before.
                    -->
                    <Button x:Name="PromoteSlotButton"
                            x:Uid="PromoteSlotButton"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Click="OnPromoteSlotButtonClick"
                            CornerRadius="3"
                            FontFamily="Cascadia Mono, Consolas, monospace"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind PromotionAvailable, Mode=OneWay}">
                        <ToolTipService.ToolTip>
                            <ToolTip Placement="Bottom">
                                <TextBlock TextWrapping="Wrap">
                                    <Run x:Uid="PromoteSlotButton_TooltipTitle"
                                         FontWeight="SemiBold" /> <LineBreak />
                                    <Run FontFamily="Cascadia Mono, Consolas, monospace"
                                         Text="{x:Bind PromotionDescription, Mode=OneWay}" />
                                </TextBlock>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>

                    <!--
                        A Button rather than the Border this used to be, because it
                        is now a click target: the Border gave no hover, no focus
                        rect and no automation peer, so the only way to discover the
                        copy was to be told about it, and a keyboard could not reach
                        it at all.

                        MinWidth/MinHeight are the catch. The default Button style
                        sets both to 32, where a Border has neither, so adopting the
                        style without clearing them grows the badge and shoves the
                        new tab button sideways. Zeroed here, with the Border's own
                        padding, radius and brushes carried over unchanged, so the
                        box is byte-for-byte what it was and only the states are new.

                        x:Name must not collide with the SlotBadge property, or
                        x:Bind resolves to this element.
                    -->
                    <Button x:Name="SlotBadgeButton"
                            x:Uid="SlotBadgeButton"
                            MinWidth="0"
                            MinHeight="0"
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Click="OnSlotBadgeClick"
                            CornerRadius="3"
                            Visibility="{x:Bind ShowSlotBadge}">
                        <TextBlock FontFamily="Cascadia Mono, Consolas, monospace"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   Text="{x:Bind SlotBadge}" />
                        <ToolTipService.ToolTip>
                            <ToolTip Placement="Bottom">
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold"
                                         Text="{x:Bind SlotBadgeTooltipTitle}" /> <LineBreak />
                                    <Run x:Uid="AboutDialog_CommitLabel" />
                                    <Run FontFamily="Cascadia Mono, Consolas, monospace"
                                         Text="{x:Bind BuildCommit}" />
                                    <Run Text="(" /><Run Text="{x:Bind BuildBranch}" /><Run Text=")" /> <LineBreak />
                                    <Run x:Uid="AboutDialog_BuiltLabel" />
                                    <Run Text="{x:Bind BuildTime}" /> <LineBreak />
                                    <Run FontFamily="Cascadia Mono, Consolas, monospace"
                                         Text="{x:Bind BuildExePath}" /> <LineBreak />
                                    <Run x:Uid="SlotBadgeButton_TooltipHint"
                                         FontStyle="Italic" />
                                </TextBlock>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                    </Button>
                </StackPanel>

                <mux:SplitButton x:Name="NewTabButton"
                                 x:Uid="NewTabSplitButton"
                                 Grid.Column="0"
                                 Height="24"
                                 Margin="0,4"
                                 Padding="0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Stretch"
                                 AllowDrop="True"
                                 AutomationProperties.AccessibilityView="Control"
                                 BorderThickness="0"
                                 Click="OnNewTabButtonClick"
                                 Content="&#xE710;"
                                 DragOver="OnNewTabButtonDragOver"
                                 Drop="OnNewTabButtonDrop"
                                 FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                 FontSize="12">
                    <ToolTipService.ToolTip>
                        <ToolTip Placement="Mouse">
                            <TextBlock TextWrapping="Wrap">
                                <Run x:Uid="NewTabRun" /> <LineBreak />
                                <Run x:Uid="NewPaneRun"
                                     FontStyle="Italic" /> <LineBreak />
                                <Run x:Uid="NewWindowRun"
                                     FontStyle="Italic" />
                            </TextBlock>
                        </ToolTip>
                    </ToolTipService.ToolTip>
                    <!--  U+E710 is the fancy plus icon.  -->
                    <mux:SplitButton.Resources>
                        <!--  Override the SplitButton* resources to match the tab view's button's styles.  -->
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Light">
                                    <StaticResource x:Key="SplitButtonBackground"
                                                    ResourceKey="TabViewButtonBackground" />
                                    <StaticResource x:Key="SplitButtonForeground"
                                                    ResourceKey="TabViewButtonForeground" />
                                    <StaticResource x:Key="SplitButtonBackgroundPressed"
                                                    ResourceKey="TabViewButtonBackgroundPressed" />
                                    <StaticResource x:Key="SplitButtonForegroundPressed"
                                                    ResourceKey="TabViewButtonForegroundPressed" />
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver"
                                                    ResourceKey="TabViewButtonBackgroundPointerOver" />
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver"
                                                    ResourceKey="TabViewButtonForegroundPointerOver" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Dark">
                                    <StaticResource x:Key="SplitButtonBackground"
                                                    ResourceKey="TabViewButtonBackground" />
                                    <StaticResource x:Key="SplitButtonForeground"
                                                    ResourceKey="TabViewButtonForeground" />
                                    <StaticResource x:Key="SplitButtonBackgroundPressed"
                                                    ResourceKey="TabViewButtonBackgroundPressed" />
                                    <StaticResource x:Key="SplitButtonForegroundPressed"
                                                    ResourceKey="TabViewButtonForegroundPressed" />
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver"
                                                    ResourceKey="TabViewButtonBackgroundPointerOver" />
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver"
                                                    ResourceKey="TabViewButtonForegroundPointerOver" />
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="HighContrast">
                                    <StaticResource x:Key="SplitButtonBackground"
                                                    ResourceKey="TabViewButtonBackground" />
                                    <StaticResource x:Key="SplitButtonForeground"
                                                    ResourceKey="TabViewButtonForeground" />
                                    <StaticResource x:Key="SplitButtonBackgroundPressed"
                                                    ResourceKey="TabViewButtonBackgroundPressed" />
                                    <StaticResource x:Key="SplitButtonForegroundPressed"
                                                    ResourceKey="TabViewButtonForegroundPressed" />
                                    <StaticResource x:Key="SplitButtonBackgroundPointerOver"
                                                    ResourceKey="TabViewButtonBackgroundPointerOver" />
                                    <StaticResource x:Key="SplitButtonForegroundPointerOver"
                                                    ResourceKey="TabViewButtonForegroundPointerOver" />
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                            <x:Double x:Key="SplitButtonPrimaryButtonSize">31</x:Double>
                            <x:Double x:Key="SplitButtonSecondaryButtonSize">31</x:Double>
                        </ResourceDictionary>
                    </mux:SplitButton.Resources>
                </mux:SplitButton>
            </Grid>
        </mux:TabView.TabStripFooter>

    </mux:TabView>

</ContentPresenter>
