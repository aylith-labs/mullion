<UserControl x:Class="TerminalApp.LinkPreviewPaneContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:TerminalApp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mtu="using:Microsoft.Terminal.UI"
             xmlns:mux="using:Microsoft.UI.Xaml.Controls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!--  Same value MarkdownPaneContent uses: SolidBackgroundFillColorTertiary.  -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="PageBackground">#282828</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="PageBackground">#F9F9F9</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="PageBackground"
                                    ResourceKey="SystemColorWindowColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Padding="12,10"
          Background="{ThemeResource PageBackground}"
          RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Which integration answered, and the two things you can do to the pane itself.  -->
        <Grid x:Name="PaneChromeHeader" Grid.Row="0"
              ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="HeaderIcon"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            IsTabStop="False" />
            <TextBlock x:Name="IntegrationName"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Opacity="0.7" />
            <!--  MinWidth/MinHeight are zeroed because the default style floors the ring above 16 px.  -->
            <mux:ProgressRing x:Name="LoadingRing"
                              Grid.Column="2"
                              Width="16"
                              Height="16"
                              MinWidth="0"
                              MinHeight="0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              IsActive="False"
                              Visibility="Collapsed" />

            <!--  "Show <integration> page": labelled from code with the integration's name, and only shown when it has a page to show.  -->
            <Button x:Name="EmbedButton"
                    Grid.Column="3"
                    Padding="8,2"
                    Click="_embedClick"
                    Visibility="Collapsed" />
            <Button x:Name="RefreshButton"
                    x:Uid="LinkPreviewRefreshButton"
                    Grid.Column="4"
                    Padding="6,2"
                    Click="_refreshClick">
                <FontIcon FontFamily="Segoe UI, Segoe Fluent Icons, Segoe MDL2 Assets"
                          FontSize="12"
                          Glyph="&#xE72C;" />
            </Button>
            <Button x:Name="CloseButton"
                    x:Uid="LinkPreviewCloseButton"
                    Grid.Column="5"
                    Padding="6,2"
                    Click="_closeClick">
                <FontIcon FontFamily="Segoe UI, Segoe Fluent Icons, Segoe MDL2 Assets"
                          FontSize="12"
                          Glyph="&#xE8BB;" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="6">
            <HyperlinkButton x:Name="SourceLink" Padding="0" HorizontalAlignment="Left">
                <TextBlock x:Name="SourceLinkText" TextWrapping="Wrap" />
            </HyperlinkButton>

            <!--
                The ticket and whatever it hangs off, the way Jira's own breadcrumb
                reads: AT-33 / AT-144, each with its work type's icon. Filled in by
                _render from the fields a manifest placed here, and empty for every
                integration that places none.
            -->
            <StackPanel x:Name="TicketBreadcrumbHost"
                        Orientation="Horizontal"
                        Spacing="4" />

            <TextBlock x:Name="TitleText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       IsTextSelectionEnabled="True"
                       TextWrapping="Wrap">
                <TextBlock.ContextFlyout>
                    <mtu:TextMenuFlyout />
                </TextBlock.ContextFlyout>
            </TextBlock>

            <!--
                The status badge belongs beside the dropdown that changes it and
                centred on that dropdown, so the form of required fields and the
                error line go in rows below it rather than in a column beside it:
                centring a badge against a column that grows walks it off the
                control it describes.

                A Grid and not two stacked StackPanels, for two reasons. The badge
                is centred on row 0, which holds the dropdown and nothing else,
                whatever appears underneath. And an Auto row whose only child is
                collapsed is zero high, full stop, where a StackPanel's Spacing
                between collapsed children is an implementation detail none of
                this should depend on; the gaps here are margins on the rows that
                come and go.
            -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="TicketStatusHost"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center" />
                <StackPanel x:Name="ActionRow"
                            Grid.Row="0"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="Collapsed">
                    <TextBox x:Name="ActionFilter"
                             x:Uid="LinkPreviewActionFilter"
                             Width="140"
                             VerticalAlignment="Center"
                             IsSpellCheckEnabled="False"
                             TextChanged="_filterChanged"
                             Visibility="Collapsed" />
                    <ComboBox x:Name="ActionOptions"
                              x:Uid="LinkPreviewActionOptions"
                              MinWidth="180"
                              SelectionChanged="_optionChanged" />
                    <Button x:Name="ApplyButton"
                            x:Uid="LinkPreviewApplyButton"
                            VerticalAlignment="Center"
                            Click="_applyClick" />
                    <Button x:Name="UndoButton"
                            x:Uid="LinkPreviewUndoButton"
                            VerticalAlignment="Center"
                            Click="_undoClick"
                            Visibility="Collapsed" />
                    <mux:ProgressRing x:Name="ActionProgress"
                                      Width="16"
                                      Height="16"
                                      MinWidth="0"
                                      MinHeight="0"
                                      VerticalAlignment="Center"
                                      IsActive="False"
                                      Visibility="Collapsed" />
                </StackPanel>

                <StackPanel x:Name="ActionFields"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="0,6,0,0"
                            Spacing="4"
                            Visibility="Collapsed" />

                <TextBlock x:Name="ActionError"
                           Grid.Row="2"
                           Grid.ColumnSpan="2"
                           Margin="0,6,0,0"
                           Opacity="0.8"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>

            <StackPanel x:Name="TicketMetadataHost" Orientation="Horizontal" Spacing="8" />
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Opacity="0.8"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel x:Name="TabStrip"
                    Grid.Row="3"
                    Orientation="Horizontal"
                    Spacing="2"
                    Visibility="Collapsed" />

        <ScrollViewer x:Name="ContentScroll"
                      Grid.Row="4"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled"
                      IsTabStop="False"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <ContentControl x:Name="FilePreviewHost" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                <StackPanel x:Name="FieldsHost"
                            Spacing="10" />
                <StackPanel x:Name="BodyHost"
                            Visibility="Collapsed" />
                <StackPanel x:Name="CommentsHost"
                            Spacing="10"
                            Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>

        <!--
            The integration's own page, in place of the summary while it is showing.
            Microsoft.Terminal.Control.WebEmbedHost draws it as a composition visual of
            this Grid and forwards the Grid's pointer input to it, which is why it needs
            a Background: without one it is not hit-testable.
        -->
        <Grid x:Name="EmbedHost"
              Grid.Row="3"
              Grid.RowSpan="2"
              Background="Transparent"
              Visibility="Collapsed" />



        <StackPanel Grid.Row="6" Spacing="8">
            <ToggleButton x:Name="PinLinkButton"
                          Content="Pin link"
                          HorizontalAlignment="Left"
                          ToolTipService.ToolTip="Keep this link. Other hovered links appear temporarily."
                          Click="_pinClick" />
            <ToggleSwitch x:Name="HideTooltipsSwitch"
                          x:Uid="LinkPreviewHideTooltipsSwitch"
                          Toggled="_hideTooltipsToggled" />
        </StackPanel>
    </Grid>
</UserControl>
