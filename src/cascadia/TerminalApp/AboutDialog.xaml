<ContentDialog x:Class="TerminalApp.AboutDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:local="using:TerminalApp"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:mtu="using:Microsoft.Terminal.UI"
               xmlns:mux="using:Microsoft.UI.Xaml.Controls"
               x:Uid="AboutDialog"
               DefaultButton="Close"
               PrimaryButtonClick="_ReportIssueOnClick"
               Style="{StaticResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <!--
        Two tabs. About says which build this is and where Mullion lives; Release
        notes lists what each CI build of main brought, newest first, compiled in
        from tools/Write-ReleaseNotes.ps1. The Store update check, the privacy
        policy and the third-party notices were upstream's and say nothing about
        this build, so they are gone: a slot is updated by promotion, never by
        the Store.
    -->
    <Pivot x:Name="AboutTabs"
           Margin="-12,-8,-12,0">
        <PivotItem x:Uid="AboutDialog_AboutTab">
            <StackPanel Padding="0,8,0,0"
                        Orientation="Vertical">
                <TextBlock IsTextSelectionEnabled="True">
                    <TextBlock.ContextFlyout>
                        <mtu:TextMenuFlyout />
                    </TextBlock.ContextFlyout>
                    <Run AutomationProperties.HeadingLevel="1"
                         Text="{x:Bind ApplicationDisplayName}" /> <LineBreak />
                    <Run x:Uid="AboutDialog_VersionLabel" />
                    <Run Text="{x:Bind ApplicationVersion}" /> <LineBreak />
                    <Run x:Uid="AboutDialog_CommitLabel" />
                    <Run FontFamily="Cascadia Mono, Consolas, monospace"
                         Text="{x:Bind BuildCommit}" />
                    <Run Text="(" /><Run Text="{x:Bind BuildBranch}" /><Run Text=")" /> <LineBreak />
                    <Run x:Uid="AboutDialog_BuiltLabel" />
                    <Run Text="{x:Bind BuildTime}" /> <LineBreak />
                    <Run FontFamily="Cascadia Mono, Consolas, monospace"
                         Text="{x:Bind BuildExePath}" />
                </TextBlock>

                <HyperlinkButton x:Uid="AboutDialog_CopyBuildInfoButton"
                                 Margin="-12,0,0,0"
                                 Click="_CopyBuildInfoOnClick" />

                <StackPanel Margin="-12,12,0,0"
                            Orientation="Vertical">
                    <HyperlinkButton x:Uid="AboutDialog_SourceCodeLink"
                                     NavigateUri="https://github.com/aylith-labs/mullion" />
                    <HyperlinkButton x:Uid="AboutDialog_DocumentationLink"
                                     NavigateUri="https://mullion.aylith.com" />
                </StackPanel>
            </StackPanel>
        </PivotItem>

        <PivotItem x:Uid="AboutDialog_ReleaseNotesTab">
            <Grid Padding="0,8,0,0">
                <TextBlock x:Name="ReleaseNotesEmpty"
                           x:Uid="AboutDialog_ReleaseNotesEmpty"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <ScrollViewer MaxHeight="420"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <!--  One Expander per build, filled in by AboutDialog::_PopulateReleaseNotes.  -->
                    <StackPanel x:Name="ReleaseNotesList"
                                Padding="0,0,12,8"
                                Spacing="4" />
                </ScrollViewer>
            </Grid>
        </PivotItem>
    </Pivot>
</ContentDialog>
