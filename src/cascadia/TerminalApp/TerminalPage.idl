import "TaskbarState.idl";
import "Remoting.idl";

namespace TerminalApp
{
    [default_interface] runtimeclass ContentManager
    {
        Microsoft.Terminal.Control.IContentHandle CreateCore(Microsoft.Terminal.Control.IControlSettings settings,
                                                             Microsoft.Terminal.Control.IControlAppearance unfocusedAppearance,
                                                             Microsoft.Terminal.TerminalConnection.ITerminalConnection connection);

        Microsoft.Terminal.Control.IContentHandle TryLookupCore(UInt64 id);
        void Detach(Microsoft.Terminal.Control.TermControl control);
    }

    [default_interface] runtimeclass RenameWindowRequestedArgs
    {
        String ProposedName { get; };
    };
    [default_interface] runtimeclass OpenWindowRequestedArgs
    {
        String Name { get; };
    };
    [default_interface] runtimeclass SummonWindowByIdRequestedArgs
    {
        UInt64 WindowId { get; };
    };
    [default_interface] runtimeclass RequestMoveContentArgs
    {
        String Window { get; };
        String Content { get; };
        UInt32 TabIndex { get; };
        Windows.Foundation.IReference<Windows.Foundation.Point> WindowPosition { get; };
    };

    interface IDialogPresenter
    {
        Windows.Foundation.IAsyncOperation<Windows.UI.Xaml.Controls.ContentDialogResult> ShowDialog(Windows.UI.Xaml.Controls.ContentDialog dialog);
    };

    [default_interface] runtimeclass WindowProperties : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        String WindowName { get; };
        UInt64 WindowId { get; };
        String WindowNameForDisplay { get; };
        String WindowIdForDisplay { get; };

        String VirtualWorkingDirectory { get; set; };
        String VirtualEnvVars { get; set; };

        Boolean IsQuakeWindow();
    };

    runtimeclass LaunchPositionRequest
    {
        Microsoft.Terminal.Settings.Model.LaunchPosition Position;
    }

    [default_interface] runtimeclass WindowListEntry
    {
        WindowListEntry();
        UInt64 Id;
        String Name;
    }

    // Raised by TerminalPage when it needs the list of open windows.
    // The handler (AppHost) fills Entries synchronously.
    [default_interface] runtimeclass WindowListRequest
    {
        Windows.Foundation.Collections.IVector<WindowListEntry> Entries { get; };
    }

    // ------------------------------------------------------------------
    // The control pipe (see doc/control-pipe.md). These are the types the
    // named pipe server in WindowsTerminal.exe uses to reach into a window's
    // panes. Everything here runs on the UI thread; the pipe threads only ever
    // touch it through WindowEmperor's message window.
    // ------------------------------------------------------------------

    enum ControlPipeStatus
    {
        Ok = 0,
        // The window/tab/pane triple doesn't name a live terminal pane.
        NoSuchPane = 1,
        // requireContains was not on the pane's screen; nothing was written.
        NeedleGone = 2,
        // The pane's connection has already closed; nothing was written.
        Disconnected = 3,
        // run-action: the settings model did not read the JSON as an action;
        // nothing was done.
        BadAction = 4
    };

    struct ControlPipeActionResult
    {
        ControlPipeStatus Status;
        // Only meaningful when Status is Ok: whether a handler took the action,
        // the same answer a key binding gets.
        Boolean Handled;
    };

    // Deliberately carries no pane text: enumerating panes is on the caller's
    // polling path, and the text is what makes that expensive.
    struct ControlPipePaneInfo
    {
        UInt32 TabIndex;
        UInt32 PaneId;
        String Title;
        // Focused within its tab, and its tab is the active one.
        Boolean Focused;
        UInt32 ProcessId;
        // The connection's session id, the same one WT_SESSION carries.
        Guid SessionId;
        // False once the pane's process has exited. The pane is still listed
        // and can still be captured - its last screen is often the interesting
        // part - but a write to it would answer `disconnected`.
        Boolean Alive;
    };

    struct ControlPipeCaptureResult
    {
        ControlPipeStatus Status;
        String Text;
    };

    // One control pipe request, as the tab row's pipe badge lists it. Built by
    // WindowEmperor from what the pipe thread recorded; the full record, text
    // and all, is the activity log's controlPipe event.
    struct ControlPipeCall
    {
        // When it was answered, in Unix seconds. The flyout shows it either as
        // "3 minutes ago" or as the local date and time.
        Int64 When;
        // The client's image name and pid, "powershell.exe (4242)".
        String Client;
        // The wire op, "send-input", or "unparsed".
        String Operation;
        // The pane address or session id it named, or empty.
        String Target;
        // What it asked for, shortened for a glance.
        String Detail;
        // "ok" or the error it was answered, plus what came back.
        String Result;
        Boolean Ok;
        // The client's image name without its pid, "powershell.exe": what
        // grouping compares, since a one-shot client has a new pid every call.
        String Program;
        // What the client said about itself (empty when refused for not saying):
        // why it asked, and which program and code path asked.
        String Reason;
        String Caller;
        // The client's parent chain as Windows sees it, nearest first.
        String Ancestry;
    };

    [default_interface] runtimeclass TerminalPage : Windows.UI.Xaml.Controls.Page, Windows.UI.Xaml.Data.INotifyPropertyChanged, Microsoft.Terminal.UI.IDirectKeyListener
    {
        TerminalPage(WindowProperties properties, ContentManager manager);

        // XAML bound properties
        String ApplicationDisplayName { get; };
        String ApplicationVersion { get; };

        Boolean FocusMode { get; };
        Boolean Fullscreen { get; };
        Boolean AlwaysOnTop { get; };

        WindowProperties WindowProperties { get; };
        void IdentifyWindow();

        String SavedActionName { get; };
        String SavedActionKeyChord { get; };
        String SavedActionCommandLine { get; };

        // We cannot use the default XAML APIs because we want to make sure
        // that there's only one application-global dialog visible at a time,
        // and because of GH#5224.
        IDialogPresenter DialogPresenter;

        TaskbarState TaskbarState{ get; };

        Windows.UI.Xaml.Media.Brush TitlebarBrush { get; };
        void WindowActivated(Boolean activated);
        void SendContentToOther(RequestReceiveContentArgs args);

        event Windows.Foundation.TypedEventHandler<Object, Object> TitleChanged;
        event Windows.Foundation.TypedEventHandler<Object, Object> CloseWindowRequested;
        event Windows.Foundation.TypedEventHandler<Object, Windows.UI.Xaml.UIElement> SetTitleBarContent;
        event Windows.Foundation.TypedEventHandler<Object, Object> FocusModeChanged;
        event Windows.Foundation.TypedEventHandler<Object, Object> FullscreenChanged;
        event Windows.Foundation.TypedEventHandler<Object, Object> AlwaysOnTopChanged;
        event Windows.Foundation.TypedEventHandler<Object, Object> Initialized;
        event Windows.Foundation.TypedEventHandler<Object, Object> SetTaskbarProgress;
        event Windows.Foundation.TypedEventHandler<Object, Object> IdentifyWindowsRequested;
        event Windows.Foundation.TypedEventHandler<Object, RenameWindowRequestedArgs> RenameWindowRequested;
        event Windows.Foundation.TypedEventHandler<Object, Object> SummonWindowRequested;
        event Windows.Foundation.TypedEventHandler<Object, SummonWindowByIdRequestedArgs> SummonWindowByIdRequested;
        event Windows.Foundation.TypedEventHandler<Object, Microsoft.Terminal.Control.WindowSizeChangedEventArgs> WindowSizeChanged;

        event Windows.Foundation.TypedEventHandler<Object, Object> OpenSystemMenu;
        event Windows.Foundation.TypedEventHandler<Object, Microsoft.Terminal.Control.ShowWindowArgs> ShowWindowChanged;
        event Windows.Foundation.TypedEventHandler<Object, Windows.Foundation.Collections.IVectorView<Microsoft.Terminal.Settings.Model.SettingsLoadWarnings> > ShowLoadWarningsDialog;

        event Windows.Foundation.TypedEventHandler<Object, RequestMoveContentArgs> RequestMoveContent;
        event Windows.Foundation.TypedEventHandler<Object, RequestReceiveContentArgs> RequestReceiveContent;

        event Windows.Foundation.TypedEventHandler<Object, LaunchPositionRequest> RequestLaunchPosition;
        event Windows.Foundation.TypedEventHandler<Object, WindowListRequest> RequestWindowList;

        // Raised when the page wants the monarch to open (or summon) a
        // named window in-process, restoring its persisted workspace if
        // one exists. No new wt.exe process is spawned.
        event Windows.Foundation.TypedEventHandler<Object, OpenWindowRequestedArgs> RequestOpenWindow;

        event Windows.Foundation.TypedEventHandler<Object, WindowRequestedArgs> RequestNewWindow;
    }
}
