import "IControlSettings.idl";

namespace Microsoft.Terminal.Control
{
    enum HyperlinkPreviewFieldKind
    {
        Text = 0,
        Title,
        Subtitle,
        Badge,
        Link,
        Image,
        Multiline
    };

    // One row of a rendered link preview.
    [default_interface] runtimeclass HyperlinkPreviewField
    {
        HyperlinkPreviewField();

        String Label;
        String Value;
        HyperlinkPreviewFieldKind Kind;
        String IconUri;
        String Placement;
        String LinkUri;
        String Color;
        // The group this field belongs to, so a surface with room can show
        // them under headings. Empty means the integration declared no groups.
        String Group;
        String GroupLabel;

        // Template conveniences (x:Bind cannot compare enums in markup).
        Boolean IsTitle { get; };
        Boolean IsRow { get; };
        Boolean IsBadge { get; };
        Boolean IsPlain { get; };
        Boolean HasIcon { get; };
    }

    // What a tab holds. Fields is the built-in first tab (the label/value list).
    enum HyperlinkPreviewTabKind
    {
        Fields = 0,
        Body,
        Comments
    };

    // One authored entry in a Comments tab.
    [default_interface] runtimeclass HyperlinkPreviewComment
    {
        HyperlinkPreviewComment();

        String Author;
        String AvatarUri;
        String Body;
        String Time;
    }

    [default_interface] runtimeclass HyperlinkPreviewTab
    {
        HyperlinkPreviewTab();

        String Key;
        String Label;
        HyperlinkPreviewTabKind Kind;
        // Body tabs: the text, and "markdown" or "text" for how to render it.
        String Body;
        String Format;
        Windows.Foundation.Collections.IVector<HyperlinkPreviewComment> Comments;
        // The tab is a name with nothing behind it yet: the content is fetched
        // and built by GetTabAsync when the user first opens it, which is what
        // keeps a hundred comments off the path that paints the card.
        Boolean Pending;
    }

    // A value the far end wants before it will accept an action.
    [default_interface] runtimeclass HyperlinkPreviewActionField
    {
        HyperlinkPreviewActionField();

        String Key;
        String Label;
        Boolean Required;
        // Non-empty when the field is a choice of its own.
        Windows.Foundation.Collections.IVector<String> Options;
    }

    [default_interface] runtimeclass HyperlinkPreviewActionOption
    {
        HyperlinkPreviewActionOption();

        String Id;
        String Label;
        String Badge;
        String Color;
        Windows.Foundation.Collections.IVector<HyperlinkPreviewActionField> Fields;
        Boolean NeedsFields { get; };
    }

    // Something the user can do to the thing behind the link.
    [default_interface] runtimeclass HyperlinkPreviewAction
    {
        HyperlinkPreviewAction();

        String Key;
        String Label;
        Windows.Foundation.Collections.IVector<HyperlinkPreviewActionOption> Options;
    }

    // What running an action did. UndoChoiceId is the option that puts things
    // back, when the far end offers one; empty when it does not.
    [default_interface] runtimeclass HyperlinkActionResult
    {
        HyperlinkActionResult();

        Boolean Ok;
        String Error;
        String UndoChoiceId;
        String UndoLabel;
    }

    // What an integration produced for a hovered link (or text match).
    [default_interface] runtimeclass HyperlinkPreview
    {
        HyperlinkPreview();

        String IntegrationId;
        String IntegrationName;
        String IntegrationIcon;
        Windows.Foundation.Collections.IVector<HyperlinkPreviewField> Fields;
        // Optional rendered HTML representation; empty means "use Fields".
        String Html;
        // The raw JSON the integration's steps produced, handed to an HTML representation
        // as window.__data so a plugin can render from the data instead of from Fields.
        String DataJson;
        // The integration's full, embeddable view of the linked thing, already expanded.
        // Non-empty puts a "Details" button on the card that shows it in a WebView2.
        String EmbedUrl;
        // Non-empty when the fetch failed; shown in place of the fields.
        String Error;
        // For text matches: the URL the match resolves to.
        String ResolvedUri;
        // Secondary content the user turned on, and the things they can do.
        Windows.Foundation.Collections.IVector<HyperlinkPreviewTab> Tabs;
        Windows.Foundation.Collections.IVector<HyperlinkPreviewAction> Actions;
        // Echoed back so a refresh or an action can be run against the same
        // thing without the caller having to remember what produced it.
        String SourceText;
        String FilePath;
        String FileKind;
        Windows.Foundation.Collections.IVector<HyperlinkPreviewTab> FileSections;
    }

    // Implemented by the app (which owns integrations and credentials) and
    // handed to TermControl, which only knows how to render the result.
    interface IHyperlinkPreviewProvider
    {
        // Match -> URL, or "" when nothing claims the text.
        //
        // Both matcher kinds are consulted. Text matchers are the obvious case
        // ("CAB-8209" is not a URI and only an integration knows what it
        // stands for), but a LINK matcher's `link` template matters just as
        // much: a scheme the manifest owns, like stith://, is not something
        // ShellExecute can open unless an OS protocol handler happens to be
        // registered and happens to implement that verb. Resolving it here
        // means the terminal follows the http(s) form the manifest declares.
        String ResolveLink(String text, String integrationHint);
        // The action the matched matcher binds to opening, or "" to follow
        // ResolveLink's URL instead. Names an `actions` entry of the owning
        // manifest, or a built-in button id.
        String ResolveOpenAction(String text, String integrationHint);
        // integrationHint: "" = automatic, "none" = never, else an integration id.
        Boolean CanPreview(String text, String integrationHint);
        void InvokeLinkAction(String text, IControlSettings settings, String actionId);
        Windows.UI.Xaml.FrameworkElement CreatePreviewView(String text, IControlSettings settings, Int32 depth);
        Windows.Foundation.IAsyncOperation<HyperlinkPreview> GetFilePreviewAsync(String resolvedFilePath);
        Windows.Foundation.IAsyncOperation<HyperlinkPreview> GetPreviewAsync(String text, String integrationHint);
        // Same, but ignores (and replaces) anything cached -- what to call
        // after an action has changed the thing being previewed.
        Windows.Foundation.IAsyncOperation<HyperlinkPreview> RefreshAsync(String text, String integrationHint);
        // One tab's content, built now. Answers a tab the preview handed over
        // Pending: the surface asks for it when the user opens that tab, and
        // the result replaces the shell in the preview's Tabs. Null when
        // nothing claims the text any more, or when the tab has since gone.
        Windows.Foundation.IAsyncOperation<HyperlinkPreviewTab> GetTabAsync(String text, String integrationHint, String tabKey);
        // Runs one of the preview's actions. choiceId is the picked option for
        // a Choice action, empty for a Button; fieldValues carries whatever the
        // option said it needed.
        Windows.Foundation.IAsyncOperation<HyperlinkActionResult> InvokeActionAsync(String text,
                                                                                   String integrationHint,
                                                                                   String actionKey,
                                                                                   String choiceId,
                                                                                   Windows.Foundation.Collections.IMap<String, String> fieldValues);
    }

    // x:Bind helpers for the card's preview template.
    static runtimeclass HyperlinkPreviewHelpers
    {
        static Windows.UI.Xaml.Controls.RichTextBlock CreateTextView(String text, IHyperlinkPreviewProvider provider, IControlSettings settings, Boolean compact, Int32 depth);
        static void AttachLinkTooltips(Windows.UI.Xaml.FrameworkElement root, IHyperlinkPreviewProvider provider, IControlSettings settings, Boolean compact, Int32 depth);
        static Boolean HasNestedPreview { get; };
        static Windows.UI.Xaml.FrameworkElement CreateFileView(HyperlinkPreview preview, Boolean compact);
        static Windows.UI.Xaml.Media.Brush BadgeBrush(String color);
        static Windows.UI.Xaml.Media.ImageSource ImageFromUri(String uri);
    }
}
