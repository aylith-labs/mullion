<Page x:Class="Microsoft.Terminal.Settings.Editor.Activity"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Microsoft.Terminal.Settings.Editor"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                One row: either one recorded event, or a group of them collapsed
                into one line with a count and the time it was first seen.

                System brushes only in here, and that is not a style preference.
                A custom key defined in a control's own ThemeDictionaries is not
                resolvable from inside a DataTemplate, and the failure is a
                process fail-fast (0xc000027b) whose stack blames measure rather
                than the template. The activity pane cost two build round trips
                learning that.

                The command column is last and takes the remaining width, which
                is why hiding it needs nothing but a collapsed TextBlock: the
                empty space it leaves is at the right edge, where it reads as
                margin. Every other column is a fixed width, because each row is
                its own Grid and only a fixed width makes them line up.
            -->
            <DataTemplate x:Key="ActivityItemTemplate"
                          x:DataType="local:ActivityEntryViewModel">
                <Grid Margin="0,8"
                      ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                VerticalAlignment="Top">
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind TimestampDisplay}"
                                   TextWrapping="Wrap"
                                   ToolTipService.ToolTip="{x:Bind TimestampTooltip}" />
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="{x:Bind RangeText}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind HasRange}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Spacing="4">
                        <TextBlock FontWeight="SemiBold"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Text="{x:Bind ExeName}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4">
                            <Border Padding="6,1"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    CornerRadius="3"
                                    ToolTipService.ToolTip="{x:Bind EventTooltip}">
                                <TextBlock FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind EventLabel}" />
                            </Border>
                            <Border Padding="6,1"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3"
                                    Visibility="{x:Bind IsGroup}">
                                <TextBlock FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                           Text="{x:Bind CountText}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Spacing="4">
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind WorkingDirectory}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind HasWorkingDirectory}" />
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind ParentExe}"
                                   TextWrapping="Wrap"
                                   Visibility="{x:Bind HasParent}" />
                    </StackPanel>

                    <!--  The command is the evidence, so it remains selectable.  -->
                    <TextBlock Grid.Column="3"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               IsTextSelectionEnabled="True"
                               Text="{x:Bind CommandLine}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ShowCommandLineInline}" />

                    <!--
                        The row's popover. It carries the command line when the
                        command column is hidden, which is the whole point of
                        being able to hide it, and always carries the exact time
                        and what kind of event this was, so it is never empty.

                        A bare StackPanel rather than an explicit ToolTip, and
                        last rather than first: this is the shape MainPage's
                        search suggestions already prove works for x:Bind inside
                        a tooltip inside a DataTemplate.
                    -->
                    <ToolTipService.ToolTip>
                        <StackPanel MaxWidth="560"
                                    Spacing="6">
                            <TextBlock FontFamily="Cascadia Mono, Consolas"
                                       FontSize="12"
                                       Text="{x:Bind CommandLine}"
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind ShowCommandLineInTooltip}" />
                            <TextBlock FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind HoverSummary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ToolTipService.ToolTip>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Spacing="2"
                Style="{StaticResource SettingsStackStyle}">

        <!--
            Recording, the cap that bounds the file, and where the file is. A
            master switch plus the settings it gates is exactly the shape
            SettingsExpander exists for. IsForkFeature goes on the expander only,
            which forwards the mark to the card that draws its header. IsEnabled
            is repeated on the nested card rather than set on the expander,
            because setting it there would disable the header and make the toggle
            that gates it unclickable.
        -->
        <local:SettingsExpander x:Name="ActivityLog"
                                x:Uid="Globals_ActivityLog"
                                IsForkFeature="True">
            <local:SettingsExpander.Content>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ActivityLog, Mode=TwoWay}"
                              Style="{StaticResource ToggleSwitchInExpanderStyle}" />
            </local:SettingsExpander.Content>
            <local:SettingsExpander.Items>
                <local:SettingsCard x:Name="ActivityLogMaxKilobytes"
                                    x:Uid="Globals_ActivityLogMaxKilobytes"
                                    IsEnabled="{x:Bind ViewModel.ActivityLog, Mode=OneWay}">
                    <muxc:NumberBox x:Uid="Globals_ActivityLogMaxKilobytesBox"
                                    Maximum="1048576"
                                    Minimum="64"
                                    SpinButtonPlacementMode="Compact"
                                    Style="{StaticResource NumberBoxSettingStyle}"
                                    Value="{x:Bind ViewModel.ActivityLogMaxKilobytes, Mode=TwoWay}" />
                </local:SettingsCard>

                <!--
                    The path gets a row of its own rather than the card's
                    right-hand content column, where a long path wrapped into a
                    narrow ribbon and pushed the header into one word per line.

                    HorizontalContentAlignment="Left" is required, not
                    decorative: ContentAlignment="Vertical" only stretches the
                    presenter across the row, and SettingsCard then propagates
                    the card's own HorizontalContentAlignment to it, which the
                    style defaults to Right.
                -->
                <local:SettingsCard x:Name="ActivityLogPath"
                                    x:Uid="Globals_ActivityLogPath"
                                    ContentAlignment="Vertical"
                                    HorizontalContentAlignment="Left">
                    <StackPanel HorizontalAlignment="Left"
                                Spacing="8">
                        <TextBlock FontFamily="Cascadia Mono, Consolas"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind ViewModel.LogPath, Mode=OneWay}"
                                   TextWrapping="Wrap" />
                        <Button x:Uid="Activity_Reveal"
                                HorizontalAlignment="Left"
                                Click="RevealButton_Click"
                                IsEnabled="{x:Bind ViewModel.HasLogPath, Mode=OneWay}"
                                Style="{StaticResource BrowseButtonStyle}" />
                    </StackPanel>
                </local:SettingsCard>
            </local:SettingsExpander.Items>
        </local:SettingsExpander>

        <TextBlock x:Uid="Activity_RecordedHeader"
                   Style="{StaticResource TextBlockSubHeaderStyle}" />

        <!--
            How the list is narrowed and how it is summarised. One accordion
            rather than a run of loose cards, because none of these mean anything
            on their own, and expanded by default because arriving at a page
            whose controls are hidden is worse than a tall page.

            The search box and the reload button sit in the collapsed header row:
            they are what gets used on every visit.
        -->
        <local:SettingsExpander x:Name="ActivityFilter"
                                x:Uid="Activity_Filter"
                                IsExpanded="True"
                                IsForkFeature="True">
            <local:SettingsExpander.Content>
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <TextBox x:Name="FilterBox"
                             x:Uid="Activity_FilterBox"
                             MinWidth="220"
                             Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button x:Uid="Activity_Refresh"
                            Click="RefreshButton_Click">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="12"
                                  Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
            </local:SettingsExpander.Content>
            <local:SettingsExpander.Items>

                <!--
                    Grouping collapses rows; the three filters below narrow them.
                    "Identical commands" is the one that earns its place: most of
                    a real log is the same scheduled command repeating, and one
                    row with a count answers at a glance what a hundred rows do
                    not. The other three are the same summary by a different key.

                    The order of the items here is the order KindOrder and
                    GroupMode are written in Activity.cpp, and the binding is by
                    index, so the two lists have to stay in step.
                -->
                <local:SettingsCard x:Name="ActivityGroupBy"
                                    x:Uid="Activity_GroupBy">
                    <ComboBox AutomationProperties.AccessibilityView="Content"
                              SelectedIndex="{x:Bind ViewModel.GroupModeIndex, Mode=TwoWay}"
                              Style="{StaticResource ComboBoxSettingStyle}">
                        <ComboBoxItem x:Uid="Activity_GroupByNone" />
                        <ComboBoxItem x:Uid="Activity_GroupByCommand" />
                        <ComboBoxItem x:Uid="Activity_GroupByProgram" />
                        <ComboBoxItem x:Uid="Activity_GroupByEvent" />
                        <ComboBoxItem x:Uid="Activity_GroupByDay" />
                    </ComboBox>
                </local:SettingsCard>

                <local:SettingsCard x:Name="ActivityEventFilter"
                                    x:Uid="Activity_EventFilter">
                    <ComboBox AutomationProperties.AccessibilityView="Content"
                              SelectedIndex="{x:Bind ViewModel.KindChoiceIndex, Mode=TwoWay}"
                              Style="{StaticResource ComboBoxSettingStyle}">
                        <ComboBoxItem x:Uid="Activity_EventFilterAll" />
                        <ComboBoxItem x:Uid="Activity_EventFilterProfileLaunch" />
                        <ComboBoxItem x:Uid="Activity_EventFilterHandoff" />
                        <ComboBoxItem x:Uid="Activity_EventFilterHelper" />
                        <ComboBoxItem x:Uid="Activity_EventFilterProbe" />
                        <ComboBoxItem x:Uid="Activity_EventFilterShellVerb" />
                        <ComboBoxItem x:Uid="Activity_EventFilterElevate" />
                    </ComboBox>
                </local:SettingsCard>

                <!--
                    Programs and days are whatever the log holds, so these two
                    lists are built from it rather than written out here. Each
                    entry carries how many events it stands for, which makes the
                    dropdown itself the answer to "what has this terminal been
                    running".
                -->
                <local:SettingsCard x:Name="ActivityProgramFilter"
                                    x:Uid="Activity_ProgramFilter">
                    <ComboBox AutomationProperties.AccessibilityView="Content"
                              ItemsSource="{x:Bind ViewModel.ProgramChoices, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.ProgramChoiceIndex, Mode=TwoWay}"
                              Style="{StaticResource ComboBoxSettingStyle}" />
                </local:SettingsCard>

                <local:SettingsCard x:Name="ActivityDayFilter"
                                    x:Uid="Activity_DayFilter">
                    <ComboBox AutomationProperties.AccessibilityView="Content"
                              ItemsSource="{x:Bind ViewModel.DayChoices, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.DayChoiceIndex, Mode=TwoWay}"
                              Style="{StaticResource ComboBoxSettingStyle}" />
                </local:SettingsCard>

                <local:SettingsCard x:Name="ActivityShowCommandLines"
                                    x:Uid="Activity_ShowCommandLines">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.ShowCommandLines, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                </local:SettingsCard>

                <local:SettingsCard x:Name="ActivityAbsoluteTime"
                                    x:Uid="Activity_AbsoluteTime">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.UseAbsoluteTime, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                </local:SettingsCard>
            </local:SettingsExpander.Items>
        </local:SettingsExpander>

        <TextBlock Margin="4,8,4,4"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   TextWrapping="WrapWholeWords" />

        <!--
            An ItemsControl, not a ListView, and no scroll viewer of its own: the
            page already scrolls, and a list that scrolls inside a page that
            scrolls is both awkward to use and the shape that left the Shortcuts
            page blank. The view model caps what it hands over, so realizing
            every row is bounded work, and grouping is what lets a bounded number
            of rows stand for an unbounded log.
        -->
        <Border Margin="0,4,0,0"
                Padding="12,4,12,4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Visibility="{x:Bind ViewModel.HasEntries, Mode=OneWay}">
            <StackPanel>
                <Grid Margin="0,4,0,6"
                      ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Activity_ColumnTime"
                               Grid.Column="0"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="Activity_ColumnEvent"
                               Grid.Column="1"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="Activity_ColumnContext"
                               Grid.Column="2"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="Activity_ColumnCommand"
                               Grid.Column="3"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Visibility="{x:Bind ViewModel.ShowCommandLines, Mode=OneWay}" />
                </Grid>
                <Border Height="1"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                <ItemsControl ItemTemplate="{StaticResource ActivityItemTemplate}"
                              ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
