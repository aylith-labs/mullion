<Page x:Class="Microsoft.Terminal.Settings.Editor.Activity"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Microsoft.Terminal.Settings.Editor"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                One recorded event.

                System brushes only in here, and that is not a style preference.
                A custom key defined in a control's own ThemeDictionaries is not
                resolvable from inside a DataTemplate, and the failure is a
                process fail-fast (0xc000027b) whose stack blames measure rather
                than the template. The activity pane cost two build round trips
                learning that.
            -->
            <DataTemplate x:Key="ActivityItemTemplate"
                          x:DataType="local:ActivityEntryViewModel">
                <Grid Margin="0,8"
                      ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Top"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind TimestampDisplay}"
                               ToolTipService.ToolTip="{x:Bind TimestampTooltip}" />

                    <StackPanel Grid.Column="1"
                                Spacing="4">
                        <TextBlock FontWeight="SemiBold"
                                   Style="{ThemeResource BodyTextBlockStyle}"
                                   Text="{x:Bind ExeName}" />
                        <Border Padding="6,1"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="3"
                                ToolTipService.ToolTip="{x:Bind EventTooltip}">
                            <TextBlock FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind EventLabel}" />
                        </Border>
                    </StackPanel>

                    <!-- The command is the evidence, so it remains selectable. -->
                    <TextBlock Grid.Column="2"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               IsTextSelectionEnabled="True"
                               Text="{x:Bind CommandLine}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind HasCommandLine}" />

                    <StackPanel Grid.Column="3"
                                Spacing="4">
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind WorkingDirectory}"
                                   Visibility="{x:Bind HasWorkingDirectory}" />
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   IsTextSelectionEnabled="True"
                                   Text="{x:Bind ParentExe}"
                                   Visibility="{x:Bind HasParent}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Spacing="2"
                Style="{StaticResource SettingsStackStyle}">

        <!--
            Recording, and the cap that bounds the file. A master switch plus the
            one setting it gates is exactly the shape SettingsExpander exists
            for. IsForkFeature goes on the expander only, which forwards the mark
            to the card that draws its header. IsEnabled is repeated on the
            nested card rather than set on the expander, because setting it there
            would disable the header and make the toggle that gates it
            unclickable.
        -->
        <local:SettingsExpander x:Name="ActivityLog"
                                x:Uid="Globals_ActivityLog"
                                IsForkFeature="True">
            <local:SettingsExpander.Content>
                <ToggleSwitch IsOn="{x:Bind ViewModel.ActivityLog, Mode=TwoWay}"
                              Style="{StaticResource ToggleSwitchInExpanderStyle}" />
            </local:SettingsExpander.Content>
            <local:SettingsExpander.Items>
                <local:SettingsCard x:Name="ActivityLogMaxKilobytes"
                                    x:Uid="Globals_ActivityLogMaxKilobytes"
                                    IsEnabled="{x:Bind ViewModel.ActivityLog, Mode=OneWay}">
                    <muxc:NumberBox x:Uid="Globals_ActivityLogMaxKilobytesBox"
                                    Maximum="1048576"
                                    Minimum="64"
                                    SpinButtonPlacementMode="Compact"
                                    Style="{StaticResource NumberBoxSettingStyle}"
                                    Value="{x:Bind ViewModel.ActivityLogMaxKilobytes, Mode=TwoWay}" />
                </local:SettingsCard>
                <local:SettingsCard x:Name="ActivityLogPath"
                                    x:Uid="Globals_ActivityLogPath">
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               IsTextSelectionEnabled="True"
                               Text="{x:Bind ViewModel.LogPath, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </local:SettingsCard>
            </local:SettingsExpander.Items>
        </local:SettingsExpander>

        <TextBlock x:Uid="Activity_RecordedHeader"
                   Style="{StaticResource TextBlockSubHeaderStyle}" />

        <local:SettingsCard x:Name="ActivityFilter"
                            x:Uid="Activity_Filter"
                            IsForkFeature="True">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <TextBox x:Name="FilterBox"
                             x:Uid="Activity_FilterBox"
                             MinWidth="220"
                             Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox x:Uid="Activity_EventFilter"
                              MinWidth="180"
                              SelectedValue="{x:Bind ViewModel.KindFilter, Mode=TwoWay}"
                              SelectedValuePath="Tag">
                        <ComboBoxItem x:Uid="Activity_EventFilterAll"
                                      Tag="" />
                        <ComboBoxItem x:Uid="Activity_EventFilterProfileLaunch"
                                      Tag="profileLaunch" />
                        <ComboBoxItem x:Uid="Activity_EventFilterHandoff"
                                      Tag="handoff" />
                    </ComboBox>
                    <Button x:Name="RefreshButton"
                            x:Uid="Activity_Refresh"
                            Click="RefreshButton_Click">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="12"
                                  Glyph="&#xE72C;" />
                    </Button>
                </StackPanel>
                <ToggleSwitch x:Uid="Activity_AbsoluteTime"
                              IsOn="{x:Bind ViewModel.UseAbsoluteTime, Mode=TwoWay}" />
            </StackPanel>
        </local:SettingsCard>

        <TextBlock Margin="4,8,4,4"
                   FontSize="12"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                   TextWrapping="WrapWholeWords" />

        <!--
            An ItemsControl, not a ListView, and no scroll viewer of its own: the
            page already scrolls, and a list that scrolls inside a page that
            scrolls is both awkward to use and the shape that left the Shortcuts
            page blank. The view model caps what it hands over, so realizing
            every row is bounded work.
        -->
        <Border Margin="0,4,0,0"
                Padding="12,4,12,4"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}"
                Visibility="{x:Bind ViewModel.HasEntries, Mode=OneWay}">
            <StackPanel>
                <Grid Margin="0,4,0,6"
                      ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Activity_ColumnTime"
                               Grid.Column="0"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="Activity_ColumnEvent"
                               Grid.Column="1"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="Activity_ColumnCommand"
                               Grid.Column="2"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock x:Uid="Activity_ColumnContext"
                               Grid.Column="3"
                               Style="{ThemeResource CaptionTextBlockStyle}" />
                </Grid>
                <Border Height="1"
                        Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                <ItemsControl ItemTemplate="{StaticResource ActivityItemTemplate}"
                              ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
