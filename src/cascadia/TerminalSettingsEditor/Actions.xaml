<Page x:Class="Microsoft.Terminal.Settings.Editor.Actions"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Microsoft.Terminal.Settings.Editor"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:mtu="using:Microsoft.Terminal.UI"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ActionRowNameTextStyle"
                   BasedOn="{StaticResource BaseTextBlockStyle}"
                   TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="TextWrapping" Value="WrapWholeWords" />
            </Style>

            <Style x:Key="ActionRowSubtleButtonStyle"
                   BasedOn="{StaticResource DefaultButtonStyle}"
                   TargetType="Button">
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ActionRowAccentButtonStyle"
                   BasedOn="{StaticResource AccentButtonStyle}"
                   TargetType="Button">
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ActionRowDeleteButtonStyle"
                   BasedOn="{StaticResource DeleteButtonStyle}"
                   TargetType="Button">
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ActionRowKeyChordEditorStyle"
                   TargetType="local:KeyChordListener">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="160" />
            </Style>

            <Style x:Key="ActionRowItemContainerStyle"
                   TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Border x:Name="OuterBorder"
                                    Background="Transparent"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTransitions="{TemplateBinding ContentTransitions}" />
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="OuterBorder.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="OuterBorder.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Templates  -->
            <DataTemplate x:Key="KeyChordRowTemplate"
                          x:DataType="local:KeyChordViewModel">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <!--  key chord visual / editable key chord group  -->
                        <ColumnDefinition Width="*" />
                        <!--  edit button  -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  [Regular mode] key chord visual  -->
                    <local:KeyChordVisual Grid.Column="0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          KeyChord="{x:Bind CurrentKeys, Mode=OneWay}"
                                          MatchedRuns="{x:Bind MatchedRuns, Mode=OneWay}"
                                          Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(IsInEditMode), Mode=OneWay}" />

                    <!--  [Edit mode] Editable key chord group  -->
                    <StackPanel Grid.Column="0"
                                Grid.ColumnSpan="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4"
                                Visibility="{x:Bind IsInEditMode, Mode=OneWay}">
                        <!--  Key chord listener  -->
                        <local:KeyChordListener Keys="{x:Bind ProposedKeys, Mode=TwoWay}"
                                                Style="{StaticResource ActionRowKeyChordEditorStyle}" />

                        <!--  Cancel changes  -->
                        <Button x:Uid="Actions_CancelButton"
                                AutomationProperties.Name="{x:Bind CancelButtonName}"
                                Click="{x:Bind CancelChanges}"
                                Style="{StaticResource ActionRowSubtleButtonStyle}">
                            <FontIcon FontSize="14"
                                      Glyph="&#xE711;" />
                        </Button>

                        <!--  Accept changes  -->
                        <Button x:Uid="Actions_AcceptButton"
                                AutomationProperties.Name="{x:Bind AcceptButtonName}"
                                Click="{x:Bind AcceptChanges}"
                                Flyout="{x:Bind AcceptChangesFlyout, Mode=OneWay}"
                                Style="{StaticResource ActionRowAccentButtonStyle}">
                            <FontIcon FontSize="14"
                                      Glyph="&#xE8FB;" />
                        </Button>

                        <!--  Delete  -->
                        <Button x:Uid="Actions_DeleteButton"
                                AutomationProperties.Name="{x:Bind DeleteButtonName}"
                                Style="{StaticResource ActionRowDeleteButtonStyle}">
                            <Button.Content>
                                <FontIcon FontSize="14"
                                          Glyph="&#xE74D;" />
                            </Button.Content>
                            <Button.Flyout>
                                <Flyout>
                                    <StackPanel>
                                        <TextBlock x:Uid="Actions_DeleteConfirmationMessage"
                                                   Style="{StaticResource CustomFlyoutTextStyle}" />
                                        <Button x:Uid="Actions_DeleteConfirmationButton"
                                                Click="{x:Bind DeleteKeyChord}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!--  [Regular mode] Edit button  -->
                    <Button Grid.Column="1"
                            AutomationProperties.Name="{x:Bind EditButtonName, Mode=OneWay}"
                            Click="{x:Bind ToggleEditMode}"
                            Style="{StaticResource ActionRowSubtleButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind EditButtonName, Mode=OneWay}"
                            Visibility="{x:Bind mtu:Converters.InvertedBooleanToVisibility(IsInEditMode), Mode=OneWay}">
                        <FontIcon FontSize="14"
                                  Glyph="&#xE70F;" />
                    </Button>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="CommandTemplate"
                          x:DataType="local:CommandViewModel">
                <Grid AutomationProperties.Name="{x:Bind DisplayNameAndKeyChordAutomationPropName, Mode=OneWay}"
                      ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <!--  command name  -->
                        <ColumnDefinition Width="*" />
                        <!--  key chord(s)  -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Command Name. A HighlightedText rather than a TextBlock so the
                        characters the shortcuts filter matched can be emphasised;
                        NameHighlights is null when there is no filter, which draws the
                        name plainly.
                    -->
                    <local:HighlightedText Grid.Column="0"
                                           VerticalAlignment="{x:Bind NameVerticalAlignment, Mode=OneWay}"
                                           Runs="{x:Bind NameHighlights, Mode=OneWay}"
                                           Text="{x:Bind DisplayName, Mode=OneWay}" />

                    <!--  Key chords, stacked vertically (empty when there are none)  -->
                    <ItemsControl Grid.Column="1"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  IsTabStop="False"
                                  ItemTemplate="{StaticResource KeyChordRowTemplate}"
                                  ItemsSource="{x:Bind KeyChordList, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"
                                            Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <Border MaxWidth="{StaticResource StandardControlMaxWidth}">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--
                Goes to the in-app Keyboard shortcuts topic rather than to
                go.microsoft.com. Same wording, different destination: this fork carries
                its own documentation, and the Documentation page is the only thing that
                describes the actions upstream does not have.
            -->
            <HyperlinkButton x:Name="DisclaimerLink"
                             x:Uid="Actions_Disclaimer"
                             Margin="-10,0,0,0"
                             Click="DisclaimerLink_Click" />
            <!--  Add New Button  -->
            <Button x:Name="AddNewButton"
                    Grid.Row="1"
                    Margin="2,0,0,0"
                    Click="{x:Bind ViewModel.AddNewCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <FontIcon FontSize="{StaticResource StandardIconSize}"
                                  Glyph="&#xE710;" />
                        <TextBlock x:Uid="Actions_AddNewTextBlock"
                                   Style="{StaticResource IconButtonTextBlockStyle}" />
                    </StackPanel>
                </Button.Content>
            </Button>

            <!--
                Filter. TwoWay so that clearing it from the view model - which
                AddNewCommand does, since a new shortcut has no name to match - reaches
                the box. UpdateSourceTrigger=PropertyChanged is what makes the list
                narrow as you type: a TwoWay bind on TextBox.Text otherwise writes back
                only when the box loses focus, so typing changed nothing until Tab.
            -->
            <TextBox x:Name="ShortcutsSearchBox"
                     x:Uid="Actions_SearchBox"
                     Grid.Row="2"
                     Margin="2,0,0,0"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!--  Commands  -->
            <Grid Grid.Row="3"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="{StaticResource OverlayCornerRadius}">
                <!--
                    MaxHeight is what makes the page open at once. The page's
                    ScrollViewer measures with infinite height, so without a
                    bound the list realizes every command before anything is
                    drawn; with one, the panel has a viewport and virtualizes.
                    The bound has to come from here rather than from the
                    ScrollViewer above: disabling that ScrollViewer's scrolling
                    also gives the list a height, but it reports an empty
                    effective viewport to its descendants and the list comes out
                    populated with nothing at all.

                    The value set here is only the one the first measure uses,
                    and it has to be a real number for that measure to
                    virtualize. Actions.cpp replaces it with the room actually
                    left in the ScrollViewer's viewport, and keeps it in step
                    with the window - see _UpdateCommandsListHeight.
                -->
                <ListView x:Name="CommandsListView"
                          MaxHeight="720"
                          IsItemClickEnabled="True"
                          ItemClick="{x:Bind ViewModel.CmdListItemClicked}"
                          ItemContainerStyle="{StaticResource ActionRowItemContainerStyle}"
                          ItemTemplate="{StaticResource CommandTemplate}"
                          ItemsSource="{x:Bind ViewModel.FilteredCommandList, Mode=OneWay}"
                          SelectionMode="None" />

                <!--  Shown in place of the rows when the filter excludes everything.  -->
                <TextBlock x:Name="NoShortcutsFoundText"
                           x:Uid="Actions_NoSearchResults"
                           Margin="12,16"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.FilterMatchedNothing, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Border>
</Page>
