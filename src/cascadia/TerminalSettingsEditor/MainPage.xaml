<Page x:Class="Microsoft.Terminal.Settings.Editor.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Microsoft.Terminal.Settings.Editor"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:mtu="using:Microsoft.Terminal.UI"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:tsm="using:Microsoft.Terminal.Settings.Model"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonResources.xaml" />
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>

                        <!--
                            These two values are "SolidBackgroundFillColorTertiary".
                            We can't just put those here though as
                            StaticResources, because XAML will evaluate their
                            values when the App is first loaded, and we'll
                            always use the value from the OS theme, regardless
                            of the requested theme. Kinda the same thing we've
                            had to do with TabViewBackground in the past.
                        -->

                        <ResourceDictionary x:Key="Dark">
                            <Color x:Key="SettingsPageBackground">#282828</Color>
                            <Color x:Key="SettingsPageMicaBackground">#00000000</Color>
                        </ResourceDictionary>

                        <ResourceDictionary x:Key="Light">
                            <Color x:Key="SettingsPageBackground">#F9F9F9</Color>
                            <Color x:Key="SettingsPageMicaBackground">#00000000</Color>
                        </ResourceDictionary>

                        <ResourceDictionary x:Key="HighContrast">
                            <!--  Define resources for HighContrast mode here  -->
                            <StaticResource x:Key="SettingsPageBackground"
                                            ResourceKey="SystemColorWindowBrush" />
                            <StaticResource x:Key="SettingsPageMicaBackground"
                                            ResourceKey="SystemColorWindowBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>

            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground"
                             Color="Transparent" />
            <SolidColorBrush x:Key="NavigationViewContentBackground"
                             Color="Transparent" />

            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
        </ResourceDictionary>
    </Page.Resources>

    <muxc:NavigationView x:Name="SettingsNav"
                         Background="{ThemeResource SettingsPageBackground}"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="False"
                         ItemInvoked="SettingsNav_ItemInvoked"
                         Loaded="SettingsNav_Loaded"
                         PaneClosed="SettingsNav_PaneClosed"
                         PaneOpened="SettingsNav_PaneOpened"
                         TabFocusNavigation="Cycle"
                         Unloaded="SettingsNav_Unloaded">
        <muxc:NavigationView.Resources>
            <ResourceDictionary>
                <Thickness x:Key="NavigationViewHeaderMargin">0,4,0,0</Thickness>
            </ResourceDictionary>
        </muxc:NavigationView.Resources>
        <muxc:NavigationView.Header>
            <!--
                Two columns rather than one, because the search box lives here now
                instead of in NavigationView.AutoSuggestBox. In that slot MUX replaces
                the box with a PaneAutoSuggestButton whenever the pane is compact or
                minimal - an icon you click to get a box back - and search should be a
                box you can type in whatever the pane is doing.

                Two nested grids, because the header has to line up with the column of
                cards below it and that column is not the full width of the frame.
                contentFrame pads 16 a side, and every page caps its stack at
                StandardControlMaxWidth; XAML centres a Stretch element once a size
                constraint bites, so the cards sit in a centred 1000px column. The outer
                grid here repeats the 16 and the inner one repeats the cap, which makes
                the inner grid's left and right edges exactly the cards' left and right
                edges at every window width. Everything inside then only has to align
                Left or Stretch.

                Even columns, and the gutter is the breadcrumb's right margin rather
                than ColumnSpacing, so the box is half the container's width on the nose
                and its right edge lands on the cards' right edge. No MinWidth or
                MaxWidth on the box: either one would win over the column at some window
                size and break the alignment that is the point of all this.

                The breadcrumb used to carry the 1000 cap itself, with a note that a
                MaxWidth there makes the title drift as the window resizes
                (microsoft/microsoft-ui-xaml#3842). It no longer has one: the cap is on
                the grid around it and the breadcrumb only aligns Left, so there is
                nothing for that bug to act on.
            -->
            <Grid Padding="16,8,16,12">
                <Grid MaxWidth="{StaticResource StandardControlMaxWidth}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <muxc:BreadcrumbBar x:Name="NavigationBreadcrumbBar"
                                        Margin="0,0,12,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        ItemClicked="BreadcrumbBar_ItemClicked"
                                        ItemsSource="{x:Bind Breadcrumbs}">
                        <muxc:BreadcrumbBar.ItemTemplate>
                            <DataTemplate x:DataType="local:Breadcrumb">
                                <TextBlock Text="{x:Bind Label}" />
                            </DataTemplate>
                        </muxc:BreadcrumbBar.ItemTemplate>
                        <muxc:BreadcrumbBar.Resources>
                            <ResourceDictionary>
                                <x:Double x:Key="BreadcrumbBarItemThemeFontSize">20</x:Double>
                                <Thickness x:Key="BreadcrumbBarChevronPadding">8,4,8,0</Thickness>
                                <FontWeight x:Key="BreadcrumbBarItemFontWeight">SemiBold</FontWeight>
                                <x:Double x:Key="BreadcrumbBarChevronFontSize">16</x:Double>
                            </ResourceDictionary>
                        </muxc:BreadcrumbBar.Resources>
                    </muxc:BreadcrumbBar>

                    <!--
                        TabIndex, because moving the box out of the pane moved it from the
                        second tab stop to the last but one. NavigationView.Header lives in
                        SplitView.Content (NavigationView.xaml: HeaderContent at 659, inside
                        SplitView.Content from 633), while the items it used to sit above are
                        in SplitView.Pane (475-631) - so tree order now walks the whole
                        navigation list before reaching search, and the person most likely to
                        want search is the one who opened Settings to search.

                        Two facts make one value enough, both from the platform's own source
                        rather than from how it looks:

                        UIElement::TabIndex() returns XINT32_MAX when the property was never
                        set (dxaml/xcp/core/inc/uielement.h) - so every other element here
                        ties at MAXINT and falls back to tree order, and any lower value wins
                        outright.

                        And TabIndex is compared across the whole subtree the traversal
                        reaches, not merely among siblings: CFocusManager::
                        GetNextTabStopInternal recurses through non-tab-stop children and
                        compares every candidate with CompareTabIndex (dxaml/xcp/core/dll/
                        focusmgr.cpp). Only TabNavigation Once and Cycle change that walk;
                        the Local on MUX's MenuItemsScrollViewer does not wall its items off
                        from a value set out here.

                        Consequence worth knowing: forward Tab from a MAXINT element never
                        lands here, because the search is for the lowest index ABOVE the
                        current one. The box is the first stop when focus enters, and the
                        wrap point of the Cycle - not a station in the middle. That is what
                        was wanted; the pane toggle becomes the second stop.

                        GotFocus and Tapped both open the recently chosen results when the
                        box is empty. GotFocus is the reliable one; Tapped covers a click on
                        a box that already had focus, which raises no focus change. Both
                        funnel into one handler that does nothing unless the box is empty.
                    -->
                    <AutoSuggestBox x:Name="SettingsSearchBox"
                                    x:Uid="Nav_SearchBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    GotFocus="SettingsSearchBox_GotFocus"
                                    QueryIcon="Find"
                                    QuerySubmitted="SettingsSearchBox_QuerySubmitted"
                                    SuggestionChosen="SettingsSearchBox_SuggestionChosen"
                                    TabIndex="0"
                                    Tapped="SettingsSearchBox_Tapped"
                                    TextChanged="SettingsSearchBox_TextChanged">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="local:FilteredSearchResult">
                                <Grid HorizontalAlignment="Stretch"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter Grid.Column="0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Content="{x:Bind Icon}" />
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="{ThemeResource BodyTextBlockFontSize}"
                                                   Foreground="{ThemeResource TextFillColorPrimary}"
                                                   Text="{x:Bind Label}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="{ThemeResource CaptionTextBlockFontSize}"
                                                   Foreground="{ThemeResource TextFillColorSecondary}"
                                                   Text="{x:Bind SecondaryLabel}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SecondaryLabel)}" />
                                    </StackPanel>

                                    <ToolTipService.ToolTip>
                                        <StackPanel>
                                            <TextBlock FontSize="{ThemeResource CaptionTextBlockFontSize}"
                                                       Foreground="{ThemeResource TextFillColorPrimary}"
                                                       Text="{x:Bind Label}" />
                                            <TextBlock FontSize="{ThemeResource CaptionTextBlockFontSize}"
                                                       Foreground="{ThemeResource TextFillColorSecondary}"
                                                       Text="{x:Bind SecondaryLabel}"
                                                       Visibility="{x:Bind mtu:Converters.StringNotEmptyToVisibility(SecondaryLabel)}" />
                                        </StackPanel>
                                    </ToolTipService.ToolTip>
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </Grid>
            </Grid>
        </muxc:NavigationView.Header>

        <!--
            Fourteen ungrouped rows were one undifferentiated list, so the items are
            gathered under headings. The list is still one scroll; these are headings,
            not expanders.

            The Margin on each heading is load-bearing, and not decoration. MUX's
            NavigationViewItemHeader template (NavigationView.xaml, the
            HeaderTextCollapsed visual state) answers a closed compact pane by setting
            HeaderText.Visibility to Collapsed AND InnerHeaderGrid.Height to 0 - so the
            heading contributes nothing at all, and without this the icon runs would butt
            together with no sign that the grouping exists. The state does not touch the
            header element's own Margin, so the margin is what survives into the
            collapsed pane and becomes the spacing between runs.

            Headings are inert by MUX's own style, which sets IsEnabled="False",
            IsTabStop="False" and AutomationProperties.AccessibilityView="Raw" on them -
            they cannot be clicked, tabbed to, or announced. They carry no Tag and no
            x:Name for the same reason: nothing navigates to a heading, and the three
            passes that walk the item source all filter on
            try_as<NavigationViewItem>(), which a NavigationViewItemHeader is not (it
            derives from NavigationViewItemBase directly). That is what keeps them out of
            the unguarded NavTagIconMap lookup.
        -->
        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItemHeader x:Uid="Nav_GroupStartup"
                                           Margin="0,4,0,0" />

            <muxc:NavigationViewItem x:Name="LaunchNavItem"
                                     x:Uid="Nav_Launch"
                                     Tag="Launch_Nav" />

            <muxc:NavigationViewItem x:Name="SessionRestoreNavItem"
                                     x:Uid="Nav_SessionRestore"
                                     Tag="SessionRestore_Nav" />

            <muxc:NavigationViewItemHeader x:Uid="Nav_GroupBehavior"
                                           Margin="0,12,0,0" />

            <muxc:NavigationViewItem x:Name="InteractionNavItem"
                                     x:Uid="Nav_Interaction"
                                     Tag="Interaction_Nav" />

            <muxc:NavigationViewItem x:Name="LinkTooltipNavItem"
                                     x:Uid="Nav_LinkTooltip"
                                     Tag="LinkTooltip_Nav" />

            <muxc:NavigationViewItem x:Name="IntegrationsNavItem"
                                     x:Uid="Nav_Integrations"
                                     Tag="Integrations_Nav" />

            <muxc:NavigationViewItemHeader x:Uid="Nav_GroupAppearance"
                                           Margin="0,12,0,0" />

            <muxc:NavigationViewItem x:Name="AppearanceNavItem"
                                     x:Uid="Nav_Appearance"
                                     Tag="GlobalAppearance_Nav" />

            <muxc:NavigationViewItem x:Name="RenderingNavItem"
                                     x:Uid="Nav_Rendering"
                                     Tag="Rendering_Nav" />

            <muxc:NavigationViewItemHeader x:Uid="Nav_GroupCommands"
                                           Margin="0,12,0,0" />

            <muxc:NavigationViewItem x:Name="ActionsNavItem"
                                     x:Uid="Nav_Actions"
                                     Tag="Actions_Nav">
                <muxc:NavigationViewItem.InfoBadge>
                    <muxc:InfoBadge Style="{StaticResource NewInfoBadge}"
                                    Visibility="{x:Bind ActionsVM.DisplayBadge, Mode=OneWay}" />
                </muxc:NavigationViewItem.InfoBadge>
            </muxc:NavigationViewItem>

            <muxc:NavigationViewItem x:Name="NewTabMenuNavItem"
                                     x:Uid="Nav_NewTabMenu"
                                     Tag="NewTabMenu_Nav" />

            <muxc:NavigationViewItemHeader x:Uid="Nav_GroupProfiles"
                                           Margin="0,12,0,0" />

            <muxc:NavigationViewItem x:Name="ProfilesNavItem"
                                     x:Uid="Nav_Profiles"
                                     Tag="Profiles_Nav" />

            <muxc:NavigationViewItem x:Name="ExtensionsNavItem"
                                     x:Uid="Nav_Extensions"
                                     Tag="Extensions_Nav" />

            <muxc:NavigationViewItemHeader x:Uid="Nav_GroupAdvanced"
                                           Margin="0,12,0,0" />

            <muxc:NavigationViewItem x:Name="CompatibilityNavItem"
                                     x:Uid="Nav_Compatibility"
                                     Tag="Compatibility_Nav" />

            <muxc:NavigationViewItem x:Name="ActivityNavItem"
                                     x:Uid="Nav_Activity"
                                     Tag="Activity_Nav" />

            <!--
                A heading of its own for one item, rather than a seventh row under
                ADVANCED. Compatibility and Activity are advanced in the sense that you
                can hurt yourself there; documentation is the opposite of that, and
                filing help under a warning would be the wrong signal.
            -->
            <muxc:NavigationViewItemHeader x:Uid="Nav_GroupHelp"
                                           Margin="0,12,0,0" />

            <muxc:NavigationViewItem x:Name="DocumentationNavItem"
                                     x:Uid="Nav_Documentation"
                                     Tag="Documentation_Nav" />
        </muxc:NavigationView.MenuItems>

        <muxc:NavigationView.FooterMenuItems>
            <!--
                Not a page, so it never selects and ItemInvoked declines to navigate
                for it (MainPage.cpp::SettingsNav_ItemInvoked). The switch inside is
                the only thing that toggles it, so that clicking the row and clicking
                the switch cannot both fire and cancel each other out.
            -->
            <muxc:NavigationViewItem x:Name="ShowDescriptionsNavItem"
                                     SelectsOnInvoked="False"
                                     Tag="ShowDescriptions_Nav">
                <ToggleSwitch x:Name="ShowDescriptionsSwitch"
                              x:Uid="Nav_ShowDescriptions"
                              Toggled="ShowDescriptionsSwitch_Toggled" />
            </muxc:NavigationViewItem>

            <muxc:NavigationViewItem x:Name="OpenJsonNavItem"
                                     x:Uid="Nav_OpenJSON"
                                     SelectsOnInvoked="False"
                                     Tag="OpenJson_Nav" />
        </muxc:NavigationView.FooterMenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="SettingsMainPage_ScrollViewer"
                          Grid.Row="0">
                <Frame x:Name="contentFrame"
                       Grid.Row="0"
                       Padding="16,0,16,48">
                    <Frame.ContentTransitions>
                        <TransitionCollection>
                            <NavigationThemeTransition>
                                <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                    <DrillInNavigationTransitionInfo />
                                </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                            </NavigationThemeTransition>
                        </TransitionCollection>
                    </Frame.ContentTransitions>
                </Frame>
            </ScrollViewer>
            <!--  Explicitly set the background color on grid to prevent the navigation animation from overflowing it  -->
            <Grid Grid.Row="1"
                  Height="56"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="32,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                    <TextBlock x:Uid="Settings_UnsavedSettingsWarning"
                               Foreground="Goldenrod"
                               TextAlignment="Left"
                               Visibility="Collapsed" />
                    <StackPanel VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="4"
                                Visibility="{x:Bind tsm:CascadiaSettings.IsPortableMode, Mode=OneTime}">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                  Foreground="SlateBlue"
                                  Glyph="&#xE946;" />
                        <TextBlock Foreground="SlateBlue">
                            <Run x:Uid="Settings_PortableModeNote" />
                            <Hyperlink x:Uid="Settings_PortableModeInfoLink">
                                <Run x:Uid="Settings_PortableModeInfoLinkTextRun" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,32,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <!--
                        While this is on, Save and Discard are disabled and every
                        change is written as it is made. It sits beside them rather
                        than on a settings page because what it changes is whether
                        those two buttons mean anything.
                    -->
                    <ToggleSwitch x:Name="AutoSaveSwitch"
                                  x:Uid="Settings_AutoSaveSwitch"
                                  Margin="0,0,16,0"
                                  VerticalAlignment="Center"
                                  Toggled="AutoSaveSwitch_Toggled" />
                    <Button x:Name="SaveButton"
                            x:Uid="Settings_SaveSettingsButton"
                            Click="SaveButton_Click"
                            Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="ResetButton"
                            x:Uid="Settings_ResetSettingsButton"
                            Margin="8,0,0,0"
                            Click="ResetButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </muxc:NavigationView>
</Page>
