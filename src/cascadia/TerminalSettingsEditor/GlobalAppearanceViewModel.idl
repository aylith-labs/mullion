import "EnumEntry.idl";

#include "ViewModelHelpers.idl.h"

namespace Microsoft.Terminal.Settings.Editor
{
    runtimeclass GlobalAppearanceViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        GlobalAppearanceViewModel(Microsoft.Terminal.Settings.Model.GlobalAppSettings globalSettings, Microsoft.Terminal.Settings.Model.WindowSettings windowSettings);

        IInspectable CurrentTheme;
        static String ThemeNameConverter(Microsoft.Terminal.Settings.Model.Theme theme);
        Windows.Foundation.Collections.IObservableVector<Microsoft.Terminal.Settings.Model.Theme> ThemeList { get; };

        IInspectable CurrentNewTabPosition;
        Windows.Foundation.Collections.IObservableVector<Microsoft.Terminal.Settings.Editor.EnumEntry> NewTabPositionList { get; };

        IInspectable CurrentTabWidthMode;
        Windows.Foundation.Collections.IObservableVector<Microsoft.Terminal.Settings.Editor.EnumEntry> TabWidthModeList { get; };

        IInspectable CurrentTabPosition;
        Windows.Foundation.Collections.IObservableVector<Microsoft.Terminal.Settings.Editor.EnumEntry> TabPositionList { get; };

        IInspectable CurrentNewTabButtonPosition;
        Windows.Foundation.Collections.IObservableVector<Microsoft.Terminal.Settings.Editor.EnumEntry> NewTabButtonPositionList { get; };

        IInspectable CurrentTabIconStyle;
        Windows.Foundation.Collections.IObservableVector<Microsoft.Terminal.Settings.Editor.EnumEntry> TabIconStyleList { get; };

        IInspectable CurrentTabCloseButton;
        Windows.Foundation.Collections.IObservableVector<Microsoft.Terminal.Settings.Editor.EnumEntry> TabCloseButtonList { get; };

        IInspectable CurrentDockWindow;
        Windows.Foundation.Collections.IObservableVector<Microsoft.Terminal.Settings.Editor.EnumEntry> DockWindowList { get; };

        // False while the strip is vertical, where tab width has no meaning.
        Boolean TabWidthModeEnabled { get; };
        Boolean NewTabButtonPositionEnabled { get; };
        void TabPositionChanged(IInspectable sender, Windows.UI.Xaml.Controls.SelectionChangedEventArgs args);

        // False while the window is not docked, where the docked size has nothing
        // to be a fraction of.
        Boolean DockSizeEnabled { get; };
        void DockWindowChanged(IInspectable sender, Windows.UI.Xaml.Controls.SelectionChangedEventArgs args);

        IInspectable CurrentPaneTitlebarVisibility;
        Windows.Foundation.Collections.IObservableVector<Microsoft.Terminal.Settings.Editor.EnumEntry> PaneTitlebarVisibilityList { get; };

        IInspectable CurrentMotion;
        Windows.Foundation.Collections.IObservableVector<Microsoft.Terminal.Settings.Editor.EnumEntry> MotionList { get; };

        Boolean InvertedDisableAnimations;

        void ShowTitlebarToggled(IInspectable sender, Windows.UI.Xaml.RoutedEventArgs args);

        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, AlwaysShowTabs);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, ShowTabsFullscreen);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, ShowTabIndex);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, CloseWindowOnLastTab);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(UInt32, DockSize);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, ShowTabsInTitlebar);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, UseAcrylicInTabRow);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, ShowTitleInTitlebar);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, AlwaysOnTop);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, AutoHideWindow);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, AlwaysShowNotificationIcon);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, MinimizeToNotificationArea);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, ShowAdminShield);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, ShowTabIconOnTaskbar);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, EnableUnfocusedAcrylic);
    }
}
