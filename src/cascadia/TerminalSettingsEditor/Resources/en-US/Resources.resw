  <data name="Globals_Language.Header" xml:space="preserve">
    <value>Language</value>
    <comment>The header for a control allowing users to choose the app's language.</comment>
  </data>
  <data name="Globals_Language.Description" xml:space="preserve">
    <value>Choose the display language for the application. Overrides the Windows display language and requires a relaunch.</value>
    <comment>A description explaining how this control changes the app's language. {Locked="Windows"}</comment>
  </data>
  <data name="Globals_LanguageDefault" xml:space="preserve">
    <value>Default</value>
    <comment>The app contains a control allowing users to choose the app's language. If this value is chosen, the language preference list of the system settings is used instead.</comment>
  </data>
  <data name="Globals_DefaultInputScope.Header" xml:space="preserve">
    <value>Default IME input mode</value>
    <comment>The "input scope" of an IME tells it what type of characters should be available for input. A Chinese IME for instance may show English letters instead of Chinese ones. It's a technical term. We're using "input mode" instead of "input scope" to make it easier to understand for users.</comment>
  </data>
  <data name="Globals_DefaultInputScope.Description" xml:space="preserve">
    <value>Choose the default IME input language. For IME-based languages, you can force English input on startup.</value>
  </data>
  <data name="Globals_DefaultInputScopeDefault.Content" xml:space="preserve">
    <value>Default</value>
  </data>
  <data name="Globals_DefaultInputScopeAlphanumericHalfWidth.Content" xml:space="preserve">
    <value>Alphanumeric Half-Width (English)</value>
  </data>
  <data name="Globals_AlwaysShowTabs.Content" xml:space="preserve">
    <value>Always show tabs</value>
    <comment>Header for a control to toggle if the app should always show the tabs (similar to a website browser).</comment>
  </data>
  <data name="Globals_NewTabPosition.Header" xml:space="preserve">
    <value>Position of newly created tabs</value>
    <comment>Header for a control to select position of newly created tabs.</comment>
  </data>
  <data name="Globals_NewTabPosition.Description" xml:space="preserve">
    <value>Specifies where new tabs appear in the tab row.</value>
    <comment>A description for what the "Position of newly created tabs" setting does.</comment>
  </data>
  <data name="Globals_NewTabPositionAfterLastTab.Content" xml:space="preserve">
    <value>After the last tab</value>
    <comment>An option to choose from for the "Position of newly created tabs" setting. When selected new tab appears after the last tab.</comment>
  </data>
  <data name="Globals_NewTabPositionAfterCurrentTab.Content" xml:space="preserve">
    <value>After the current tab</value>
    <comment>An option to choose from for the "Position of newly created tabs" setting. When selected new tab appears after the current tab.</comment>
  </data>
  <data name="Globals_CopyOnSelect.Content" xml:space="preserve">
    <value>Automatically copy selection to clipboard</value>
    <comment>Header for a control to toggle whether selected text should be copied to the clipboard automatically, or not.</comment>
  </data>
  <data name="Globals_PaneTitlebarVisibility.Header" xml:space="preserve">
    <value>Pane title bars</value>
    <comment>Header for a control to choose when each pane shows a title bar of its own.</comment>
  </data>
  <data name="Globals_PaneTitlebarVisibility.Description" xml:space="preserve">
    <value>Choose when a pane shows its own title bar above its contents.</value>
    <comment>A description for what the "Pane title bars" setting does.</comment>
  </data>
  <data name="Globals_PaneTitlebarVisibilityNever.Content" xml:space="preserve">
    <value>Never</value>
    <comment>An option to choose from for the "Pane title bars" setting. When selected, panes never show a title bar.</comment>
  </data>
  <data name="Globals_PaneTitlebarVisibilityMultiplePanes.Content" xml:space="preserve">
    <value>When a tab has more than one pane</value>
    <comment>An option to choose from for the "Pane title bars" setting. When selected, panes show a title bar only while the tab is split.</comment>
  </data>
  <data name="Globals_PaneTitlebarVisibilityAlways.Content" xml:space="preserve">
    <value>Always</value>
    <comment>An option to choose from for the "Pane title bars" setting. When selected, every pane shows a title bar.</comment>
  </data>
  <data name="Globals_Motion.Header" xml:space="preserve">
    <value>Motion</value>
    <comment>Header for a control to choose whether the app animates.</comment>
  </data>
  <data name="Globals_Motion.Description" xml:space="preserve">
    <value>Whether tabs, panes, dialogs and settings pages animate. "Follow Windows" reads the animation effects setting under Accessibility → Visual effects.</value>
    <comment>A description for what the "Motion" setting does. "Accessibility" and "Visual effects" name pages in the Windows Settings app.</comment>
  </data>
  <data name="Globals_MotionSystem.Content" xml:space="preserve">
    <value>Follow Windows</value>
    <comment>An option to choose from for the "Motion" setting. When selected, the app animates only if Windows has animation effects turned on.</comment>
  </data>
  <data name="Globals_MotionFull.Content" xml:space="preserve">
    <value>Always animate</value>
    <comment>An option to choose from for the "Motion" setting. When selected, the app animates even if Windows has animation effects turned off.</comment>
  </data>
  <data name="Globals_MotionReduced.Content" xml:space="preserve">
    <value>Never animate</value>
    <comment>An option to choose from for the "Motion" setting. When selected, the app does not animate even if Windows has animation effects turned on.</comment>
  </data>
  <data name="Globals_DetectURLs.Header" xml:space="preserve">
    <value>Automatically detect URLs</value>
    <comment>Header for a control to toggle whether the terminal should find URLs in the output by itself, or not.</comment>
  </data>
  <data name="Globals_DetectURLs.Description" xml:space="preserve">
    <value>Finds bare URLs in the output. Your rules below match either way, so turning this off stops the guessing without disabling them.</value>
    <comment>Additional text presented near "Globals_DetectURLs.Header".</comment>
  </data>
  <data name="Globals_HyperlinkClickable.Header" xml:space="preserve">
    <value>Make links clickable</value>
    <comment>Header for a control to toggle whether clicking a link activates it, or not.</comment>
  </data>
  <data name="Globals_HyperlinkClickable.Description" xml:space="preserve">
    <value>When off, hovering a link still highlights it and still shows its tooltip — you pick what to do from the tooltip instead of clicking.</value>
    <comment>Additional text presented near "Globals_HyperlinkClickable.Header".</comment>
  </data>
  <data name="Globals_HyperlinkClickableKinds.Header" xml:space="preserve">
    <value>Which links respond to a click</value>
    <comment>Header for a group of checkboxes choosing which kinds of link a click activates.</comment>
  </data>
  <data name="Globals_HyperlinkPrimaryClick.Header" xml:space="preserve">
    <value>Primary action</value>
    <comment>Header for the controls choosing the modifier key, mouse gesture and action for the main way of activating a link.</comment>
  </data>
  <data name="Globals_HyperlinkPrimaryClick.Description" xml:space="preserve">
    <value>A left-click chord opens the link on release, and only if the click did not become a selection, so dragging across a URL still selects it.</value>
    <comment>Additional text presented near "Globals_HyperlinkPrimaryClick.Header".</comment>
  </data>
  <data name="Globals_HyperlinkAlternativeClick.Header" xml:space="preserve">
    <value>Alternative action</value>
    <comment>Header for the controls choosing the modifier key, mouse gesture and action for a second way of activating a link.</comment>
  </data>
  <data name="Globals_HyperlinkAlternativeClick.Description" xml:space="preserve">
    <value>A second chord, for doing something else with the same link. Alt and Shift also start block and extended selections; on a link the chord wins, everywhere else selection behaves as it always did.</value>
    <comment>{Locked="Alt"}{Locked="Shift"} Additional text presented near "Globals_HyperlinkAlternativeClick.Header".</comment>
  </data>
  <data name="Globals_HyperlinkClickModifierBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Modifier key</value>
    <comment>Name for a control to choose which modifier key must be held for a click to activate a link.</comment>
  </data>
  <data name="Globals_HyperlinkClickGestureBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Mouse gesture</value>
    <comment>Name for a control to choose which mouse gesture activates a link.</comment>
  </data>
  <data name="Globals_HyperlinkClickActionBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Action</value>
    <comment>Name for a control to choose what happens when a link is activated.</comment>
  </data>
  <data name="Globals_HyperlinkManualRuleOrder.Header" xml:space="preserve">
    <value>Arrange rules by hand</value>
    <comment>Header for a control to toggle whether the user orders the link tooltip rules themselves by dragging, or not.</comment>
  </data>
  <data name="Globals_HyperlinkManualRuleOrder.Description" xml:space="preserve">
    <value>Off, rules are grouped by platform and sorted by name. On, they become one list you drag into the order you want.</value>
    <comment>Additional text presented near "Globals_HyperlinkManualRuleOrder.Header".</comment>
  </data>
  <data name="Globals_HyperlinkTooltipMaxWidth.Header" xml:space="preserve">
    <value>Maximum width of the link tooltip</value>
    <comment>Header for a control to choose how wide the tooltip shown when hovering a link may grow.</comment>
  </data>
  <data name="Globals_HyperlinkTooltipMaxWidth.Description" xml:space="preserve">
    <value>How far a URI may run before it wraps, in device-independent pixels. Set to 0 for no maximum.</value>
    <comment>Additional text presented near "Globals_HyperlinkTooltipMaxWidth.Header".</comment>
  </data>
  <data name="Globals_HyperlinkTooltipMaxWidthBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Maximum width of the link tooltip</value>
    <comment>Name for a control to choose how wide the tooltip shown when hovering a link may grow.</comment>
  </data>
  <data name="Globals_HyperlinkTooltipShowDelay.Header" xml:space="preserve">
    <value>Delay before the link tooltip appears</value>
    <comment>Header for a control to choose how long the pointer must rest on a link before its tooltip appears.</comment>
  </data>
  <data name="Globals_HyperlinkTooltipShowDelay.Description" xml:space="preserve">
    <value>In milliseconds. Set to 0 to show it immediately.</value>
    <comment>Additional text presented near "Globals_HyperlinkTooltipShowDelay.Header".</comment>
  </data>
  <data name="Globals_HyperlinkTooltipShowDelayBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Delay before the link tooltip appears</value>
    <comment>Name for a control to choose how long the pointer must rest on a link before its tooltip appears.</comment>
  </data>
  <data name="Globals_HyperlinkTooltipHideDelay.Header" xml:space="preserve">
    <value>Delay before the link tooltip disappears</value>
    <comment>Header for a control to choose how long the link tooltip stays on screen after the pointer leaves the link.</comment>
  </data>
  <data name="Globals_HyperlinkTooltipHideDelay.Description" xml:space="preserve">
    <value>In milliseconds. This is the time you have to move the pointer onto the tooltip to use its buttons, so 0 puts them out of reach of the mouse.</value>
    <comment>Additional text presented near "Globals_HyperlinkTooltipHideDelay.Header".</comment>
  </data>
  <data name="Globals_HyperlinkTooltipSizing.Header" xml:space="preserve">
    <value>Timing and size</value>
    <comment>Header for a collapsible group of settings controlling how long the link tooltip waits before appearing and disappearing, and how wide it may grow.</comment>
  </data>
  <data name="Globals_HyperlinkTooltipSizing.Description" xml:space="preserve">
    <value>How long the tooltip waits before it appears and disappears, and how far it may spread.</value>
    <comment>Additional text presented near "Globals_HyperlinkTooltipSizing.Header".</comment>
  </data>
  <data name="Globals_HyperlinkTooltipHideDelayBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Delay before the link tooltip disappears</value>
    <comment>Name for a control to choose how long the link tooltip stays on screen after the pointer leaves the link.</comment>
  </data>
  <data name="Globals_HyperlinkTooltipButtons.Header" xml:space="preserve">
    <value>Buttons on the tooltip</value>
    <comment>Header for a group of check boxes choosing which built-in buttons the link tooltip carries.</comment>
  </data>
  <data name="Globals_HyperlinkTooltipButtons.Description" xml:space="preserve">
    <value>Which of the built-in buttons the tooltip carries. A rule can override this for the links it matches.</value>
    <comment>Additional text presented near "Globals_HyperlinkTooltipButtons.Header".</comment>
  </data>
  <data name="Globals_HyperlinkTooltipHint.Header" xml:space="preserve">
    <value>Show the "Click to follow link" hint</value>
    <comment>{Locked="Click to follow link"} Header for a control to toggle the hint line at the bottom of the link tooltip.</comment>
  </data>
  <data name="Globals_HyperlinkTooltipHint.Description" xml:space="preserve">
    <value>The line at the bottom of the tooltip explaining how to open the link.</value>
    <comment>Additional text presented near "Globals_HyperlinkTooltipHint.Header".</comment>
  </data>
  <data name="Globals_HyperlinkPreviewInPane.Header" xml:space="preserve">
    <value>Show link details in a pane instead of a tooltip</value>
    <comment>Header for a control to make hovering a link open its details in a pane rather than showing a tooltip card.</comment>
  </data>
  <data name="Globals_HyperlinkPreviewInPane.Description" xml:space="preserve">
    <value>Chooses where a hovered link's details appear. Separate from the "Show in pane" button, which puts a link in a pane on demand.</value>
    <comment>{Locked="Show in pane"} Additional text presented near "Globals_HyperlinkPreviewInPane.Header".</comment>
  </data>
  <data name="Globals_HyperlinkTooltipActions.Header" xml:space="preserve">
    <value>Show buttons on the link tooltip</value>
    <comment>Header for a control to toggle whether the link tooltip carries action buttons.</comment>
  </data>
  <data name="Globals_HyperlinkTooltipActions.Description" xml:space="preserve">
    <value>Turns the whole row of buttons off. Which buttons the row carries, and where it sits, are chosen inside.</value>
    <comment>Additional text presented near "Globals_HyperlinkTooltipActions.Header".</comment>
  </data>
  <data name="Globals_SafeUriSchemes.Header" xml:space="preserve">
    <value>URI schemes that open without a warning</value>
    <comment>Header for a control listing the URI schemes that are treated as safe to open.</comment>
  </data>
  <data name="Globals_SafeUriSchemes.Description" xml:space="preserve">
    <value>Separate schemes with commas, for example: mailto, vscode, ms-settings. Links using any other scheme ask for confirmation first. Leave empty to confirm them all.</value>
    <comment>{Locked="mailto"}{Locked="vscode"}{Locked="ms-settings"} Additional text presented near "Globals_SafeUriSchemes.Header".</comment>
  </data>
  <data name="Globals_SearchWebDefaultQueryUrl.Header" xml:space="preserve">
    <value>Default URL to use for the "Search web" shortcut</value>
    <comment>Header for a control to set the query URL when using the "search web" shortcut.</comment>
  </data>
  <data name="Globals_SearchWebDefaultQueryUrl.Description" xml:space="preserve">
    <value>The placeholder "%s" will be replaced with the search query.</value>
    <comment>{Locked="%s"} Additional text presented near "Globals_SearchWebDefaultQueryUrl.Header".</comment>
  </data>
  <data name="Globals_TrimBlockSelection.Content" xml:space="preserve">
    <value>Remove trailing white-space in rectangular selection</value>
    <comment>Header for a control to toggle whether a text selected with block selection should be trimmed of white spaces when copied to the clipboard, or not.</comment>
  </data>
  <data name="Globals_TrimPaste.Content" xml:space="preserve">
    <value>Remove trailing white-space when pasting</value>
    <comment>Header for a control to toggle whether pasted text should be trimmed of white spaces, or not.</comment>
  </data>
  <data name="Globals_DefaultProfile.Header" xml:space="preserve">
    <value>Default profile</value>
    <comment>Header for a control to select your default profile from the list of profiles you've created.</comment>
  </data>
  <data name="Globals_DefaultProfile.Description" xml:space="preserve">
    <value>Profile that opens when clicking the '+' icon or by typing the new tab key binding.</value>
    <comment>A description for what the default profile is and when it's used.</comment>
  </data>
  <data name="Globals_DefaultTerminal.Header" xml:space="preserve">
    <value>Default terminal application</value>
    <comment>Header for a drop down that permits the user to select which installed Terminal application will launch when command line tools like CMD are run from the Windows Explorer run box or start menu or anywhere else that they do not already have a graphical window assigned.</comment>
  </data>
  <data name="Globals_DefaultTerminal.Description" xml:space="preserve">
    <value>The terminal application used when a command-line app is launched without an existing session.</value>
    <comment>A description to clarify that the dropdown choice for default terminal will tell the operating system which Terminal application (Windows Terminal, the preview build, the legacy inbox window, or a 3rd party one) to use when starting a command line tool like CMD or Powershell that does not already have a window.</comment>
  </data>
  <data name="Globals_GraphicsAPI.Header" xml:space="preserve">
    <value>Graphics API</value>
    <comment>This text is shown next to a list of choices.</comment>
  </data>
  <data name="Globals_GraphicsAPI.Description" xml:space="preserve">
    <value>Direct3D 11 provides a more performant and feature-rich experience, whereas Direct2D is more stable. The default option "Automatic" will pick the API that best fits your graphics hardware. If you experience significant issues, consider using Direct2D.</value>
  </data>
  <data name="Globals_GraphicsAPI_Automatic.Text" xml:space="preserve">
    <value>Automatic</value>
    <comment>The default choice between multiple graphics APIs.</comment>
  </data>
  <data name="Globals_GraphicsAPI_Direct2d.Text" xml:space="preserve">
    <value>Direct2D</value>
  </data>
  <data name="Globals_GraphicsAPI_Direct3d11.Text" xml:space="preserve">
    <value>Direct3D 11</value>
  </data>
  <data name="Globals_DisablePartialInvalidation.Header" xml:space="preserve">
    <value>Disable partial Swap Chain invalidation</value>
    <comment>"Swap Chain" is an official technical term by Microsoft. This text is shown next to a toggle.</comment>
  </data>
  <data name="Globals_DisablePartialInvalidation.Description" xml:space="preserve">
    <value>By default, the text renderer uses a FLIP_SEQUENTIAL Swap Chain and declares dirty rectangles via the Present1 API. When this setting is enabled, a FLIP_DISCARD Swap Chain will be used instead, and no dirty rectangles will be declared. Whether one or the other is better depends on your hardware and various other factors.</value>
    <comment>{Locked="Present1","FLIP_DISCARD","FLIP_SEQUENTIAL"}</comment>
  </data>
  <data name="Globals_SoftwareRendering.Header" xml:space="preserve">
    <value>Use software rendering (WARP)</value>
    <comment>{Locked="WARP"} WARP is the "Windows Advanced Rasterization Platform". This text is shown next to a toggle.</comment>
  </data>
  <data name="Globals_SoftwareRendering.Description" xml:space="preserve">
    <value>When enabled, the terminal will use a software rasterizer (WARP). This setting should be left disabled under almost all circumstances.</value>
    <comment>{Locked="WARP"} WARP is the "Windows Advanced Rasterization Platform".</comment>
  </data>
  <data name="Globals_TextMeasurement.Header" xml:space="preserve">
    <value>Text measurement mode</value>
    <comment>This text is shown next to a list of choices.</comment>
  </data>
  <data name="Globals_TextMeasurement.Description" xml:space="preserve">
    <value>Choose how text is grouped into cells. "Grapheme clusters" provides the most modern Unicode behavior. Restart Terminal to apply changes. Only affects applications launched from Terminal.</value>
  </data>
  <data name="Globals_TextMeasurement_Graphemes.Text" xml:space="preserve">
    <value>Grapheme clusters</value>
    <comment>The default choice between multiple graphics APIs.</comment>
  </data>
  <data name="Globals_TextMeasurement_Wcswidth.Text" xml:space="preserve">
    <value>wcswidth</value>
    <comment>{Locked="wcswidth"}</comment>
  </data>
  <data name="Globals_TextMeasurement_Console.Text" xml:space="preserve">
    <value>Windows Console</value>
  </data>
  <data name="Globals_AmbiguousWidth.Header" xml:space="preserve">
    <value>Width of ambiguous characters</value>
    <comment>A label for a drop down selector, referring to the East Asian Ambiguous Width Unicode specification.</comment>
  </data>
  <data name="Globals_AmbiguousWidth.Description" xml:space="preserve">
    <value>Choose the width used for East Asian Ambiguous characters. "Narrow" improves compatibility, while "Wide" improves readability with many CJK fonts. Some applications may not work correctly in "Wide" mode. Restart Terminal to apply changes.</value>
  </data>
  <data name="Globals_AmbiguousWidth_Narrow.Text" xml:space="preserve">
    <value>Narrow</value>
    <comment>As in "narrow width". Refers to the East Asian Ambiguous Width Unicode specification.</comment>
  </data>
  <data name="Globals_AmbiguousWidth_Wide.Text" xml:space="preserve">
    <value>Wide</value>
    <comment>As in "wide width". Refers to the East Asian Ambiguous Width Unicode specification.</comment>
  </data>
  <data name="Globals_InitialCols_Tooltip.Content" xml:space="preserve">
    <value>Width of the window, in characters.</value>
    <comment>Tooltip shown next to the launch-size columns number box.</comment>
  </data>
  <data name="Globals_InitialRows_Tooltip.Content" xml:space="preserve">
    <value>Height of the window, in characters.</value>
    <comment>Tooltip shown next to the launch-size rows number box.</comment>
  </data>
  <data name="Globals_InitialCols.Header" xml:space="preserve">
    <value>Columns</value>
    <comment>Header for a control to choose the number of columns in the terminal's text grid.</comment>
  </data>
  <data name="Globals_InitialRows.Header" xml:space="preserve">
    <value>Rows</value>
    <comment>Header for a control to choose the number of rows in the terminal's text grid.</comment>
  </data>
  <data name="Globals_InitialColsBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Initial Columns</value>
    <comment>Name for a control to choose the number of columns in the terminal's text grid.</comment>
  </data>
  <data name="Globals_InitialRowsBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Initial Rows</value>
    <comment>Name for a control to choose the number of rows in the terminal's text grid.</comment>
  </data>
  <data name="Globals_InitialPosXBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>X position</value>
    <comment>Name for a control to choose the X coordinate of the terminal's starting position.</comment>
  </data>
  <data name="Globals_InitialPosXBox.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>Enter the value for the x-coordinate.</value>
    <comment>Tooltip for the control that allows the user to choose the X coordinate of the terminal's starting position.</comment>
  </data>
  <data name="Globals_InitialPosXBox.PlaceholderText" xml:space="preserve">
    <value>X</value>
    <comment>The string to be displayed when there is no current value in the x-coordinate number box.</comment>
  </data>
  <data name="Globals_InitialPosYBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Y position</value>
    <comment>Name for a control to choose the Y coordinate of the terminal's starting position.</comment>
  </data>
  <data name="Globals_InitialPosYBox.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>Enter the value for the y-coordinate.</value>
    <comment>Tooltip for the control that allows the user to choose the Y coordinate of the terminal's starting position.</comment>
  </data>
  <data name="Globals_InitialPosYBox.PlaceholderText" xml:space="preserve">
    <value>Y</value>
    <comment>The string to be displayed when there is no current value in the y-coordinate number box.</comment>
  </data>
  <data name="Globals_DefaultLaunchPositionCheckbox.Content" xml:space="preserve">
    <value>Let system position window</value>
    <comment>A checkbox for the "launch position" setting. Toggling this control sets the launch position to whatever the Windows operating system decides.</comment>
  </data>
  <data name="Globals_DefaultLaunchPositionCheckbox.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>If enabled, use the system default launch position.</value>
    <comment>A description for what the "default launch position" checkbox does. Presented near "Globals_DefaultLaunchPositionCheckbox".</comment>
  </data>
  <data name="Globals_FirstWindowPreference.Header" xml:space="preserve">
    <value>When Terminal starts</value>
    <comment>Header for a control to select how the terminal should load its first window.</comment>
  </data>
  <data name="Globals_FirstWindowPreference.Description" xml:space="preserve">
    <value>What should be shown when the first terminal is created.</value>
  </data>
  <data name="Globals_FirstWindowPreferenceDefaultProfile.Content" xml:space="preserve">
    <value>Open a tab with the default profile</value>
    <comment>An option to choose from for the "First window preference" setting. Open the default profile.</comment>
  </data>
  <data name="Globals_FirstWindowPreferencePersistedWindowLayout.Content" xml:space="preserve">
    <value>Open windows from a previous session</value>
    <comment>An option to choose from for the "First window preference" setting. Reopen the layouts from the last session.</comment>
  </data>
  <data name="Globals_FirstWindowPreferencePersistedLayoutAndContent.Content" xml:space="preserve">
    <value>Restore window layout and content</value>
    <comment>An option to choose from for the "First window preference" setting. Reopen the layouts from the last session and preserve the content.</comment>
  </data>
  <data name="Globals_FirstWindowPreferencePersistedLayout.Content" xml:space="preserve">
    <value>Restore window layout</value>
    <comment>An option to choose from for the "First window preference" setting. Reopen the layouts from the last session, but don't preserve the content.</comment>
  </data>
  <data name="Globals_ResumeAgents.Header" xml:space="preserve">
    <value>Resume coding agents</value>
    <comment>Header for a control to toggle bringing back coding agents (Claude Code, Codex and similar) that were running when Terminal last closed.</comment>
  </data>
  <data name="Globals_ResumeAgents.Description" xml:space="preserve">
    <value>A pane running Claude Code, Codex, Copilot or another known agent reopens the same conversation, keeping the flags it was started with.</value>
  </data>
  <data name="Globals_ResumeMultiplexers.Header" xml:space="preserve">
    <value>Resume session multiplexers</value>
    <comment>Header for a control to toggle bringing back terminal multiplexers (shefrd, herdr, tmux, screen, zellij) that were running when Terminal last closed.</comment>
  </data>
  <data name="Globals_ResumeMultiplexers.Description" xml:space="preserve">
    <value>A pane running shefrd, herdr, tmux, screen or zellij reattaches to the session its server is still holding.</value>
  </data>
  <data name="Globals_ResumeExtraPrograms.Header" xml:space="preserve">
    <value>Also resume these programs</value>
    <comment>Header for a text box listing extra program names, separated by commas, that should be re-run when Terminal starts.</comment>
  </data>
  <data name="Globals_ResumeExtraPrograms.Description" xml:space="preserve">
    <value>Comma-separated program names. Each is re-run exactly as it was, with its original arguments. Use this for anything that isn't a known agent or multiplexer.</value>
  </data>
  <data name="Globals_ResumeExcludedPrograms.Header" xml:space="preserve">
    <value>Never resume these programs</value>
    <comment>Header for a text box listing program names, separated by commas, that should never be brought back even if the settings above would otherwise cover them.</comment>
  </data>
  <data name="Globals_ResumeExcludedPrograms.Description" xml:space="preserve">
    <value>Comma-separated program names. Wins over everything above, so you can turn a whole category on and still leave one program out.</value>
  </data>
  <data name="Globals_ResumeSessionNotification.Header" xml:space="preserve">
    <value>When resuming sessions</value>
    <comment>Header for a control to choose whether resuming a recognized session asks first, or just shows a notice, or says nothing at all.</comment>
  </data>
  <data name="Globals_ResumeSessionNotification.Description" xml:space="preserve">
    <value>Only applies when something above is eligible to be resumed.</value>
  </data>
  <data name="Globals_PersistBufferPeriodically.Header" xml:space="preserve">
    <value>Save pane contents periodically</value>
    <comment>Header for a control to toggle saving each pane's scrollback on a timer, instead of only when Terminal is closed normally.</comment>
  </data>
  <data name="Globals_PersistBufferPeriodically.Description" xml:space="preserve">
    <value>Without this, scrollback is only written when Terminal closes normally, so a crash or an End Task loses it.</value>
  </data>
  <data name="SessionRestore_PageDescription" xml:space="preserve">
    <value>What comes back when Terminal starts: which windows and panes, what was on screen in them, and which of the programs that were running are started again. "When Terminal starts" decides how much of that happens, and everything below follows from it.</value>
    <comment>Introductory text at the top of the Session Restore settings page.</comment>
  </data>
  <data name="SessionRestore_ResumePrograms.Header" xml:space="preserve">
    <value>Resume programs</value>
    <comment>Header for a collapsible group of settings about restarting or reattaching to the programs that were running in a restored pane.</comment>
  </data>
  <data name="SessionRestore_ResumePrograms.Description" xml:space="preserve">
    <value>Which programs are started again in the panes they were in. Needs a layout to put them back into, so this is off entirely under "Open a tab with the default profile".</value>
    <comment>Additional text presented near "SessionRestore_ResumePrograms.Header".</comment>
  </data>
  <data name="SessionRestore_SavePaneContents.Header" xml:space="preserve">
    <value>Saving pane contents</value>
    <comment>Header for a collapsible group of settings about writing each pane's scrollback to disk so it can be restored.</comment>
  </data>
  <data name="SessionRestore_SavePaneContents.Description" xml:space="preserve">
    <value>Writing each pane's scrollback to disk so it can come back. Only applies under "Restore window layout and content".</value>
    <comment>Additional text presented near "SessionRestore_SavePaneContents.Header".</comment>
  </data>
  <data name="Globals_BufferPersistIntervalSeconds.Header" xml:space="preserve">
    <value>Save pane contents every</value>
    <comment>Header for a control to choose how often, in seconds, to save pane contents and window layout.</comment>
  </data>
  <data name="Globals_BufferPersistIntervalSeconds.Description" xml:space="preserve">
    <value>Seconds between saves. Shorter loses less in a crash; longer writes less to disk.</value>
  </data>
  <data name="Globals_BufferPersistIntervalSecondsBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Save pane contents every, in seconds</value>
    <comment>Name for a control to choose how often, in seconds, to save pane contents.</comment>
  </data>
  <data name="Globals_PersistCost.Header" xml:space="preserve">
    <value>What saving has been costing</value>
    <comment>Header for a read-only display showing how long recent save passes took and how much disk they use.</comment>
  </data>
  <data name="Globals_PersistCost.Description" xml:space="preserve">
    <value>The last seven days of saves, oldest on the left.</value>
  </data>
  <data name="Globals_PersistCostNoData" xml:space="preserve">
    <value>Nothing saved yet</value>
    <comment>Shown in place of the summary when no save has happened yet, so there is nothing to chart.</comment>
  </data>
  <data name="Globals_ResumeSessionNotificationSilent.Content" xml:space="preserve">
    <value>Resume with no notice</value>
    <comment>An option for the "When resuming sessions" setting. Resume automatically and say nothing about it.</comment>
  </data>
  <data name="Globals_ResumeSessionNotificationToast.Content" xml:space="preserve">
    <value>Resume immediately, then show a notice</value>
    <comment>An option for the "When resuming sessions" setting. Resume automatically and show a dismissible notice naming what was resumed.</comment>
  </data>
  <data name="Globals_ResumeSessionNotificationConfirm.Content" xml:space="preserve">
    <value>Ask first</value>
    <comment>An option for the "When resuming sessions" setting. Show a dialog listing what would be resumed and wait for confirmation before resuming anything.</comment>
  </data>
  <data name="Globals_LaunchParameters.Header" xml:space="preserve">
    <value>Launch mode</value>
    <comment>Header for a set of settings that determine how terminal launches. These settings include the launch mode, launch position and whether the terminal should center itself on launch.</comment>
  </data>
  <data name="Globals_LaunchParameters.Description" xml:space="preserve">
    <value>Choose how Terminal opens</value>
    <comment>A description for the "launch mode" expander.</comment>
  </data>
  <data name="Globals_LaunchModeSetting.Header" xml:space="preserve">
    <value>Launch mode</value>
    <comment>Header for a control to select what mode to launch the terminal in.</comment>
  </data>
  <data name="Globals_LaunchModeDefault.Content" xml:space="preserve">
    <value>Default</value>
    <comment>An option to choose from for the "launch mode" setting. Default option.</comment>
  </data>
  <data name="Globals_LaunchModeFullscreen.Content" xml:space="preserve">
    <value>Full screen</value>
    <comment>An option to choose from for the "launch mode" setting. Opens the app in a full screen state.</comment>
  </data>
  <data name="Globals_LaunchModeMaximized.Content" xml:space="preserve">
    <value>Maximized</value>
    <comment>An option to choose from for the "launch mode" setting. Opens the app maximized (covers the whole screen).</comment>
  </data>
  <data name="Globals_WindowingBehavior.Header" xml:space="preserve">
    <value>New instance behavior</value>
    <comment>Header for a control to select how new app instances are handled.</comment>
  </data>
  <data name="Globals_WindowingBehavior.Description" xml:space="preserve">
    <value>Controls how new terminal instances attach to existing windows.</value>
    <comment>A description for what the "windowing behavior" setting does. Presented near "Globals_WindowingBehavior.Header".</comment>
  </data>
  <data name="Globals_WindowingBehaviorUseNew.Content" xml:space="preserve">
    <value>Create a new window</value>
    <comment>An option to choose from for the "windowing behavior" setting. When selected, new instances create a new window.</comment>
  </data>
  <data name="Globals_WindowingBehaviorUseAnyExisting.Content" xml:space="preserve">
    <value>Attach to the most recently used window</value>
    <comment>An option to choose from for the "windowing behavior" setting. When selected, new instances open in the most recently used window.</comment>
  </data>
  <data name="Globals_WindowingBehaviorUseExisting.Content" xml:space="preserve">
    <value>Attach to the most recently used window on this desktop</value>
    <comment>An option to choose from for the "windowing behavior" setting. When selected, new instances open in the most recently used window on this virtual desktop.</comment>
  </data>
  <data name="Globals_ShowTitlebar.Content" xml:space="preserve">
    <value>Hide the title bar (requires relaunch)</value>
    <comment>Header for a control to toggle whether or not the title bar should be shown. Changing this setting requires the user to relaunch the app.</comment>
  </data>
  <data name="Globals_TitlebarProperties.Header" xml:space="preserve">
    <value>Title bar properties</value>
    <comment>Header for a group of settings that control the appearance and behavior of the title bar.</comment>
  </data>
  <data name="Globals_TitlebarProperties.Description" xml:space="preserve">
    <value>When the title bar is hidden, tabs move into the title bar and are always shown.</value>
    <comment>A description explaining what happens to the tabs when the title bar is hidden. "Title bar" refers to the bar at the top of the window.</comment>
  </data>
  <data name="Globals_AcrylicTabRow.Content" xml:space="preserve">
    <value>Use acrylic material in the tab row</value>
    <comment>Header for a control to toggle whether "acrylic material" is used. "Acrylic material" is a Microsoft-specific term: https://docs.microsoft.com/en-us/windows/apps/design/style/acrylic</comment>
  </data>
  <data name="Globals_ShowTitleInTitlebar.Content" xml:space="preserve">
    <value>Use active terminal title as application title</value>
    <comment>Header for a control to toggle whether the terminal's title is shown as the application title, or not.</comment>
  </data>
  <data name="Globals_SnapToGridOnResize.Header" xml:space="preserve">
    <value>Snap window resizing to character grid</value>
    <comment>Header for a control to toggle whether the terminal snaps the window to the character grid when resizing, or not.</comment>
  </data>
  <data name="Globals_SnapToGridOnResize.Description" xml:space="preserve">
    <value>When disabled, the window will resize smoothly.</value>
    <comment>A description for what the "snap to grid on resize" setting does. Presented near "Globals_SnapToGridOnResize.Header".</comment>
  </data>
  <data name="Globals_StartOnUserLogin_Checkbox.Content" xml:space="preserve">
    <value>Launch at login</value>
    <comment>Label for a checkbox to toggle whether the app should launch when the user logs in to their machine.</comment>
  </data>
  <data name="Globals_StartOnUserLogin.Header" xml:space="preserve">
    <value>Launch on machine startup</value>
    <comment>Header for a control to toggle whether the app should launch when the user's machine starts up, or not.</comment>
  </data>
  <data name="Globals_CenterOnLaunchCentered" xml:space="preserve">
    <value>Centered</value>
    <comment>Shorthand, explanatory text displayed when the user has enabled the feature indicated by "Globals_CenterOnLaunch.Header".</comment>
  </data>
  <data name="Globals_CenterOnLaunch_Checkbox.Content" xml:space="preserve">
    <value>Center on launch</value>
    <comment>Label for a checkbox to toggle whether the app should launch in the center of the screen, or not.</comment>
  </data>
  <data name="Globals_CenterOnLaunch.Header" xml:space="preserve">
    <value>Center on launch</value>
    <comment>Header for a control to toggle whether the app should launch in the center of the screen, or not.</comment>
  </data>
  <data name="Globals_RememberWindowGeometryRemembered" xml:space="preserve">
    <value>Remembered</value>
    <comment>Shorthand, explanatory text displayed when the user has enabled the feature indicated by "Globals_RememberWindowGeometry.Header".</comment>
  </data>
  <data name="Globals_RememberWindowGeometry.Header" xml:space="preserve">
    <value>Remember position and size</value>
    <comment>Header for a control to toggle whether the app should reopen each window where it was when it was last closed.</comment>
  </data>
  <data name="Globals_RememberWindowGeometry.Description" xml:space="preserve">
    <value>When enabled, each window's position, size and maximized state are saved when it closes, and restored the next time a window opens. Windows that have been given a name each remember their own. This takes precedence over the launch position, launch mode and "center on launch" settings above, but command line arguments still override it.</value>
    <comment>A description for what the "remember position and size" setting does. Presented near "Globals_RememberWindowGeometry.Header".</comment>
  </data>
  <data name="Globals_AlwaysOnTop.Header" xml:space="preserve">
    <value>Always on top</value>
    <comment>Header for a control to toggle if the app will always be presented on top of other windows, or is treated normally (when disabled).</comment>
  </data>
  <data name="Profile_ForceVTInput.Header" xml:space="preserve">
    <value>Use the legacy input encoding</value>
    <comment>Header for a control to toggle legacy input encoding for the terminal.</comment>
  </data>
  <data name="Profile_AllowKittyKeyboardMode.Header" xml:space="preserve">
    <value>Allow Kitty Keyboard Protocol</value>
    <comment>{Locked="Kitty"}Kitty is a moniker and its Keyboard Protocol is a protocol specification.</comment>
  </data>
  <data name="Profile_AllowVtChecksumReport.Header" xml:space="preserve">
    <value>Allow DECRQCRA (Request Checksum of Rectangular Area)</value>
    <comment>{Locked="DECRQCRA"}{Locked="Request Checksum of Rectangular Area"}Header for a control to toggle support for the DECRQCRA control sequence.</comment>
  </data>
  <data name="Profile_AllowVtClipboardWrite.Header" xml:space="preserve">
    <value>Allow OSC 52 (Manipulate Selection Data) to write to the clipboard</value>
    <comment>{Locked="OSC 52"}{Locked="Manipulate Selection Data"}Header for a control to toggle support for applications to change the contents of the Windows system clipboard.</comment>
  </data>
  <data name="Profile_AllowOscNotifications.Header" xml:space="preserve">
    <value>Allow OSC 777 (Desktop Notification) to show toast notifications</value>
    <comment>{Locked="OSC 777"}{Locked="Desktop Notification"}Header for a control to toggle support for applications to display desktop toast notifications via the OSC 777 escape sequence.</comment>
  </data>
  <data name="Profile_AllowOscNotifications.Description" xml:space="preserve">
    <value>When enabled, applications can send the OSC 777 escape sequence to trigger a desktop notification with a custom title and body.</value>
    <comment>{Locked="OSC 777"}Help text for the OSC 777 desktop notification toggle.</comment>
  </data>
  <data name="Profile_NotifyWhenFocused.Header" xml:space="preserve">
    <value>Show notifications from the pane you are looking at</value>
    <comment>Header for a control to toggle showing desktop notifications even when the window is focused and the pane that sent them is the active one.</comment>
  </data>
  <data name="Profile_NotifyWhenFocused.Description" xml:space="preserve">
    <value>Off, a notification from the active pane of a focused window is dropped. Turn this on for a pane running a multiplexer such as tmux or shefrd, whose notifications are about panes this window cannot show.</value>
    <comment>{Locked="tmux"}{Locked="shefrd"}Help text for the toggle that shows desktop notifications from the focused pane.</comment>
  </data>
  <data name="Globals_AllowHeadless.Header" xml:space="preserve">
    <value>Allow Windows Terminal to run in the background</value>
    <comment>Header for a control to toggle support for Windows Terminal to run in the background.</comment>
  </data>
  <data name="Globals_DebugFeaturesEnabled.Header" xml:space="preserve">
    <value>Enable debugging features</value>
    <comment>Header for a control to toggle debug features.</comment>
  </data>
  <data name="Globals_CiPollIntervalMinutes.Header" xml:space="preserve">
    <value>CI build update poll interval (minutes)</value>
    <comment>Header for a control to set how often to check for a newly built CI payload. 0 disables polling.</comment>
  </data>
  <data name="Globals_CiPollIntervalMinutes.Description" xml:space="preserve">
    <value>How often to check for a newer CI build to stage for the Dev slot. Set to 0 to disable.</value>
    <comment>Additional description for what the "CI build poll interval" setting does. Presented near "Globals_CiPollIntervalMinutes.Header".</comment>
  </data>
  <data name="Globals_CiPollIntervalMinutesBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>CI build poll interval in minutes</value>
    <comment>Name for a control to choose how often, in minutes, to poll for a new CI build.</comment>
  </data>
  <data name="Globals_ActivityLog.Header" xml:space="preserve">
    <value>Record an activity log</value>
    <comment>Header for a setting that turns on a log of every process the terminal starts.</comment>
  </data>
  <data name="Globals_ActivityLog.Description" xml:space="preserve">
    <value>Write every process this terminal starts, and every console program handed to it, to activity.jsonl beside your settings file: the time, the program, its full command line, its folder, and what started it. This is how you find out where an unexpected window came from. Command lines are recorded in full, so an argument containing a password or token is written to that file.</value>
    <comment>Additional description for what the "Record an activity log" setting does. Presented near "Globals_ActivityLog.Header".</comment>
  </data>
  <data name="Globals_ActivityLogMaxKilobytes.Header" xml:space="preserve">
    <value>Maximum log size (KB)</value>
    <comment>Header for a control to set how large the activity log may grow before it is rotated.</comment>
  </data>
  <data name="Globals_ActivityLogMaxKilobytes.Description" xml:space="preserve">
    <value>How large activity.jsonl may grow before it is renamed to activity.1.jsonl and a new one is started. One previous file is kept.</value>
    <comment>Additional description for the activity log size limit. Presented near "Globals_ActivityLogMaxKilobytes.Header".</comment>
  </data>
  <data name="Globals_ActivityLogMaxKilobytesBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Maximum activity log size in kilobytes</value>
    <comment>Name for a control to choose the largest size, in kilobytes, of the activity log.</comment>
  </data>
  <data name="Globals_ActivityLogPath.Header" xml:space="preserve">
    <value>Log file</value>
    <comment>Header for a row that shows the full path of the activity log file on disk.</comment>
  </data>
  <data name="Globals_ActivityLogPath.Description" xml:space="preserve">
    <value>Where the log is written. Each installed version of the terminal keeps its own.</value>
    <comment>Additional description for the row showing where the activity log is written. Presented near "Globals_ActivityLogPath.Header".</comment>
  </data>
  <data name="Activity_RecordedHeader.Text" xml:space="preserve">
    <value>Recorded events</value>
    <comment>Header above the list of events read back from the activity log.</comment>
  </data>
  <data name="Activity_Filter.Header" xml:space="preserve">
    <value>Filter and group</value>
    <comment>Header for the group of controls that narrow and summarize the list of recorded events.</comment>
  </data>
  <data name="Activity_Filter.Description" xml:space="preserve">
    <value>Type to show only events whose program, command line, folder, reason or time contains that text. The settings below narrow the list further, and can collapse repeated events into a single counted row.</value>
    <comment>Additional description for the group of filtering and grouping controls. Presented near "Activity_Filter.Header".</comment>
  </data>
  <data name="Activity_FilterBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Filter recorded events</value>
    <comment>Name for the text box that narrows the list of recorded events.</comment>
  </data>
  <data name="Activity_FilterBox.PlaceholderText" xml:space="preserve">
    <value>Filter activity...</value>
    <comment>Placeholder text in the box that narrows the list of recorded events.</comment>
  </data>
  <data name="Activity_EventFilter.Header" xml:space="preserve">
    <value>Event type</value>
    <comment>Header for the event-type filter.</comment>
  </data>
  <data name="Activity_EventFilter.Description" xml:space="preserve">
    <value>Show only one kind of recorded event.</value>
    <comment>Additional description for the event-type filter. Presented near "Activity_EventFilter.Header".</comment>
  </data>
  <data name="Activity_EventFilterAll.Content" xml:space="preserve">
    <value>All events</value>
    <comment>Event-type filter option that includes every recorded event.</comment>
  </data>
  <data name="Activity_EventFilterProfileLaunch.Content" xml:space="preserve">
    <value>Profile launches</value>
    <comment>Event-type filter option for programs started by a Terminal profile.</comment>
  </data>
  <data name="Activity_EventFilterHandoff.Content" xml:space="preserve">
    <value>Console handoffs</value>
    <comment>Event-type filter option for programs handed to Terminal by console delegation.</comment>
  </data>
  <data name="Activity_EventFilterHelper.Content" xml:space="preserve">
    <value>Background helpers</value>
    <comment>Event-type filter option for Terminal's own background helper processes.</comment>
  </data>
  <data name="Activity_EventFilterProbe.Content" xml:space="preserve">
    <value>Probes</value>
    <comment>Event-type filter option for short-lived programs Terminal runs to look something up.</comment>
  </data>
  <data name="Activity_EventFilterShellVerb.Content" xml:space="preserve">
    <value>Explorer menu</value>
    <comment>Event-type filter option for launches that came from Explorer's "Open in Windows Terminal" menu item.</comment>
  </data>
  <data name="Activity_EventFilterElevate.Content" xml:space="preserve">
    <value>Elevation</value>
    <comment>Event-type filter option for Terminal relaunching itself as administrator.</comment>
  </data>
  <data name="Activity_GroupBy.Header" xml:space="preserve">
    <value>Group repeated events</value>
    <comment>Header for a control that collapses several recorded events into one counted row.</comment>
  </data>
  <data name="Activity_GroupBy.Description" xml:space="preserve">
    <value>Collapse events that share the chosen key into one row with a count and the time it was first seen. Most of a busy log is one command repeating, and grouping is what makes that visible at a glance.</value>
    <comment>Additional description for the grouping control. Presented near "Activity_GroupBy.Header".</comment>
  </data>
  <data name="Activity_GroupByNone.Content" xml:space="preserve">
    <value>Do not group</value>
    <comment>Grouping option that lists every recorded event on its own row.</comment>
  </data>
  <data name="Activity_GroupByCommand.Content" xml:space="preserve">
    <value>Identical commands</value>
    <comment>Grouping option that collapses events recording the same program and command line.</comment>
  </data>
  <data name="Activity_GroupByProgram.Content" xml:space="preserve">
    <value>Program</value>
    <comment>Grouping option that collapses every event for one program into one row.</comment>
  </data>
  <data name="Activity_GroupByEvent.Content" xml:space="preserve">
    <value>Event type</value>
    <comment>Grouping option that collapses every event of one kind into one row.</comment>
  </data>
  <data name="Activity_GroupByDay.Content" xml:space="preserve">
    <value>Day</value>
    <comment>Grouping option that collapses every event recorded on one day into one row.</comment>
  </data>
  <data name="Activity_ProgramFilter.Header" xml:space="preserve">
    <value>Program</value>
    <comment>Header for a filter that shows only the events recorded for one program.</comment>
  </data>
  <data name="Activity_ProgramFilter.Description" xml:space="preserve">
    <value>Only the programs the log actually holds are listed, each with how many events it accounts for.</value>
    <comment>Additional description for the program filter. Presented near "Activity_ProgramFilter.Header".</comment>
  </data>
  <data name="Activity_DayFilter.Header" xml:space="preserve">
    <value>Day</value>
    <comment>Header for a filter that shows only the events recorded on one day.</comment>
  </data>
  <data name="Activity_DayFilter.Description" xml:space="preserve">
    <value>Only the days the log actually covers are listed, newest first, each with how many events it holds.</value>
    <comment>Additional description for the day filter. Presented near "Activity_DayFilter.Header".</comment>
  </data>
  <data name="Activity_Reveal.Content" xml:space="preserve">
    <value>Show in Explorer</value>
    <comment>Label on a button that opens File Explorer with the activity log file selected.</comment>
  </data>
  <data name="Activity_Reveal.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>Open the folder the log is written to, with the file selected. If nothing has been recorded yet, just the folder opens.</value>
    <comment>Tooltip for a button that opens File Explorer with the activity log file selected.</comment>
  </data>
  <data name="Activity_AbsoluteTime.Header" xml:space="preserve">
    <value>Show absolute time</value>
    <comment>Header for the switch between relative and local absolute activity timestamps.</comment>
  </data>
  <data name="Activity_AbsoluteTime.Description" xml:space="preserve">
    <value>Show each time in your local date and time format instead of as an age.</value>
    <comment>Additional description for the absolute-time switch. Presented near "Activity_AbsoluteTime.Header".</comment>
  </data>
  <data name="Activity_ShowCommandLines.Header" xml:space="preserve">
    <value>Show command lines</value>
    <comment>Header for the switch that shows or hides the recorded command line on each row.</comment>
  </data>
  <data name="Activity_ShowCommandLines.Description" xml:space="preserve">
    <value>Turn this off for short rows. The full command line is still there: hover a row to read it.</value>
    <comment>Additional description for the switch that shows or hides command lines. Presented near "Activity_ShowCommandLines.Header".</comment>
  </data>
  <data name="Activity_Refresh.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Reload the activity log</value>
    <comment>Name for a button that re-reads the activity log from disk.</comment>
  </data>
  <data name="Activity_Refresh.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>Reload the activity log</value>
    <comment>Tooltip for a button that re-reads the activity log from disk.</comment>
  </data>
  <data name="Activity_Count.Text" xml:space="preserve">
    <value>Showing {0} of {1} recorded events, newest first.</value>
    <comment>Status line above the list of recorded events. {0} is how many are shown after filtering, {1} is how many were read.</comment>
  </data>
  <data name="Activity_ColumnTime.Text" xml:space="preserve">
    <value>Time</value>
    <comment>Column heading for an activity event's time.</comment>
  </data>
  <data name="Activity_ColumnEvent.Text" xml:space="preserve">
    <value>Event</value>
    <comment>Column heading for the recorded program and event kind.</comment>
  </data>
  <data name="Activity_ColumnCommand.Text" xml:space="preserve">
    <value>Command</value>
    <comment>Column heading for a recorded command line.</comment>
  </data>
  <data name="Activity_ColumnContext.Text" xml:space="preserve">
    <value>Context</value>
    <comment>Column heading for a recorded working directory and parent process.</comment>
  </data>
  <data name="Activity_Empty.Text" xml:space="preserve">
    <value>Nothing recorded yet. Events appear here as the terminal starts programs.</value>
    <comment>Status line shown when the activity log exists but is empty.</comment>
  </data>
  <data name="Activity_Disabled.Text" xml:space="preserve">
    <value>Recording is off, so nothing has been written. Turn it on above to start.</value>
    <comment>Status line shown when the activity log setting is turned off.</comment>
  </data>
  <data name="Activity_NoLocation.Text" xml:space="preserve">
    <value>The log location could not be determined.</value>
    <comment>Status line shown when the folder the activity log lives in cannot be found.</comment>
  </data>
  <data name="Activity_GroupCount.Text" xml:space="preserve">
    <value>Showing {0} groups covering {1} of {2} recorded events, newest first.</value>
    <comment>Status line above the list when events are grouped. {0} is how many groups are shown, {1} is how many events they account for, {2} is how many were read.</comment>
  </data>
  <data name="Activity_AllPrograms.Text" xml:space="preserve">
    <value>All programs</value>
    <comment>First option in the program filter, which includes every program in the log.</comment>
  </data>
  <data name="Activity_AnyDay.Text" xml:space="preserve">
    <value>Any day</value>
    <comment>First option in the day filter, which includes every day the log covers.</comment>
  </data>
  <data name="Activity_ChoiceWithCount.Text" xml:space="preserve">
    <value>{0} ({1})</value>
    <comment>One option in the program or day filter. {0} is the program name or the date, {1} is how many recorded events it accounts for.</comment>
  </data>
  <data name="Activity_Repeats.Text" xml:space="preserve">
    <value>×{0}</value>
    <comment>Badge on a grouped row saying how many events it stands for. {0} is the count. The leading character is a multiplication sign, as in "42 times".</comment>
  </data>
  <data name="Activity_FirstSeen.Text" xml:space="preserve">
    <value>first {0}</value>
    <comment>Second line of the time column on a grouped row, giving when the oldest event in the group was recorded. {0} is a time, either an age such as "3 hours ago" or a local date and time.</comment>
  </data>
  <data name="Activity_MixedEvents.Text" xml:space="preserve">
    <value>several kinds</value>
    <comment>Shown in place of an event kind on a grouped row whose members are not all the same kind of event.</comment>
  </data>
  <data name="Activity_MixedEventsTip.Text" xml:space="preserve">
    <value>The events in this group were not all recorded for the same reason.</value>
    <comment>Tooltip for a grouped row whose members are not all the same kind of event.</comment>
  </data>
  <data name="Activity_MixedPrograms.Text" xml:space="preserve">
    <value>Several programs</value>
    <comment>Shown in place of a program name on a grouped row whose members are not all the same program.</comment>
  </data>
  <data name="Activity_MixedCommands.Text" xml:space="preserve">
    <value>Several different command lines</value>
    <comment>Shown in place of a command line on a grouped row whose members do not all share one.</comment>
  </data>
  <data name="Activity_JustNow.Text" xml:space="preserve">
    <value>just now</value>
    <comment>Relative time for an event recorded less than a minute ago.</comment>
  </data>
  <data name="Activity_MinuteAgo.Text" xml:space="preserve">
    <value>1 minute ago</value>
    <comment>Relative time for an event recorded about one minute ago.</comment>
  </data>
  <data name="Activity_MinutesAgo.Text" xml:space="preserve">
    <value>{0} minutes ago</value>
    <comment>Relative time for an event recorded some minutes ago. {0} is a whole number of minutes, always two or more.</comment>
  </data>
  <data name="Activity_HourAgo.Text" xml:space="preserve">
    <value>1 hour ago</value>
    <comment>Relative time for an event recorded about one hour ago.</comment>
  </data>
  <data name="Activity_HoursAgo.Text" xml:space="preserve">
    <value>{0} hours ago</value>
    <comment>Relative time for an event recorded some hours ago. {0} is a whole number of hours, always two or more.</comment>
  </data>
  <data name="Activity_DayAgo.Text" xml:space="preserve">
    <value>1 day ago</value>
    <comment>Relative time for an event recorded about one day ago.</comment>
  </data>
  <data name="Activity_DaysAgo.Text" xml:space="preserve">
    <value>{0} days ago</value>
    <comment>Relative time for an event recorded some days ago. {0} is a whole number of days, always two or more.</comment>
  </data>
  <data name="Activity_KindProfileLaunch.Text" xml:space="preserve">
    <value>profile launch</value>
    <comment>Badge naming an event where Terminal started a program through one of its profiles.</comment>
  </data>
  <data name="Activity_KindProfileLaunchTip.Text" xml:space="preserve">
    <value>Terminal started this command through one of its profiles, such as when opening a new tab, pane, or window.</value>
    <comment>Tooltip explaining the "profile launch" event kind.</comment>
  </data>
  <data name="Activity_KindHandoff.Text" xml:space="preserve">
    <value>console handoff</value>
    <comment>Badge naming an event where Windows handed a console program to Terminal to host.</comment>
  </data>
  <data name="Activity_KindHandoffTip.Text" xml:space="preserve">
    <value>Windows console delegation handed this console program to Terminal to host, instead of starting it in a separate legacy console window.</value>
    <comment>Tooltip explaining the "console handoff" event kind.</comment>
  </data>
  <data name="Activity_KindHelper.Text" xml:space="preserve">
    <value>background helper</value>
    <comment>Badge naming an event where Terminal started one of its own background helper processes.</comment>
  </data>
  <data name="Activity_KindHelperTip.Text" xml:space="preserve">
    <value>Terminal started one of its own background helpers, such as the one that installs a staged build or checks for a new one.</value>
    <comment>Tooltip explaining the "background helper" event kind.</comment>
  </data>
  <data name="Activity_KindProbe.Text" xml:space="preserve">
    <value>probe</value>
    <comment>Badge naming an event where Terminal ran a short-lived program to look something up.</comment>
  </data>
  <data name="Activity_KindProbeTip.Text" xml:space="preserve">
    <value>Terminal ran a short-lived program to look something up, such as listing your installed WSL distributions.</value>
    <comment>Tooltip explaining the "probe" event kind.</comment>
  </data>
  <data name="Activity_KindShellVerb.Text" xml:space="preserve">
    <value>Explorer menu</value>
    <comment>Badge naming an event that came from Explorer's "Open in Windows Terminal" menu item.</comment>
  </data>
  <data name="Activity_KindShellVerbTip.Text" xml:space="preserve">
    <value>This came from Explorer's "Open in Windows Terminal" menu item, which runs inside Explorer rather than in Terminal.</value>
    <comment>Tooltip explaining the "Explorer menu" event kind.</comment>
  </data>
  <data name="Activity_KindElevate.Text" xml:space="preserve">
    <value>elevation</value>
    <comment>Badge naming an event where Terminal relaunched itself as administrator.</comment>
  </data>
  <data name="Activity_KindElevateTip.Text" xml:space="preserve">
    <value>Terminal relaunched itself as administrator, which is how a profile that asks to run elevated is started.</value>
    <comment>Tooltip explaining the "elevation" event kind.</comment>
  </data>
  <data name="Activity_KindUnknown.Text" xml:space="preserve">
    <value>unknown event</value>
    <comment>Badge shown for a recorded event that carries no kind at all.</comment>
  </data>
  <data name="Activity_KindUnknownTip.Text" xml:space="preserve">
    <value>This build has no name for this kind of event. The log may have been written by a newer version of Terminal.</value>
    <comment>Tooltip for a recorded event whose kind this build does not recognize.</comment>
  </data>
  <data name="Activity_HoverRange.Text" xml:space="preserve">
    <value>{0} events, {1} to {2}</value>
    <comment>First line of the hover popover on a grouped row. {0} is how many events the group holds, {1} is when the oldest was recorded and {2} the newest, both as a local date and time.</comment>
  </data>
  <data name="Activity_HoverFolder.Text" xml:space="preserve">
    <value>Folder: {0}</value>
    <comment>Line in the hover popover naming the folder a recorded program was started in. {0} is a path.</comment>
  </data>
  <data name="Activity_HoverParent.Text" xml:space="preserve">
    <value>Started by: {0}</value>
    <comment>Line in the hover popover naming the program that started the recorded one. {0} is a program name or path.</comment>
  </data>
  <data name="Activity_HoverReason.Text" xml:space="preserve">
    <value>Reason: {0}</value>
    <comment>Line in the hover popover giving what Terminal recorded about why this happened. {0} is a short phrase such as "split pane".</comment>
  </data>
  <data name="Globals_AlwaysOnTop.Description" xml:space="preserve">
    <value>Terminal will always be the topmost window on the desktop.</value>
    <comment>A description for what the "always on top" setting does. Presented near "Globals_AlwaysOnTop.Header".</comment>
  </data>
  <data name="Profile_ForceVTInput.Description" xml:space="preserve">
    <value>Certain keyboard input in some applications may stop working properly when this setting is enabled.</value>
    <comment>Additional description for what the "force vt input" setting does. Presented near "Globals_ForceVTInput.Header".</comment>
  </data>
  <data name="Globals_AllowHeadless.Description" xml:space="preserve">
    <value>Allows Global Summon and Quake Mode to work when no windows are open.</value>
    <comment>Additional description for what the "allow headless" setting does. Presented near "Globals_AllowHeadless.Header".</comment>
  </data>
  <data name="Globals_AylithImprintJsonOnly.Header" xml:space="preserve">
    <value>Mark settings upstream hides in JSON</value>
    <comment>Header for a switch that shows a small hollow diamond next to settings that exist in Microsoft's Windows Terminal but can only be set there by editing a JSON file by hand.</comment>
  </data>
  <data name="Globals_AylithImprintJsonOnly.Description" xml:space="preserve">
    <value>Shows a ◇ beside any setting that upstream Windows Terminal has, but only exposes in settings.json.</value>
    <comment>A description for what the "mark settings upstream hides in JSON" setting does. The ◇ character is a hollow diamond and should be kept as-is; it matches the mark drawn in the interface.</comment>
  </data>
  <data name="Globals_DockWindow.Header" xml:space="preserve">
    <value>Dock the window</value>
    <comment>Header for a control that pins the window to one edge of the screen.</comment>
  </data>
  <data name="Globals_DockWindow.Description" xml:space="preserve">
    <value>Snaps the window to a side of the screen and keeps it there. A docked window cannot be moved, and can only be resized by its inner edge.</value>
    <comment>A description for what the "dock the window" setting does.</comment>
  </data>
  <data name="Globals_DockWindowOff.Content" xml:space="preserve">
    <value>Off</value>
    <comment>An option for the "dock the window" setting. The window behaves normally and can be moved anywhere.</comment>
  </data>
  <data name="Globals_DockWindowTop.Content" xml:space="preserve">
    <value>Top</value>
    <comment>An option for the "dock the window" setting. The window fills the width of the screen along its top edge.</comment>
  </data>
  <data name="Globals_DockWindowBottom.Content" xml:space="preserve">
    <value>Bottom</value>
    <comment>An option for the "dock the window" setting. The window fills the width of the screen along its bottom edge.</comment>
  </data>
  <data name="Globals_DockWindowLeft.Content" xml:space="preserve">
    <value>Left</value>
    <comment>An option for the "dock the window" setting. The window fills the height of the screen down its left edge.</comment>
  </data>
  <data name="Globals_DockWindowRight.Content" xml:space="preserve">
    <value>Right</value>
    <comment>An option for the "dock the window" setting. The window fills the height of the screen down its right edge.</comment>
  </data>
  <data name="Globals_DockSize.Header" xml:space="preserve">
    <value>Docked size</value>
    <comment>Header for a slider choosing how much of the screen a docked window takes up. The value is a percentage.</comment>
  </data>
  <data name="Globals_DockSize.Description" xml:space="preserve">
    <value>How much of the screen the docked window covers, as a percentage.</value>
    <comment>A description for what the "docked size" setting does. Presented near "Globals_DockSize.Header".</comment>
  </data>
  <data name="Globals_TabIconStyle.Header" xml:space="preserve">
    <value>Profile icon on tabs</value>
    <comment>Header for a control choosing how the profile's icon is drawn on each tab.</comment>
  </data>
  <data name="Globals_TabIconStyle.Description" xml:space="preserve">
    <value>Overrides the icon style set by the active theme.</value>
    <comment>A description for what the "profile icon on tabs" setting does. "Theme" here means a colour and chrome theme chosen further up this page.</comment>
  </data>
  <data name="Globals_TabIconStyleDefault.Content" xml:space="preserve">
    <value>Show in colour</value>
    <comment>An option for the "profile icon on tabs" setting. The icon is drawn as the profile defines it, in full colour.</comment>
  </data>
  <data name="Globals_TabIconStyleHidden.Content" xml:space="preserve">
    <value>Hide</value>
    <comment>An option for the "profile icon on tabs" setting. No icon is drawn.</comment>
  </data>
  <data name="Globals_TabIconStyleMonochrome.Content" xml:space="preserve">
    <value>Show in one colour</value>
    <comment>An option for the "profile icon on tabs" setting. The icon is drawn in a single flat colour instead of its own colours.</comment>
  </data>
  <data name="Globals_TabCloseButton.Header" xml:space="preserve">
    <value>Close button on tabs</value>
    <comment>Header for a control choosing when each tab shows its close button.</comment>
  </data>
  <data name="Globals_TabCloseButton.Description" xml:space="preserve">
    <value>Overrides the active theme. Middle-clicking a tab closes it whichever setting you choose.</value>
    <comment>A description for what the "close button on tabs" setting does. Middle-clicking means clicking with the mouse wheel.</comment>
  </data>
  <data name="Globals_TabCloseButtonAlways.Content" xml:space="preserve">
    <value>Always</value>
    <comment>An option for the "close button on tabs" setting. Every tab shows its close button at all times.</comment>
  </data>
  <data name="Globals_TabCloseButtonHover.Content" xml:space="preserve">
    <value>On hover</value>
    <comment>An option for the "close button on tabs" setting. A tab shows its close button only while the mouse is over it.</comment>
  </data>
  <data name="Globals_TabCloseButtonActiveOnly.Content" xml:space="preserve">
    <value>Active tab only</value>
    <comment>An option for the "close button on tabs" setting. Only the tab currently in use shows a close button.</comment>
  </data>
  <data name="Globals_TabCloseButtonNever.Content" xml:space="preserve">
    <value>Never</value>
    <comment>An option for the "close button on tabs" setting. No tab shows a close button.</comment>
  </data>
  <data name="Globals_ShowTabIndex.Header" xml:space="preserve">
    <value>Show tab numbers</value>
    <comment>Header for a control to toggle whether each tab shows its position in the row.</comment>
  </data>
  <data name="Globals_ShowTabIndex.Description" xml:space="preserve">
    <value>Numbers each tab by its position, starting at 1.</value>
    <comment>A description for what the "show tab numbers" setting does. Presented near "Globals_ShowTabIndex.Header".</comment>
  </data>
  <data name="Globals_CloseWindowOnLastTab.Header" xml:space="preserve">
    <value>Close the window after closing the last tab</value>
    <comment>Header for a control to toggle whether the window closes once its final tab is closed.</comment>
  </data>
  <data name="Globals_CloseWindowOnLastTab.Description" xml:space="preserve">
    <value>When off, the window stays open and a new tab takes the place of the last one.</value>
    <comment>A description for what the "close the window after closing the last tab" setting does. Presented near "Globals_CloseWindowOnLastTab.Header".</comment>
  </data>
  <data name="Globals_PaneResizeStep.Header" xml:space="preserve">
    <value>Pane resize step</value>
    <comment>Header for a slider choosing how far a keyboard shortcut moves the divider between two panes. The value is a percentage.</comment>
  </data>
  <data name="Globals_PaneResizeStep.Description" xml:space="preserve">
    <value>How far, as a percentage of the pane, the resize pane shortcuts move the divider.</value>
    <comment>A description for what the "pane resize step" setting does. Presented near "Globals_PaneResizeStep.Header".</comment>
  </data>
  <data name="Globals_TabPosition.Header" xml:space="preserve">
    <value>Tab position</value>
    <comment>Header for a control to choose which edge of the window the row of tabs sits on.</comment>
  </data>
  <data name="Globals_TabPosition.Description" xml:space="preserve">
    <value>Left and right show the tabs as a vertical sidebar you can resize by dragging its inner edge. Only Top can draw the tabs into the title bar.</value>
    <comment>A description for what the "tab position" setting does. Presented near "Globals_TabPosition.Header". 'Left', 'right' and 'Top' must match the values for &lt;Globals_TabPositionLeft.Content&gt;, &lt;Globals_TabPositionRight.Content&gt; and &lt;Globals_TabPositionTop.Content&gt;.</comment>
  </data>
  <data name="Globals_TabPositionTop.Content" xml:space="preserve">
    <value>Top</value>
    <comment>An option to choose from for the "tab position" setting. When selected, the tabs run along the top of the window, above the terminal.</comment>
  </data>
  <data name="Globals_TabPositionBottom.Content" xml:space="preserve">
    <value>Bottom</value>
    <comment>An option to choose from for the "tab position" setting. When selected, the tabs run along the bottom of the window, below the terminal.</comment>
  </data>
  <data name="Globals_TabPositionLeft.Content" xml:space="preserve">
    <value>Left</value>
    <comment>An option to choose from for the "tab position" setting. When selected, the tabs are stacked in a vertical column on the left of the window, beside the terminal.</comment>
  </data>
  <data name="Globals_TabPositionRight.Content" xml:space="preserve">
    <value>Right</value>
    <comment>An option to choose from for the "tab position" setting. When selected, the tabs are stacked in a vertical column on the right of the window, beside the terminal.</comment>
  </data>
  <data name="Globals_NewTabButtonPosition.Header" xml:space="preserve">
    <value>New tab button position</value>
    <comment>Header for a control to choose where the button that opens a new tab sits within a vertical row of tabs.</comment>
  </data>
  <data name="Globals_NewTabButtonPosition.Description" xml:space="preserve">
    <value>Only applies when the tab position is Left or Right. A horizontal row of tabs always puts the button beside them.</value>
    <comment>A description for what the "new tab button position" setting does. Presented near "Globals_NewTabButtonPosition.Header". 'Left' and 'Right' must match the values for &lt;Globals_TabPositionLeft.Content&gt; and &lt;Globals_TabPositionRight.Content&gt;.</comment>
  </data>
  <data name="Globals_NewTabButtonPositionBottom.Content" xml:space="preserve">
    <value>Bottom of the sidebar</value>
    <comment>An option to choose from for the "new tab button position" setting. When selected, the button stays at the foot of the column of tabs, however many tabs there are.</comment>
  </data>
  <data name="Globals_NewTabButtonPositionAfterTabs.Content" xml:space="preserve">
    <value>Under the last tab</value>
    <comment>An option to choose from for the "new tab button position" setting. When selected, the button sits immediately below the last tab, and moves down as tabs are opened.</comment>
  </data>
  <data name="Globals_SettingsUIHost.Header" xml:space="preserve">
    <value>Open settings in</value>
    <comment>Header for a control to choose where the settings pages themselves appear when opened.</comment>
  </data>
  <data name="Globals_SettingsUIHost.Description" xml:space="preserve">
    <value>Where this settings page appears when you open it. A dialog keeps your terminal in view behind it and closes with Esc.</value>
    <comment>A description for what the "open settings in" setting does. Presented near "Globals_SettingsUIHost.Header". 'Esc' is the name of the Escape key and should not be translated if the key is labelled that way locally.</comment>
  </data>
  <data name="Globals_SettingsUIHostTab.Content" xml:space="preserve">
    <value>A tab</value>
    <comment>An option to choose from for the "open settings in" setting. When selected, settings open as another tab in the window, alongside the terminals.</comment>
  </data>
  <data name="Globals_SettingsUIHostDialog.Content" xml:space="preserve">
    <value>A dialog over the window</value>
    <comment>An option to choose from for the "open settings in" setting. When selected, settings open centred over the current window, dimming the terminal behind them.</comment>
  </data>
  <data name="Globals_SettingsUIHostWindow.Content" xml:space="preserve">
    <value>Its own window</value>
    <comment>An option to choose from for the "open settings in" setting. When selected, settings open in a separate resizable window with its own taskbar entry.</comment>
  </data>
  <data name="Globals_TabWidthMode.Header" xml:space="preserve">
    <value>Tab width mode</value>
    <comment>Header for a control to choose how wide the tabs are.</comment>
  </data>
  <data name="Globals_TabWidthMode.Description" xml:space="preserve">
    <value>Compact will shrink inactive tabs to the size of the icon.</value>
    <comment>A description for what the "tab width mode" setting does. Presented near "Globals_TabWidthMode.Header". 'Compact' must match the value for &lt;Globals_TabWidthModeCompact.Content&gt;.</comment>
  </data>
  <data name="Globals_TabWidthModeCompact.Content" xml:space="preserve">
    <value>Compact</value>
    <comment>An option to choose from for the "tab width mode" setting. When selected, unselected tabs collapse to show only their icon. The selected tab adjusts to display the content within the tab.</comment>
  </data>
  <data name="Globals_TabWidthModeEqual.Content" xml:space="preserve">
    <value>Equal</value>
    <comment>An option to choose from for the "tab width mode" setting. When selected, each tab has the same width.</comment>
  </data>
  <data name="Globals_TabWidthModeTitleLength.Content" xml:space="preserve">
    <value>Title length</value>
    <comment>An option to choose from for the "tab width mode" setting. When selected, each tab adjusts its width to the content within the tab.</comment>
  </data>
  <data name="Globals_Theme.Header" xml:space="preserve">
    <value>Application Theme</value>
    <comment>Header for a control to choose the theme colors used in the app.</comment>
  </data>
  <data name="Globals_Theme.Description" xml:space="preserve">
    <value>The theme also decides where acrylic is allowed.</value>
    <comment>A description for the group of settings headed by "Globals_Theme.Header", which contains the two acrylic settings.</comment>
  </data>
  <data name="Globals_ThemeDark.Content" xml:space="preserve">
    <value>Dark</value>
    <comment>An option to choose from for the "theme" setting. When selected, the app is in dark theme and darker colors are used throughout the app.</comment>
  </data>
  <data name="Globals_ThemeSystem.Content" xml:space="preserve">
    <value>Use Windows theme</value>
    <comment>An option to choose from for the "theme" setting. When selected, the app uses the theme selected in the Windows operating system.</comment>
  </data>
  <data name="Globals_ThemeLight.Content" xml:space="preserve">
    <value>Light</value>
    <comment>An option to choose from for the "theme" setting. When selected, the app is in light theme and lighter colors are used throughout the app.</comment>
  </data>
  <data name="Globals_ThemeDarkLegacy.Content" xml:space="preserve">
    <value>Dark (Legacy)</value>
    <comment>An option to choose from for the "theme" setting. When selected, the app is in dark theme and darker colors are used throughout the app. This is an older version of the "dark" theme</comment>
  </data>
  <data name="Globals_ThemeSystemLegacy.Content" xml:space="preserve">
    <value>Use Windows theme (Legacy)</value>
    <comment>An option to choose from for the "theme" setting. When selected, the app uses the theme selected in the Windows operating system. This is an older version of the "Use Windows theme" theme</comment>
  </data>
  <data name="Globals_ThemeLightLegacy.Content" xml:space="preserve">
    <value>Light (Legacy)</value>
    <comment>An option to choose from for the "theme" setting. When selected, the app is in light theme and lighter colors are used throughout the app. This is an older version of the "light" theme</comment>
  </data>
  <data name="Globals_WordDelimiters.Header" xml:space="preserve">
    <value>Word delimiters</value>
    <comment>Header for a control to determine what delimiters to use to identify separate words during word selection.</comment>
  </data>
  <data name="Globals_WordDelimiters.Description" xml:space="preserve">
    <value>These symbols will be used when you double-click text in the terminal or activate "Mark mode".</value>
    <comment>A description for what the "word delimiters" setting does. Presented near "Globals_WordDelimiters.Header". "Mark" is used in the sense of "choosing something to interact with."</comment>
  </data>
  <data name="Nav_Appearance.Content" xml:space="preserve">
    <value>Personalization</value>
    <comment>Header for the "personalization" menu item. This navigates to a page that lets you see and modify settings related to personalizing the app's appearance.</comment>
  </data>
  <data name="Nav_ColorSchemes.Content" xml:space="preserve">
    <value>Color schemes</value>
    <comment>Header for the "color schemes" menu item. This navigates to a page that lets you see and modify schemes of colors that can be used by the terminal.</comment>
  </data>
  <data name="Nav_Interaction.Content" xml:space="preserve">
    <value>Interaction</value>
    <comment>Header for the "interaction" menu item. This navigates to a page that lets you see and modify settings related to the user's mouse and touch interactions with the app.</comment>
  </data>
  <data name="Nav_Compatibility.Content" xml:space="preserve">
    <value>Compatibility</value>
    <comment>Header for the "compatibility" menu item. This navigates to a page that lets you see and modify settings related to compatibility with command line scenarios.</comment>
  </data>
  <data name="Nav_Activity.Content" xml:space="preserve">
    <value>Activity</value>
    <comment>Header for the "activity" menu item. This navigates to a page listing every program the terminal has started or been handed.</comment>
  </data>
  <data name="Nav_Launch.Content" xml:space="preserve">
    <value>Startup</value>
    <comment>Header for the "startup" menu item. This navigates to a page that lets you see and modify settings related to the app's launch experience (i.e. screen position, mode, etc.)</comment>
  </data>
  <data name="Nav_SessionRestore.Content" xml:space="preserve">
    <value>Session Restore</value>
    <comment>Header for the "session restore" menu item. This navigates to a page that lets you see and modify settings about putting a previous session's windows, panes, scrollback and running programs back.</comment>
  </data>
  <data name="Nav_PaneOpenedAnnouncement" xml:space="preserve">
    <value>Navigation pane opened</value>
    <comment>Screen reader announcement made when the user activates the toggle button that opens the settings navigation pane.</comment>
  </data>
  <data name="Nav_PaneClosedAnnouncement" xml:space="preserve">
    <value>Navigation pane closed</value>
    <comment>Screen reader announcement made when the user activates the toggle button that closes the settings navigation pane.</comment>
  </data>
  <data name="Nav_OpenJSON.Content" xml:space="preserve">
    <value>Open JSON file</value>
    <comment>Header for a menu item. This opens the JSON file that is used to log the app's settings.</comment>
  </data>
  <data name="Nav_GroupStartup.Content" xml:space="preserve">
    <value>STARTUP</value>
    <comment>Section heading in the settings navigation list, above the pages about what happens when the Terminal opens. Upper case is the intended styling for these headings; lower-case it if that reads badly in your locale.</comment>
  </data>
  <data name="Nav_GroupBehavior.Content" xml:space="preserve">
    <value>BEHAVIOR</value>
    <comment>Section heading in the settings navigation list, above the pages about how the Terminal responds to the user and to what is on screen. Upper case is the intended styling for these headings; lower-case it if that reads badly in your locale.</comment>
  </data>
  <data name="Nav_GroupAppearance.Content" xml:space="preserve">
    <value>APPEARANCE</value>
    <comment>Section heading in the settings navigation list, above the pages about how the Terminal looks and how text is drawn. Upper case is the intended styling for these headings; lower-case it if that reads badly in your locale.</comment>
  </data>
  <data name="Nav_GroupCommands.Content" xml:space="preserve">
    <value>COMMANDS</value>
    <comment>Section heading in the settings navigation list, above the pages about the ways a command can be invoked: keyboard shortcuts and the new tab dropdown menu. Upper case is the intended styling for these headings; lower-case it if that reads badly in your locale.</comment>
  </data>
  <data name="Nav_GroupProfiles.Content" xml:space="preserve">
    <value>PROFILES</value>
    <comment>Section heading in the settings navigation list, above the pages about the profiles the Terminal can open and the extensions that contribute them. Upper case is the intended styling for these headings; lower-case it if that reads badly in your locale.</comment>
  </data>
  <data name="Nav_GroupAdvanced.Content" xml:space="preserve">
    <value>ADVANCED</value>
    <comment>Section heading in the settings navigation list, above the compatibility and activity log pages. Upper case is the intended styling for these headings; lower-case it if that reads badly in your locale.</comment>
  </data>
  <data name="Nav_GroupHelp.Content" xml:space="preserve">
    <value>HELP</value>
    <comment>Section heading in the settings navigation list, above the documentation page. Upper case is the intended styling for these headings; lower-case it if that reads badly in your locale.</comment>
  </data>
  <data name="Nav_ProfileDefaults.Content" xml:space="preserve">
    <value>Defaults</value>
    <comment>Header for the "defaults" menu item. This navigates to a page that lets you see and modify settings that affect profiles. This is the lowest layer of profile settings that all other profile settings are based on. If a profile doesn't define a setting, this page is responsible for figuring out what that setting is supposed to be.</comment>
  </data>
  <data name="Nav_Actions.Content" xml:space="preserve">
    <value>Shortcuts</value>
    <comment>Header for the "actions" menu item. This navigates to a page that lets you see the available commands in the app.</comment>
  </data>
  <data name="Nav_EditAction.Content" xml:space="preserve">
    <value>Edit Shortcut</value>
    <comment>Header for the "edit shortcut" page. This is the page that lets you modify a specific shortcut and its key bindings.</comment>
  </data>
  <data name="Nav_Extensions.Content" xml:space="preserve">
    <value>Extensions</value>
    <comment>Header for the "extensions" menu item. This navigates to a page that lets you see and modify extensions for the app.</comment>
  </data>
  <data name="Profile_OpacitySlider.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Background opacity</value>
    <comment>Name for a control to determine the level of opacity for the background of the control. The user can choose to make the background of the app more or less opaque.</comment>
  </data>
  <data name="Profile_Opacity.Header" xml:space="preserve">
    <value>Background opacity</value>
    <comment>Header for a control to determine the level of opacity for the background of the control. The user can choose to make the background of the app more or less opaque.</comment>
  </data>
  <data name="Profile_Opacity.Description" xml:space="preserve">
    <value>Sets the opacity of the window.</value>
    <comment>A description for what the "opacity" setting does. Presented near "Profile_Opacity.Header".</comment>
  </data>
  <data name="Profile_Advanced.Header" xml:space="preserve">
    <value>Advanced</value>
    <comment>Header for a sub-page of profile settings focused on more advanced scenarios.</comment>
  </data>
  <data name="Profile_Terminal.Header" xml:space="preserve">
    <value>Terminal Emulation</value>
    <comment>Header for a sub-page of profile settings focused on customizing the capabilities of the terminal.</comment>
  </data>
  <data name="Profile_AltGrAliasing.Header" xml:space="preserve">
    <value>AltGr aliasing</value>
    <comment>Header for a control to toggle whether the app treats ctrl+alt as the AltGr (also known as the Alt Graph) modifier key found on keyboards. {Locked="AltGr"}</comment>
  </data>
  <data name="Profile_AltGrAliasing.Description" xml:space="preserve">
    <value>By default, Windows treats Ctrl+Alt as an alias for AltGr. This setting will override Windows' default behavior.</value>
    <comment>A description for what the "AltGr aliasing" setting does. Presented near "Profile_AltGrAliasing.Header". {Locked="Windows"}</comment>
  </data>
  <data name="Profile_AntialiasingMode.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Text antialiasing</value>
    <comment>Name for a control to select the graphical anti-aliasing format of text.</comment>
  </data>
  <data name="Profile_AntialiasingMode.Header" xml:space="preserve">
    <value>Text antialiasing</value>
    <comment>Header for a control to select the graphical anti-aliasing format of text.</comment>
  </data>
  <data name="Profile_AntialiasingMode.Description" xml:space="preserve">
    <value>Controls how text is antialiased in the renderer.</value>
    <comment>A description for what the "antialiasing mode" setting does. Presented near "Profile_AntialiasingMode.Header".</comment>
  </data>
  <data name="Profile_AntialiasingModeAliased.Content" xml:space="preserve">
    <value>Aliased</value>
    <comment>An option to choose from for the "text antialiasing" setting. When selected, the app's text renderer does not use antialiasing techniques.</comment>
  </data>
  <data name="Profile_AntialiasingModeClearType.Content" xml:space="preserve">
    <value>ClearType</value>
    <comment>An option to choose from for the "text antialiasing" setting. When selected, the app's text renderer uses a "ClearType" antialiasing technique. {Locked="ClearType"}</comment>
  </data>
  <data name="Profile_AntialiasingModeGrayscale.Content" xml:space="preserve">
    <value>Grayscale</value>
    <comment>An option to choose from for the "text antialiasing" setting. When selected, the app's text renderer uses a grayscale antialiasing technique.</comment>
  </data>
  <data name="Profile_Appearance.Header" xml:space="preserve">
    <value>Appearance</value>
    <comment>Header for a sub-page of profile settings focused on customizing the appearance of the profile.</comment>
  </data>
  <data name="Profile_UnfocusedAppearanceNone" xml:space="preserve">
    <value>None</value>
    <comment>Shown on the "Unfocused appearance" navigator card when no unfocused appearance has been defined for the profile.</comment>
  </data>
  <data name="Profile_BackgroundImageBox.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Background image path</value>
    <comment>Name for a control to determine the image presented on the background of the app.</comment>
  </data>
  <data name="Profile_BackgroundImage.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Background image path</value>
    <comment>Name for a control to determine the image presented on the background of the app.</comment>
  </data>
  <data name="Profile_BackgroundImage.Header" xml:space="preserve">
    <value>Background image path</value>
    <comment>Header for a control to determine the image presented on the background of the app.</comment>
  </data>
  <data name="Profile_BackgroundImage.Description" xml:space="preserve">
    <value>File location of the image used in the background of the window.</value>
    <comment>A description for what the "background image path" setting does. Presented near "Profile_BackgroundImage".</comment>
  </data>
  <data name="Profile_BackgroundImageAlignment.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Background image alignment</value>
    <comment>Name for a control to choose the visual alignment of the image presented on the background of the app.</comment>
  </data>
  <data name="Profile_BackgroundImageAlignment.Header" xml:space="preserve">
    <value>Background image alignment</value>
    <comment>Header for a control to choose the visual alignment of the image presented on the background of the app.</comment>
  </data>
  <data name="Profile_BackgroundImageAlignment.Description" xml:space="preserve">
    <value>Sets how the background image aligns to the boundaries of the window.</value>
    <comment>A description for what the "background image alignment" setting does. Presented near "Profile_BackgroundImageAlignment".</comment>
  </data>
  <data name="Profile_BackgroundImageAlignmentBottom.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>Bottom</value>
    <comment>This is the formal name for a visual alignment.</comment>
  </data>
  <data name="Profile_BackgroundImageAlignmentBottomLeft.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>Bottom left</value>
    <comment>This is the formal name for a visual alignment.</comment>
  </data>
  <data name="Profile_BackgroundImageAlignmentBottomRight.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>Bottom right</value>
    <comment>This is the formal name for a visual alignment.</comment>
  </data>
  <data name="Profile_BackgroundImageAlignmentCenter.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>Center</value>
    <comment>This is the formal name for a visual alignment.</comment>
  </data>
  <data name="Profile_BackgroundImageAlignmentLeft.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>Left</value>
    <comment>This is the formal name for a visual alignment.</comment>
  </data>
  <data name="Profile_BackgroundImageAlignmentRight.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>Right</value>
    <comment>This is the formal name for a visual alignment.</comment>
  </data>
  <data name="Profile_BackgroundImageAlignmentTop.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>Top</value>
    <comment>This is the formal name for a visual alignment.</comment>
  </data>
  <data name="Profile_BackgroundImageAlignmentTopLeft.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>Top left</value>
    <comment>This is the formal name for a visual alignment.</comment>
  </data>
  <data name="Profile_BackgroundImageAlignmentTopRight.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>Top right</value>
    <comment>This is the formal name for a visual alignment.</comment>
  </data>
  <data name="Profile_BackgroundImageBrowse.[using:Windows.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve">
    <value>Browse...</value>
    <comment>Button label that opens a file picker in a new window. The "..." is standard to mean it will open a new window.</comment>
  </data>
  <data name="Profile_AddFontAxisButton.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Add new font axis</value>
  </data>
  <data name="Profile_AddNewFontAxis.Text" xml:space="preserve">
    <value>Add new</value>
    <comment>Button label that adds a new font axis for the current font.</comment>
  </data>
  <data name="Profile_AddFontFeatureButton.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Add new font feature</value>
  </data>
  <data name="Profile_DeleteFontKeyValuePairButton.[using:Windows.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve">
    <value>Delete</value>
  </data>
