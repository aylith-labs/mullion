<Page x:Class="Microsoft.Terminal.Settings.Editor.LinkTooltip"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Microsoft.Terminal.Settings.Editor"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CommonResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="EnumComboBoxTemplate"
                          x:DataType="local:EnumEntry">
                <TextBlock Text="{x:Bind EnumName, Mode=OneWay}" />
            </DataTemplate>

            <DataTemplate x:Key="IntegrationChoiceComboBoxTemplate"
                          x:DataType="local:IntegrationChoiceViewModel">
                <TextBlock Text="{x:Bind DisplayName}" />
            </DataTemplate>

            <!--  Shared by the global button list and by a rule's override of it.  -->
            <DataTemplate x:Key="ButtonChoiceTemplate"
                          x:DataType="local:ButtonChoiceViewModel">
                <CheckBox Content="{x:Bind Label}"
                          IsChecked="{x:Bind Selected, Mode=TwoWay}" />
            </DataTemplate>

            <!--
                One rule's row. Shared by the grouped view and, through the
                draggable template below, by the flat one - so the two orderings
                cannot drift apart. The chevron is not markup: SettingsCard draws
                it itself once IsClickEnabled is set.
            -->
            <DataTemplate x:Key="RuleRowTemplate"
                          x:DataType="local:HyperlinkTooltipRuleViewModel">
                <local:SettingsCard x:Uid="LinkTooltip_RuleNavigator"
                                    Margin="0,2,0,0"
                                    AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                                    Click="EditRule_Click"
                                    Description="{x:Bind SummaryText, Mode=OneWay}"
                                    Header="{x:Bind DisplayName, Mode=OneWay}"
                                    IsClickEnabled="True"
                                    Tag="{x:Bind}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="4">
                        <ToggleSwitch VerticalAlignment="Center"
                                      IsOn="{x:Bind Enabled, Mode=TwoWay}"
                                      OffContent=""
                                      OnContent=""
                                      Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                        <Button x:Uid="LinkTooltip_DeleteRuleButton"
                                Click="DeleteRule_Click"
                                Tag="{x:Bind}">
                            <FontIcon FontSize="{StaticResource StandardIconSize}"
                                      Glyph="&#xE74D;" />
                        </Button>
                    </StackPanel>
                </local:SettingsCard>
            </DataTemplate>

            <!--
                The same row with a grip in front of it. Only the flat list uses
                this: in the grouped view the order on screen is derived, so
                there is nothing to drag.
            -->
            <DataTemplate x:Key="DraggableRuleRowTemplate"
                          x:DataType="local:HyperlinkTooltipRuleViewModel">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Margin="4,0,8,0"
                              VerticalAlignment="Center"
                              FontSize="{StaticResource StandardIconSize}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              Glyph="&#xE76F;" />
                    <ContentPresenter Grid.Column="1"
                                      Content="{x:Bind}"
                                      ContentTemplate="{StaticResource RuleRowTemplate}" />
                </Grid>
            </DataTemplate>

            <Style x:Key="RulePatternHintStyle"
                   BasedOn="{StaticResource DisclaimerStyle}"
                   TargetType="TextBlock">
                <Setter Property="Margin" Value="0,4,0,4" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel>
        <!--
            The defaults and the list of rules. Hidden while a rule is open, so
            editing a rule reads as a page of its own rather than as a block
            grafted onto the bottom of this one.
        -->
        <StackPanel Visibility="{x:Bind ViewModel.IsNotEditingRule, Mode=OneWay}">
            <!--  Defaults, moved here from the Interaction page  -->
            <StackPanel Spacing="2"
                        Style="{StaticResource SettingsStackStyle}">
                <TextBlock x:Uid="LinkTooltip_DefaultsHeader"
                           Style="{StaticResource TextBlockSubHeaderStyle}" />

                <!-- Live Preview Mockup Card -->
                <Border Margin="0,4,0,12"
                        Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        MaxWidth="600"
                        HorizontalAlignment="Left">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="15" Glyph="&#xE8B9;" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Preview Appearance" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>

                        <!-- Tooltip Card Mockup -->
                        <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontSize="16" Glyph="&#xE82D;" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <TextBlock Text="GitHub Pull Request" FontWeight="SemiBold" FontSize="13" />
                                    <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                            CornerRadius="10"
                                            Padding="6,1,6,1"
                                            Margin="4,0,0,0">
                                        <TextBlock Text="Open" FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>

                                <RichTextBlock IsTextSelectionEnabled="False">
                                    <Paragraph FontFamily="Cascadia Code, Consolas" FontSize="12">
                                        <Run Text="https://github.com/" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Run Text="microsoft/terminal" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <Run Text="/pull/" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Run Text="18920" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Paragraph>
                                </RichTextBlock>

                                <TextBlock Text="Add hyperlink preview cards and customizable platform rules"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           TextWrapping="Wrap" />

                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                    <Button Padding="8,3,8,3" FontSize="12" AllowFocusOnInteraction="False">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                            <TextBlock Text="Open" />
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="8,3,8,3" FontSize="12" AllowFocusOnInteraction="False">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                            <TextBlock Text="Copy link" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <local:SettingsCard x:Name="DetectURLs"
                                    x:Uid="Globals_DetectURLs">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.DetectURLs, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                </local:SettingsCard>

                <!--
                    Detection and clicking are separate: a link can be detected,
                    hovered and previewed without a click ever activating it, which
                    is the point of turning this off - you pick the action from the
                    tooltip instead. The list under it says which kinds of link a
                    click reaches, and greys out when clicking is off entirely.
                -->
                <!--
                    The whole of clicking, as one group: the master switch is the
                    expander's own header, and everything it gates is inside. The
                    IsEnabled bindings stay on the rows rather than moving up to the
                    expander, because disabling a SettingsExpander disables its
                    header too - which would make the master switch unclickable and
                    the group impossible to turn back on.
                -->
                <local:SettingsExpander x:Name="HyperlinkClickable"
                                        x:Uid="Globals_HyperlinkClickable"
                                        IsForkFeature="True">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.HyperlinkClickable, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                    <local:SettingsExpander.Items>

                        <!--
                            HorizontalContentAlignment="Left" is required, not decorative:
                            ContentAlignment="Vertical" only stretches the presenter across
                            the row, and SettingsCard then propagates the card's own
                            HorizontalContentAlignment to it - which the style defaults to
                            Right. Without this the checkboxes sit against the right edge,
                            a column away from the header they belong to.
                        -->
                        <local:SettingsCard x:Name="HyperlinkClickableKinds"
                                            x:Uid="Globals_HyperlinkClickableKinds"
                                            ContentAlignment="Vertical"
                                            HorizontalContentAlignment="Left"
                                            IsEnabled="{x:Bind ViewModel.HyperlinkClickable, Mode=OneWay}">
                            <ItemsControl ItemTemplate="{StaticResource ButtonChoiceTemplate}"
                                          ItemsSource="{x:Bind ViewModel.ClickableKindChoices, Mode=OneWay}" />
                        </local:SettingsCard>

                        <!--
                            The two chords. Each is a modifier plus a mouse gesture plus the
                            action it runs, and the same three ids the card's buttons use are
                            what an action can be - so binding a chord to "Copy link" does
                            exactly what the Copy link button does.
                        -->
                        <local:SettingsCard x:Name="HyperlinkPrimaryClick"
                                            x:Uid="Globals_HyperlinkPrimaryClick"
                                            IsEnabled="{x:Bind ViewModel.HyperlinkClickable, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <ComboBox x:Uid="Globals_HyperlinkClickModifierBox"
                                          AutomationProperties.AccessibilityView="Content"
                                          ItemTemplate="{StaticResource EnumComboBoxTemplate}"
                                          ItemsSource="{x:Bind ViewModel.ClickModifierList, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.CurrentPrimaryClickModifier, Mode=TwoWay}" />
                                <ComboBox x:Uid="Globals_HyperlinkClickGestureBox"
                                          AutomationProperties.AccessibilityView="Content"
                                          ItemTemplate="{StaticResource EnumComboBoxTemplate}"
                                          ItemsSource="{x:Bind ViewModel.ClickGestureList, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.CurrentPrimaryClickGesture, Mode=TwoWay}" />
                                <ComboBox x:Uid="Globals_HyperlinkClickActionBox"
                                          AutomationProperties.AccessibilityView="Content"
                                          ItemTemplate="{StaticResource IntegrationChoiceComboBoxTemplate}"
                                          ItemsSource="{x:Bind ViewModel.ActionChoices, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.CurrentPrimaryAction, Mode=TwoWay}" />
                            </StackPanel>
                        </local:SettingsCard>

                        <local:SettingsCard x:Name="HyperlinkAlternativeClick"
                                            x:Uid="Globals_HyperlinkAlternativeClick"
                                            IsEnabled="{x:Bind ViewModel.HyperlinkClickable, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <ComboBox x:Uid="Globals_HyperlinkClickModifierBox"
                                          AutomationProperties.AccessibilityView="Content"
                                          ItemTemplate="{StaticResource EnumComboBoxTemplate}"
                                          ItemsSource="{x:Bind ViewModel.ClickModifierList, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.CurrentAlternativeClickModifier, Mode=TwoWay}" />
                                <ComboBox x:Uid="Globals_HyperlinkClickGestureBox"
                                          AutomationProperties.AccessibilityView="Content"
                                          ItemTemplate="{StaticResource EnumComboBoxTemplate}"
                                          ItemsSource="{x:Bind ViewModel.ClickGestureList, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.CurrentAlternativeClickGesture, Mode=TwoWay}" />
                                <ComboBox x:Uid="Globals_HyperlinkClickActionBox"
                                          AutomationProperties.AccessibilityView="Content"
                                          ItemTemplate="{StaticResource IntegrationChoiceComboBoxTemplate}"
                                          ItemsSource="{x:Bind ViewModel.ActionChoices, Mode=OneWay}"
                                          SelectedItem="{x:Bind ViewModel.CurrentAlternativeAction, Mode=TwoWay}" />
                            </StackPanel>
                        </local:SettingsCard>
                    </local:SettingsExpander.Items>
                </local:SettingsExpander>

                <!--
                    How the tooltip is shaped: the two delays and the width it may
                    grow to. No master switch - these are three numbers that are
                    only ever tuned together, which is the other reason to group.
                -->
                <local:SettingsExpander x:Name="HyperlinkTooltipSizing"
                                        x:Uid="Globals_HyperlinkTooltipSizing"
                                        IsForkFeature="True">
                    <local:SettingsExpander.Items>
                        <local:SettingsCard x:Name="HyperlinkTooltipShowDelay"
                                            x:Uid="Globals_HyperlinkTooltipShowDelay">
                            <muxc:NumberBox x:Uid="Globals_HyperlinkTooltipShowDelayBox"
                                            LargeChange="100"
                                            Maximum="5000"
                                            Minimum="0"
                                            SmallChange="50"
                                            Style="{StaticResource NumberBoxSettingStyle}"
                                            Value="{x:Bind ViewModel.HyperlinkTooltipShowDelay, Mode=TwoWay}" />
                        </local:SettingsCard>

                        <local:SettingsCard x:Name="HyperlinkTooltipHideDelay"
                                            x:Uid="Globals_HyperlinkTooltipHideDelay">
                            <muxc:NumberBox x:Uid="Globals_HyperlinkTooltipHideDelayBox"
                                            LargeChange="100"
                                            Maximum="5000"
                                            Minimum="0"
                                            SmallChange="50"
                                            Style="{StaticResource NumberBoxSettingStyle}"
                                            Value="{x:Bind ViewModel.HyperlinkTooltipHideDelay, Mode=TwoWay}" />
                        </local:SettingsCard>

                        <local:SettingsCard x:Name="HyperlinkTooltipMaxWidth"
                                            x:Uid="Globals_HyperlinkTooltipMaxWidth">
                            <muxc:NumberBox x:Uid="Globals_HyperlinkTooltipMaxWidthBox"
                                            LargeChange="100"
                                            Maximum="4000"
                                            Minimum="0"
                                            SmallChange="20"
                                            Style="{StaticResource NumberBoxSettingStyle}"
                                            Value="{x:Bind ViewModel.HyperlinkTooltipMaxWidth, Mode=TwoWay}" />
                        </local:SettingsCard>

                        <local:SettingsCard x:Name="HyperlinkTooltipMaxHeight"
                                            x:Uid="Globals_HyperlinkTooltipMaxHeight">
                            <muxc:NumberBox x:Uid="Globals_HyperlinkTooltipMaxHeightBox"
                                            LargeChange="100"
                                            Maximum="4000"
                                            Minimum="0"
                                            SmallChange="20"
                                            Style="{StaticResource NumberBoxSettingStyle}"
                                            Value="{x:Bind ViewModel.HyperlinkTooltipMaxHeight, Mode=TwoWay}" />
                        </local:SettingsCard>

                    </local:SettingsExpander.Items>
                </local:SettingsExpander>

                <local:SettingsCard x:Name="HyperlinkTooltipNested" x:Uid="Globals_HyperlinkTooltipNested">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.HyperlinkTooltipNested, Mode=TwoWay}" />
                </local:SettingsCard>

                <!--
                    The button row: the switch is the group's header, and what the
                    row carries and which end of the card it sits on are inside.
                    The integration logo is deliberately NOT in here - it is drawn
                    whether or not there are buttons, so gating it on this switch
                    would grey out a setting that still applies.
                -->
                <local:SettingsExpander x:Name="HyperlinkTooltipActions"
                                        x:Uid="Globals_HyperlinkTooltipActions"
                                        IsForkFeature="True">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.HyperlinkTooltipActions, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                    <local:SettingsExpander.Items>
                        <local:SettingsCard x:Name="HyperlinkTooltipButtons"
                                            x:Uid="Globals_HyperlinkTooltipButtons"
                                            ContentAlignment="Vertical"
                                            HorizontalContentAlignment="Left"
                                            IsEnabled="{x:Bind ViewModel.HyperlinkTooltipActions, Mode=OneWay}">
                            <ItemsControl ItemTemplate="{StaticResource ButtonChoiceTemplate}"
                                          ItemsSource="{x:Bind ViewModel.ButtonChoices, Mode=OneWay}" />
                        </local:SettingsCard>

                        <local:SettingsCard x:Name="HyperlinkActionPlacement"
                                            x:Uid="Globals_HyperlinkActionPlacement"
                                            IsEnabled="{x:Bind ViewModel.HyperlinkTooltipActions, Mode=OneWay}">
                            <ComboBox AutomationProperties.AccessibilityView="Content"
                                      ItemTemplate="{StaticResource EnumComboBoxTemplate}"
                                      ItemsSource="{x:Bind ViewModel.ActionPlacementList, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.CurrentActionPlacement, Mode=TwoWay}"
                                      Style="{StaticResource ComboBoxSettingStyle}" />
                        </local:SettingsCard>
                    </local:SettingsExpander.Items>
                </local:SettingsExpander>

                <local:SettingsCard x:Name="HyperlinkIntegrationDisplayMode"
                                    x:Uid="Globals_HyperlinkIntegrationDisplayMode">
                    <ComboBox AutomationProperties.AccessibilityView="Content"
                              ItemTemplate="{StaticResource EnumComboBoxTemplate}"
                              ItemsSource="{x:Bind ViewModel.IntegrationDisplayModeList, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.CurrentIntegrationDisplayMode, Mode=TwoWay}"
                              Style="{StaticResource ComboBoxSettingStyle}" />
                </local:SettingsCard>

                <local:SettingsCard x:Name="HyperlinkTooltipHint"
                                    x:Uid="Globals_HyperlinkTooltipHint">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.HyperlinkTooltipHint, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                </local:SettingsCard>

                <!--
                    Off by default: this is a diagnostic, and the answer it gives is
                    most useful when a rule is not doing what you expected. Not under
                    the button-row switch above, because it is not one of the buttons
                    and stays useful with the whole row turned off.
                -->
                <local:SettingsCard x:Name="HyperlinkTooltipShowRule"
                                    x:Uid="Globals_HyperlinkTooltipShowRule"
                                    IsForkFeature="True">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.HyperlinkTooltipShowRule, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                </local:SettingsCard>

                <!--
                    Which surface a hover uses, not which buttons it carries: on,
                    hovering opens the detail pane instead of the tooltip card.
                    Independent of the "Show in pane" button in the list above.
                -->
                <local:SettingsCard x:Name="HyperlinkPreviewInPane"
                                    x:Uid="Globals_HyperlinkPreviewInPane">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.HyperlinkPreviewInPane, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                </local:SettingsCard>

                <!--
                    Off by default: each hover of such a path starts wsl.exe and asks
                    shefrd to read the file over the SSH connection it already holds.
                -->
                <local:SettingsCard x:Name="HyperlinkRemoteFilePreviews"
                                    x:Uid="Globals_HyperlinkRemoteFilePreviews"
                                    IsForkFeature="True">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.HyperlinkRemoteFilePreviews, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                </local:SettingsCard>

                <local:SettingsCard x:Name="SafeUriSchemes"
                                    x:Uid="Globals_SafeUriSchemes">
                    <TextBox IsSpellCheckEnabled="False"
                             Style="{StaticResource TextBoxSettingStyle}"
                             Text="{x:Bind ViewModel.SafeUriSchemes, Mode=TwoWay}" />
                </local:SettingsCard>
            </StackPanel>

            <!--  Rules: grouped expandable sections by platform.  -->
            <StackPanel Spacing="2"
                        Style="{StaticResource SettingsStackStyle}">
                <TextBlock x:Uid="LinkTooltip_RulesHeader"
                           Style="{StaticResource TextBlockSubHeaderStyle}" />

                <!--
                    Expand/collapse all sit beside Add rule rather than in the list,
                    so they are reachable without first scrolling through the groups
                    they collapse. They are grouped-view only: the manual-order view
                    is one flat list with nothing to expand.
                -->
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <muxc:SplitButton x:Name="AddRuleButton"
                                      Click="AddRuleButton_Click">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <FontIcon FontSize="{StaticResource StandardIconSize}"
                                      Glyph="&#xE710;" />
                            <TextBlock x:Uid="LinkTooltip_AddRuleButtonText" />
                        </StackPanel>
                        <muxc:SplitButton.Flyout>
                            <Flyout Opening="AddRuleFlyout_Opening"
                                        Placement="BottomEdgeAlignedLeft" />
                        </muxc:SplitButton.Flyout>
                    </muxc:SplitButton>

                    <Button x:Uid="LinkTooltip_ExpandAllRuleGroups"
                            Click="ExpandAllRuleGroups_Click"
                            Visibility="{x:Bind ViewModel.IsAutomaticRuleOrder, Mode=OneWay}" />
                    <Button x:Uid="LinkTooltip_CollapseAllRuleGroups"
                            Click="CollapseAllRuleGroups_Click"
                            Visibility="{x:Bind ViewModel.IsAutomaticRuleOrder, Mode=OneWay}" />
                </StackPanel>

                <!--
                    Order is precedence: the first enabled rule that matches a link
                    wins outright. Off, the list is grouped and sorted so what you
                    see is that order; on, you arrange it yourself by dragging.
                -->
                <local:SettingsCard x:Name="HyperlinkManualRuleOrder"
                                    x:Uid="Globals_HyperlinkManualRuleOrder">
                    <ToggleSwitch IsOn="{x:Bind ViewModel.HyperlinkManualRuleOrder, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                </local:SettingsCard>

                <!--
                    Manual order: one flat list, top to bottom = priority.
                    AllowDrop/CanDragItems/CanReorderItems is the whole gesture -
                    ListViewBase runs the drag and draws the insertion line itself,
                    and mutates CurrentView in place. It must be bound to
                    CurrentView and not to a group's Rules: that one is a snapshot
                    nothing observes, so a drop into it would be a dead write.
                -->
                <StackPanel Visibility="{x:Bind ViewModel.HyperlinkManualRuleOrder, Mode=OneWay}">
                    <TextBlock x:Uid="LinkTooltip_RuleOrderHint"
                               Margin="0,4,0,0"
                               Style="{StaticResource DisclaimerStyle}" />
                    <ListView AllowDrop="True"
                              CanDragItems="True"
                              CanReorderItems="True"
                              ItemTemplate="{StaticResource DraggableRuleRowTemplate}"
                              ItemsSource="{x:Bind ViewModel.CurrentView, Mode=OneWay}"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </StackPanel>

                <ItemsControl ItemsSource="{x:Bind ViewModel.RuleGroups, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsAutomaticRuleOrder, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:RuleGroupViewModel">
                            <muxc:Expander Margin="0,4,0,0"
                                           HorizontalAlignment="Stretch"
                                           HorizontalContentAlignment="Stretch"
                                           IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                                <muxc:Expander.Header>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0"
                                                  Margin="0,0,12,0"
                                                  FontSize="{StaticResource StandardIconSize}"
                                                  Glyph="{x:Bind PlatformIcon}" />
                                        <TextBlock Grid.Column="1"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"
                                                   Text="{x:Bind PlatformName}" />
                                        <Border Grid.Column="2"
                                                Margin="0,0,12,0"
                                                Padding="8,2,8,2"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10">
                                            <TextBlock FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{x:Bind CountBadge, Mode=OneWay}" />
                                        </Border>
                                        <ToggleSwitch Grid.Column="3"
                                                      VerticalAlignment="Center"
                                                      IsOn="{x:Bind IsEnabled, Mode=TwoWay}"
                                                      OffContent=""
                                                      OnContent=""
                                                      Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                                    </Grid>
                                </muxc:Expander.Header>
                                <ItemsControl ItemTemplate="{StaticResource RuleRowTemplate}"
                                              ItemsSource="{x:Bind Rules, Mode=OneWay}" />
                            </muxc:Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!--
            One rule, as a nested full-viewport view. MainPage watches
            ViewModel.CurrentRule and shows "Link Tooltip > <rule>" in the
            breadcrumb; clicking the first crumb comes back here.
        -->
        <StackPanel Spacing="2"
                    Style="{StaticResource SettingsStackStyle}"
                    Visibility="{x:Bind ViewModel.IsEditingRule, Mode=OneWay}">

            <TextBlock Style="{StaticResource TextBlockSubHeaderStyle}"
                       Text="{x:Bind ViewModel.CurrentRuleName, Mode=OneWay}" />

            <!--
                Live Preview of Match. The sample line is editable and the rest of
                the card is what this rule actually finds in it - the run it would
                match, highlighted where it sits, and the named captures the
                preview pipeline reads back from it. It used to show the rule's own
                summary, which is the same regex the Pattern field two rows below
                already shows, so it demonstrated nothing.
            -->
            <Border Margin="0,4,0,8"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="14" Glyph="&#xE8B9;" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock Text="Rule Preview" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>

                    <TextBox FontFamily="Cascadia Code, Consolas"
                             FontSize="12"
                             IsSpellCheckEnabled="False"
                             PlaceholderText="Paste a line of output or a link to test this rule against"
                             Text="{x:Bind ViewModel.CurrentRule.PreviewSample, Mode=TwoWay}" />

                    <!--
                        The match, highlighted where it sits. Three TextBlocks in a
                        panel rather than three Runs in a paragraph: XAML collapses
                        the whitespace between inline elements into a real space, so
                        a run-based version would show a sample the rule never saw.
                        (The Preview Appearance card above has exactly that seam in
                        its mock URL.) A panel's children carry no such whitespace,
                        and a Run cannot take a background either way.
                    -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalScrollMode="Disabled"
                                  Visibility="{x:Bind ViewModel.CurrentRule.HasPreviewMatch, Mode=OneWay}">
                        <StackPanel VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock FontFamily="Cascadia Code, Consolas"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.CurrentRule.PreviewBefore, Mode=OneWay}" />
                            <Border Padding="3,1,3,1"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="3">
                                <TextBlock FontFamily="Cascadia Code, Consolas"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                           Text="{x:Bind ViewModel.CurrentRule.PreviewMatch, Mode=OneWay}" />
                            </Border>
                            <TextBlock FontFamily="Cascadia Code, Consolas"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="{x:Bind ViewModel.CurrentRule.PreviewAfter, Mode=OneWay}" />
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock FontFamily="Cascadia Code, Consolas"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.CurrentRule.PreviewCaptures, Mode=OneWay}"
                               TextWrapping="Wrap"
                               Visibility="{x:Bind ViewModel.CurrentRule.HasPreviewCaptures, Mode=OneWay}" />

                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.CurrentRule.PreviewStatus, Mode=OneWay}"
                               TextWrapping="Wrap" />

                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="{x:Bind ViewModel.CurrentRule.SummaryText, Mode=OneWay}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Button Content="Duplicate rule" HorizontalAlignment="Left" Click="DuplicateRule_Click" />

            <!--  Preset  -->
            <local:SettingsCard x:Uid="LinkTooltip_RulePreset">
                <muxc:DropDownButton x:Name="ApplyPresetButton">
                    <muxc:DropDownButton.Content>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <FontIcon FontSize="{StaticResource StandardIconSize}"
                                      Glyph="&#xE8B9;" />
                            <TextBlock x:Uid="LinkTooltip_ApplyPresetButtonText" />
                        </StackPanel>
                    </muxc:DropDownButton.Content>
                    <muxc:DropDownButton.Flyout>
                        <Flyout Opening="ApplyPresetFlyout_Opening"
                                    Placement="BottomEdgeAlignedLeft" />
                    </muxc:DropDownButton.Flyout>
                </muxc:DropDownButton>
            </local:SettingsCard>

            <local:SettingsCard x:Uid="LinkTooltip_RuleName">
                <TextBox x:Uid="LinkTooltip_RuleNameBox"
                         Style="{StaticResource TextBoxSettingStyle}"
                         Text="{x:Bind ViewModel.CurrentRule.Name, Mode=TwoWay}" />
            </local:SettingsCard>

            <local:SettingsCard x:Uid="LinkTooltip_RuleEnabled">
                <ToggleSwitch IsOn="{x:Bind ViewModel.CurrentRule.Enabled, Mode=TwoWay}"
                              Style="{StaticResource ToggleSwitchInExpanderStyle}" />
            </local:SettingsCard>

            <TextBlock x:Uid="LinkTooltip_MatchCriteriaHeader"
                       Style="{StaticResource TextBlockSubHeaderStyle}" />

            <local:SettingsCard x:Uid="LinkTooltip_RuleKind">
                <ComboBox AutomationProperties.AccessibilityView="Content"
                          ItemTemplate="{StaticResource EnumComboBoxTemplate}"
                          ItemsSource="{x:Bind ViewModel.KindList, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.CurrentRule.CurrentKind, Mode=TwoWay}"
                          Style="{StaticResource ComboBoxSettingStyle}" />
            </local:SettingsCard>

            <local:SettingsCard x:Uid="LinkTooltip_RuleSchemes"
                                Visibility="{x:Bind ViewModel.CurrentRule.IsLinkKind, Mode=OneWay}">
                <TextBox IsSpellCheckEnabled="False"
                         Style="{StaticResource TextBoxSettingStyle}"
                         Text="{x:Bind ViewModel.CurrentRule.Schemes, Mode=TwoWay}" />
            </local:SettingsCard>

            <local:SettingsCard x:Uid="LinkTooltip_RulePattern">
                <TextBox IsSpellCheckEnabled="False"
                         Style="{StaticResource TextBoxSettingStyle}"
                         Text="{x:Bind ViewModel.CurrentRule.Pattern, Mode=TwoWay}" />
            </local:SettingsCard>

            <TextBlock x:Uid="LinkTooltip_RuleTextPatternHint"
                       Style="{StaticResource RulePatternHintStyle}"
                       Visibility="{x:Bind ViewModel.CurrentRule.IsTextKind, Mode=OneWay}" />

            <local:SettingsCard x:Uid="LinkTooltip_RuleFileTypeGroup"
                                Visibility="{x:Bind ViewModel.CurrentRule.IsLinkKind, Mode=OneWay}">
                <ComboBox AutomationProperties.AccessibilityView="Content"
                          ItemTemplate="{StaticResource EnumComboBoxTemplate}"
                          ItemsSource="{x:Bind ViewModel.FileTypeGroupList, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.CurrentRule.CurrentFileTypeGroup, Mode=TwoWay}"
                          Style="{StaticResource ComboBoxSettingStyle}" />
            </local:SettingsCard>

            <local:SettingsCard x:Uid="LinkTooltip_RuleCustomExtensions"
                                Visibility="{x:Bind ViewModel.CurrentRule.IsLinkKind, Mode=OneWay}">
                <TextBox IsSpellCheckEnabled="False"
                         Style="{StaticResource TextBoxSettingStyle}"
                         Text="{x:Bind ViewModel.CurrentRule.CustomExtensions, Mode=TwoWay}" />
            </local:SettingsCard>

            <TextBlock x:Uid="LinkTooltip_PreviewHeader"
                       Style="{StaticResource TextBlockSubHeaderStyle}" />

            <local:SettingsCard x:Uid="LinkTooltip_RuleIntegration">
                <ComboBox AutomationProperties.AccessibilityView="Content"
                          ItemTemplate="{StaticResource IntegrationChoiceComboBoxTemplate}"
                          ItemsSource="{x:Bind ViewModel.IntegrationChoices, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.CurrentRule.CurrentIntegrationChoice, Mode=TwoWay}"
                          Style="{StaticResource ComboBoxSettingStyle}" />
            </local:SettingsCard>

            <local:SettingsCard x:Uid="LinkTooltip_RuleShowPreview">
                <ToggleSwitch IsOn="{x:Bind ViewModel.CurrentRule.ShowPreview, Mode=TwoWay}"
                              Style="{StaticResource ToggleSwitchInExpanderStyle}" />
            </local:SettingsCard>

            <!--
                Four settings a rule can take off the defaults, collapsed by
                default because most rules override none of them - the checkbox
                in each row is the override, so a closed group reads as "this
                rule inherits everything".
            -->
            <local:SettingsExpander x:Name="RuleOverrides"
                                    x:Uid="LinkTooltip_RuleOverrides"
                                    IsForkFeature="True">
                <local:SettingsExpander.Items>
                    <local:SettingsCard x:Name="RuleOverrideShowDelay"
                                        x:Uid="LinkTooltip_OverrideShowDelay">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <CheckBox IsChecked="{x:Bind ViewModel.CurrentRule.OverrideShowDelay, Mode=TwoWay}" />
                            <muxc:NumberBox LargeChange="100"
                                            Maximum="5000"
                                            Minimum="0"
                                            SmallChange="50"
                                            IsEnabled="{x:Bind ViewModel.CurrentRule.OverrideShowDelay, Mode=OneWay}"
                                            Style="{StaticResource NumberBoxSettingStyle}"
                                            Value="{x:Bind ViewModel.CurrentRule.ShowDelay, Mode=TwoWay}" />
                        </StackPanel>
                    </local:SettingsCard>

                    <local:SettingsCard x:Name="RuleOverrideHideDelay"
                                        x:Uid="LinkTooltip_OverrideHideDelay">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <CheckBox IsChecked="{x:Bind ViewModel.CurrentRule.OverrideHideDelay, Mode=TwoWay}" />
                            <muxc:NumberBox LargeChange="100"
                                            Maximum="5000"
                                            Minimum="0"
                                            SmallChange="50"
                                            IsEnabled="{x:Bind ViewModel.CurrentRule.OverrideHideDelay, Mode=OneWay}"
                                            Style="{StaticResource NumberBoxSettingStyle}"
                                            Value="{x:Bind ViewModel.CurrentRule.HideDelay, Mode=TwoWay}" />
                        </StackPanel>
                    </local:SettingsCard>

                    <local:SettingsCard x:Name="RuleOverrideMaxWidth"
                                        x:Uid="LinkTooltip_OverrideMaxWidth">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <CheckBox IsChecked="{x:Bind ViewModel.CurrentRule.OverrideMaxWidth, Mode=TwoWay}" />
                            <muxc:NumberBox LargeChange="100"
                                            Maximum="4000"
                                            Minimum="0"
                                            SmallChange="20"
                                            IsEnabled="{x:Bind ViewModel.CurrentRule.OverrideMaxWidth, Mode=OneWay}"
                                            Style="{StaticResource NumberBoxSettingStyle}"
                                            Value="{x:Bind ViewModel.CurrentRule.MaxWidth, Mode=TwoWay}" />
                        </StackPanel>
                    </local:SettingsCard>

                    <!--
                        Which surface a hover uses for links this rule matches. Nothing
                        to do with the "Show in pane" button below, which this rule can
                        also add or remove; the two are independent.
                    -->
                    <local:SettingsCard x:Name="RuleShowInPane"
                                        x:Uid="LinkTooltip_RuleShowInPane">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <CheckBox IsChecked="{x:Bind ViewModel.CurrentRule.OverrideShowInPane, Mode=TwoWay}" />
                            <ToggleSwitch IsEnabled="{x:Bind ViewModel.CurrentRule.OverrideShowInPane, Mode=OneWay}"
                                          IsOn="{x:Bind ViewModel.CurrentRule.ShowInPane, Mode=TwoWay}"
                                          Style="{StaticResource ToggleSwitchInExpanderStyle}" />
                        </StackPanel>
                    </local:SettingsCard>
                </local:SettingsExpander.Items>
            </local:SettingsExpander>

            <TextBlock x:Uid="LinkTooltip_BuiltInButtonsHeader"
                       Style="{StaticResource TextBlockSubHeaderStyle}" />

            <local:SettingsCard x:Uid="LinkTooltip_RuleButtons"
                                ContentAlignment="Vertical"
                                HorizontalContentAlignment="Left">
                <StackPanel Spacing="4">
                    <CheckBox x:Uid="LinkTooltip_RuleOverrideButtons"
                              IsChecked="{x:Bind ViewModel.CurrentRule.OverrideButtons, Mode=TwoWay}" />
                    <ItemsControl Margin="24,0,0,0"
                                  IsEnabled="{x:Bind ViewModel.CurrentRule.OverrideButtons, Mode=OneWay}"
                                  ItemTemplate="{StaticResource ButtonChoiceTemplate}"
                                  ItemsSource="{x:Bind ViewModel.CurrentRule.ButtonChoices, Mode=OneWay}" />
                </StackPanel>
            </local:SettingsCard>

            <!--
                What clicking a link this rule matches does. The chords themselves
                stay global - only which action each one runs is per-rule, so
                "Inherit" means "whatever the two chords above are set to".
            -->
            <TextBlock x:Uid="LinkTooltip_ClickActionsHeader"
                       Style="{StaticResource TextBlockSubHeaderStyle}" />

            <!--
                ItemsSource is the page's list, not the rule's, exactly like the
                Match kind and Integration pickers above. A per-rule collection here
                meant every rule switch handed these two boxes a different
                ItemsSource while they still held the previous rule's selection,
                which throws - and that throw was swallowed inside the binding
                update, taking every field below it with it and leaving the editor
                blank. One shared list also guarantees the item a rule selects is
                an item of the collection the box is showing.
            -->
            <local:SettingsCard x:Uid="LinkTooltip_RulePrimaryAction">
                <ComboBox AutomationProperties.AccessibilityView="Content"
                          ItemTemplate="{StaticResource IntegrationChoiceComboBoxTemplate}"
                          ItemsSource="{x:Bind ViewModel.RuleActionChoices, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.CurrentRule.CurrentPrimaryAction, Mode=TwoWay}"
                          Style="{StaticResource ComboBoxSettingStyle}" />
            </local:SettingsCard>

            <local:SettingsCard x:Uid="LinkTooltip_RuleAlternativeAction">
                <ComboBox AutomationProperties.AccessibilityView="Content"
                          ItemTemplate="{StaticResource IntegrationChoiceComboBoxTemplate}"
                          ItemsSource="{x:Bind ViewModel.RuleActionChoices, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.CurrentRule.CurrentAlternativeAction, Mode=TwoWay}"
                          Style="{StaticResource ComboBoxSettingStyle}" />
            </local:SettingsCard>

            <TextBlock x:Uid="LinkTooltip_CustomActionsHeader"
                       Style="{StaticResource TextBlockSubHeaderStyle}" />

            <Button Click="AddCustomActionButton_Click">
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <FontIcon FontSize="{StaticResource StandardIconSize}"
                              Glyph="&#xE710;" />
                    <TextBlock x:Uid="LinkTooltip_AddCustomActionButtonText" />
                </StackPanel>
            </Button>

            <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentRule.CustomActions, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:HyperlinkTooltipActionViewModel">
                        <Border Margin="0,4"
                                Padding="12"
                                BorderBrush="{ThemeResource FlyoutBorderThemeBrush}"
                                BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Uid="LinkTooltip_CustomActionNameBox"
                                             Grid.Column="0"
                                             Text="{x:Bind Name, Mode=TwoWay}" />
                                    <TextBox x:Uid="LinkTooltip_CustomActionIdBox"
                                             Grid.Column="1"
                                             Text="{x:Bind ActionId, Mode=TwoWay}" />
                                    <Button x:Uid="LinkTooltip_DeleteCustomActionButton"
                                            Grid.Column="2"
                                            Click="DeleteCustomAction_Click"
                                            Tag="{x:Bind}">
                                        <FontIcon FontSize="{StaticResource StandardIconSize}"
                                                  Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                                <local:IconPicker CurrentIconPath="{x:Bind Icon, Mode=TwoWay}"
                                                  Loaded="CustomActionIconPicker_Loaded" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</Page>
