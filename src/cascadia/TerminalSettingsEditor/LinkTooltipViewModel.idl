import "EnumEntry.idl";

#include "ViewModelHelpers.idl.h"

namespace Microsoft.Terminal.Settings.Editor
{
    [default_interface] runtimeclass HyperlinkTooltipActionViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        HyperlinkTooltipActionViewModel(Microsoft.Terminal.Settings.Model.HyperlinkTooltipAction action);

        String Name;
        String ActionId;
        String Icon;
    }

    // One entry in a rule's "Integration" picker: an integration id (or "" for
    // automatic, "none" for no preview) paired with what to show for it.
    [default_interface] runtimeclass IntegrationChoiceViewModel
    {
        String Id { get; };
        String DisplayName { get; };
    }

    // One of the five built-in buttons a hyperlink card can carry. Selected
    // reads and writes the id list it belongs to -- the global default list or
    // one rule's override -- so there is no second copy of the state to keep in
    // sync, and the list is always rewritten in the order the card draws them.
    [default_interface] runtimeclass ButtonChoiceViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        String Id { get; };
        String Label { get; };
        Boolean Selected;
    }

    [default_interface] runtimeclass HyperlinkTooltipRuleViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        // The window settings come along because a rule's overrides are shown
        // against what they inherit: ticking "override buttons" starts from the
        // global list rather than from nothing.
        HyperlinkTooltipRuleViewModel(Microsoft.Terminal.Settings.Model.HyperlinkTooltipRule rule,
                                      Microsoft.Terminal.Settings.Model.WindowSettings windowSettings);

        String Name;
        String DisplayName { get; };
        Boolean Enabled;
        String SummaryText { get; };

        // The preview card at the top of the rule editor: a line of sample text
        // and what this rule actually picks out of it, split into the run before
        // the match, the match itself, and the run after it so the card can
        // highlight it. None of this is saved -- it is a live test of the pattern.
        String PreviewSample;
        String PreviewStatus { get; };
        Boolean HasPreviewMatch { get; };
        String PreviewBefore { get; };
        String PreviewMatch { get; };
        String PreviewAfter { get; };
        // "key = PROJ-1234 - number = 18920", or empty when the pattern has no
        // named groups (or did not match).
        String PreviewCaptures { get; };
        Boolean HasPreviewCaptures { get; };

        // Link rules match hovered links; text rules match plain terminal output.
        IInspectable CurrentKind;
        Windows.Foundation.Collections.IObservableVector<EnumEntry> KindList { get; };
        Boolean IsLinkKind { get; };
        Boolean IsTextKind { get; };

        // Comma-separated, same convention as LinkTooltipViewModel.SafeUriSchemes.
        String Schemes;
        String Pattern;

        IInspectable CurrentFileTypeGroup;
        Windows.Foundation.Collections.IObservableVector<EnumEntry> FileTypeGroupList { get; };
        String CustomExtensions;

        // Which integration previews matches: "" = pick automatically,
        // "none" = no preview, else an integration id.
        String Integration;
        Windows.Foundation.Collections.IVector<IntegrationChoiceViewModel> IntegrationChoices { get; };
        // IInspectable rather than IntegrationChoiceViewModel, so the two-way
        // ComboBox binding matches how CurrentFileTypeGroup already works.
        IInspectable CurrentIntegrationChoice;
        Boolean ShowPreview;

        // Each override pairs a bool (is this field overridden at all) with the value to
        // use when it is -- unlike a plain nullable NumberBox binding, this keeps the last
        // value around when the override checkbox is unchecked and rechecked.
        Boolean OverrideShowDelay;
        Int32 ShowDelay;
        Boolean OverrideHideDelay;
        Int32 HideDelay;
        Boolean OverrideMaxWidth;
        Int32 MaxWidth;

        // Which built-in buttons this rule's card carries. An empty list on the
        // rule inherits the global list, so the checkboxes are only live once
        // OverrideButtons is on.
        Boolean OverrideButtons;
        Windows.Foundation.Collections.IObservableVector<ButtonChoiceViewModel> ButtonChoices { get; };

        // Same nullable-override shape as OverrideShowDelay/ShowDelay above.
        Boolean OverrideShowInPane;
        Boolean ShowInPane;

        // What each click chord does for links this rule matches. The choice list
        // carries an "inherit" entry ("") and a "none" entry alongside the action
        // ids, so a rule can defer to the global setting or suppress the click.
        Windows.Foundation.Collections.IVector<IntegrationChoiceViewModel> ActionChoices { get; };
        IInspectable CurrentPrimaryAction;
        IInspectable CurrentAlternativeAction;

        Windows.Foundation.Collections.IObservableVector<HyperlinkTooltipActionViewModel> CustomActions { get; };
        HyperlinkTooltipActionViewModel RequestAddCustomAction();
        void RequestDeleteCustomAction(HyperlinkTooltipActionViewModel vm);
        void ApplyPreset(String presetId);
    }

    [default_interface] runtimeclass RuleGroupViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        String PlatformId { get; };
        String PlatformName { get; };
        String PlatformIcon { get; };
        String CountBadge { get; };
        Boolean IsEnabled;
        Boolean IsExpanded;
        Windows.Foundation.Collections.IObservableVector<HyperlinkTooltipRuleViewModel> Rules { get; };
    }

    runtimeclass LinkTooltipViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged
    {
        LinkTooltipViewModel(Microsoft.Terminal.Settings.Model.GlobalAppSettings globalSettings, Microsoft.Terminal.Settings.Model.WindowSettings windowSettings);

        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, DetectURLs);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, HyperlinkClickable);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, HyperlinkManualRuleOrder);
        // The grouped view's Visibility, since XAML cannot negate a binding.
        Boolean IsAutomaticRuleOrder { get; };
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Int32, HyperlinkTooltipMaxWidth);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Int32, HyperlinkTooltipMaxHeight);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, HyperlinkTooltipNested);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Int32, HyperlinkTooltipShowDelay);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Int32, HyperlinkTooltipHideDelay);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, HyperlinkTooltipActions);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, HyperlinkTooltipHint);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, HyperlinkTooltipShowRule);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, HyperlinkPreviewInPane);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Boolean, HyperlinkRemoteFilePreviews);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Microsoft.Terminal.Settings.Model.HyperlinkIntegrationDisplayMode, HyperlinkIntegrationDisplayMode);
        PERMANENT_OBSERVABLE_PROJECTED_SETTING(Microsoft.Terminal.Settings.Model.HyperlinkActionPlacement, HyperlinkActionPlacement);

        IInspectable CurrentIntegrationDisplayMode;
        Windows.Foundation.Collections.IObservableVector<EnumEntry> IntegrationDisplayModeList { get; };

        IInspectable CurrentActionPlacement;
        Windows.Foundation.Collections.IObservableVector<EnumEntry> ActionPlacementList { get; };

        // Which kinds of link a click activates: detected URLs, rule matches,
        // and links the program marked itself.
        Windows.Foundation.Collections.IObservableVector<ButtonChoiceViewModel> ClickableKindChoices { get; };

        // The two click chords. Both modifier pickers share one list of entries,
        // and both gesture pickers share the other -- an EnumEntry is immutable,
        // so a ComboBox's own SelectedItem is the only per-picker state.
        Windows.Foundation.Collections.IObservableVector<EnumEntry> ClickModifierList { get; };
        Windows.Foundation.Collections.IObservableVector<EnumEntry> ClickGestureList { get; };
        IInspectable CurrentPrimaryClickModifier;
        IInspectable CurrentPrimaryClickGesture;
        IInspectable CurrentAlternativeClickModifier;
        IInspectable CurrentAlternativeClickGesture;

        // What each chord runs. The ids are the card's own button ids plus
        // "none", so a chord and a button can be bound to the same thing.
        Windows.Foundation.Collections.IObservableVector<IntegrationChoiceViewModel> ActionChoices { get; };
        // The per-rule variant of the list above, carrying an extra leading
        // "inherit" entry. One list shared by every rule, so switching rules never
        // swaps the ItemsSource out from under a ComboBox that still has a
        // selection -- which is what silently broke the whole editor.
        Windows.Foundation.Collections.IObservableVector<IntegrationChoiceViewModel> RuleActionChoices { get; };
        IInspectable CurrentPrimaryAction;
        IInspectable CurrentAlternativeAction;

        String SafeUriSchemes;

        // The global button list every rule inherits unless it overrides it.
        Windows.Foundation.Collections.IObservableVector<ButtonChoiceViewModel> ButtonChoices { get; };

        Windows.Foundation.Collections.IObservableVector<EnumEntry> KindList { get; };
        Windows.Foundation.Collections.IObservableVector<EnumEntry> FileTypeGroupList { get; };
        Windows.Foundation.Collections.IObservableVector<IntegrationChoiceViewModel> IntegrationChoices { get; };

        Windows.Foundation.Collections.IObservableVector<HyperlinkTooltipRuleViewModel> CurrentView { get; };
        Windows.Foundation.Collections.IObservableVector<RuleGroupViewModel> RuleGroups { get; };
        HyperlinkTooltipRuleViewModel CurrentRule;
        Boolean IsEditingRule { get; };
        Boolean IsNotEditingRule { get; };
        // The name of the rule being edited, so the breadcrumb can follow a rename.
        String CurrentRuleName { get; };

        void RequestDeleteRule(HyperlinkTooltipRuleViewModel vm);
        HyperlinkTooltipRuleViewModel RequestAddRule();
        HyperlinkTooltipRuleViewModel RequestDuplicateRule(HyperlinkTooltipRuleViewModel source);
        HyperlinkTooltipRuleViewModel RequestAddRuleWithPreset(String presetId);
        // True when a rule matching this preset is already in the list, so the
        // Add rule menu can grey the entry out rather than make a duplicate.
        Boolean IsPresetInUse(String presetId);
        // The same test, ignoring the rule currently open, for the Apply preset
        // menu: re-applying the preset a rule already is must stay available.
        Boolean IsPresetInUseElsewhere(String presetId);
        // Opens one rule, given what the link tooltip knew about it: its position
        // in the list, and the name it had at the time. Returns false when neither
        // finds anything, so the caller can leave the user on the list rather than
        // on some unrelated rule. See the implementation for why it is both.
        Boolean SelectRule(Int32 ruleIndex, String ruleName);
        void ExpandAllRuleGroups();
        void CollapseAllRuleGroups();
    }
}
