#include "IInheritable.idl.h"

import "Theme.idl";
import "ColorScheme.idl";
import "ActionMap.idl";
import "NewTabMenuEntry.idl";
import "HyperlinkTooltipRule.idl";
import "Integrations.idl";

namespace Microsoft.Terminal.Settings.Model
{
    // MIDL 3 allows for structs to hold nullable types
    // Though IReference is a WinRT object, MIDL 3
    // handles all of the ownership logic for us.
    // Docs: https://docs.microsoft.com/en-us/uwp/midl-3/intro#types
    struct LaunchPosition
    {
        Windows.Foundation.IReference<Int32> X;
        Windows.Foundation.IReference<Int32> Y;
    };

    [flags]
    enum LaunchMode
    {
        DefaultMode = 0,
        MaximizedMode = 1,
        FullscreenMode = 2,
        FocusMode = 4,
        MaximizedFocusMode = 5
    };

    enum WindowingMode
    {
        UseNew,
        UseAnyExisting,
        UseExisting,
    };

    enum FirstWindowPreference
    {
        DefaultProfile,
        PersistedLayout,
        PersistedLayoutAndContent,
    };

    enum NewTabPosition
    {
        AfterLastTab,
        AfterCurrentTab,
    };

    // Which screen edge the window is pinned to, filling that edge and taking
    // dockSize percent of the screen in the perpendicular direction. Quake mode
    // is this same mechanism fixed at Top and 50%, and still overrides it.
    enum WindowDock
    {
        Off,
        Top,
        Bottom,
        Left,
        Right,
    };

    // Which edge of the window the tab strip sits on. Top is the shipped
    // behavior; Left and Right turn the strip into a vertical sidebar.
    //
    // This is a window setting rather than a theme one, even though it is
    // visually a chrome decision and sits beside useMica and frame in spirit.
    // Themes cannot hold it: CascadiaSettings::ToJson deliberately skips the
    // built-in themes when writing user settings back out, so a value stored on
    // "dark", "light" or "system" - which is to say, on the default - would
    // apply for the session and then vanish on the next reload.
    enum TabPosition
    {
        Top,
        Bottom,
        Left,
        Right,
    };

    // Where the new tab button sits in a vertical tab strip. Bottom keeps it
    // pinned to the foot of the column, which is where it has always been;
    // AfterTabs puts it directly under the last tab, the way Tabby does it, so
    // it does not travel as the tab count changes. No effect on Top or Bottom
    // strips, where the button is beside the tabs either way.
    enum NewTabButtonPosition
    {
        Bottom,
        AfterTabs,
    };

    // Where the Settings UI opens: beside the terminals as a tab, over the
    // window as a modal dialog, or in a window of its own. The window is an
    // ordinary Terminal window carrying a single startup action, which is what
    // makes it resizable and give it a taskbar entry for free.
    enum SettingsUIHost
    {
        Tab,
        Dialog,
        Window,
    };

    // Whether the app animates, and whether that follows Windows or is decided
    // here. "System" reads Settings > Accessibility > Visual effects >
    // Animation effects, which is the same switch a web page's
    // prefers-reduced-motion reports. The other two override it in either
    // direction, because the OS switch is all-or-nothing for every app on the
    // machine and this one is not.
    enum MotionPreference
    {
        System,  // Follow the Windows animation-effects setting.
        Full,    // Animate, whatever Windows says.
        Reduced, // Do not animate, whatever Windows says.
    };

    // How resuming a recognized agent or multiplexer session announces itself
    // on the next startup that finds one to resume. Independent of which
    // programs are eligible: this only matters once something is.
    enum ResumeSessionNotification
    {
        Silent,  // Resume with no notice at all.
        Toast,   // Resume immediately; show a dismissible notice naming what was resumed.
        Confirm, // Ask first, listing what would be resumed, before resuming anything.
    };

    enum ConfirmOnClose
    {
        Never = 0,
        Automatic = 1,
        Always = 2,
        // Warn only once there are more than confirmOnCloseTabThreshold tabs
        // open. For people who close a two-tab window all day and only want
        // stopping when there is real work in front of them.
        MoreThanTabs = 3,
    };

    [default_interface] runtimeclass GlobalAppSettings {
        // ---- Global-only settings (not per-window) ----
        INHERITABLE_SETTING(String, Language);
        INHERITABLE_SETTING(FirstWindowPreference, FirstWindowPreference);
        INHERITABLE_SETTING(Boolean, DebugFeaturesEnabled);
        INHERITABLE_SETTING(WindowingMode, WindowingBehavior);
        INHERITABLE_SETTING(Boolean, AlwaysShowNotificationIcon);
        INHERITABLE_SETTING(IVector<String>, DisabledProfileSources);
        // INHERITABLE_SETTING spelled out: the comma in the map type would split
        // the macro's arguments.
        Windows.Foundation.Collections.IMap<String, IntegrationSettings> Integrations { get; set; };
        Boolean HasIntegrations { get; };
        void ClearIntegrations();
        INHERITABLE_SETTING(Boolean, AllowHeadless);
        INHERITABLE_SETTING(Boolean, ControlPipeEnabled);
        INHERITABLE_SETTING(Boolean, AylithImprint);
        INHERITABLE_SETTING(Boolean, AylithImprintJsonOnly);
        INHERITABLE_SETTING(Boolean, ActivityLog);
        INHERITABLE_SETTING(Int32, ActivityLogMaxKilobytes);
        INHERITABLE_SETTING(MotionPreference, Motion);
        INHERITABLE_SETTING(Boolean, EnableColorSelection);
        INHERITABLE_SETTING(Int32, CiPollIntervalMinutes);
        INHERITABLE_SETTING(Boolean, ResumeAgents);
        INHERITABLE_SETTING(Boolean, ResumeMultiplexers);
        INHERITABLE_SETTING(IVector<String>, ResumeExtraPrograms);
        INHERITABLE_SETTING(IVector<String>, ResumeExcludedPrograms);
        INHERITABLE_SETTING(Boolean, PersistBufferPeriodically);
        INHERITABLE_SETTING(Int32, BufferPersistIntervalSeconds);
        INHERITABLE_SETTING(ResumeSessionNotification, ResumeSessionNotification);
        INHERITABLE_SETTING(ConfirmOnClose, ConfirmOnClose);
        INHERITABLE_SETTING(Int32, ConfirmOnCloseTabThreshold);

        // ---- Color schemes ----
        Windows.Foundation.Collections.IMapView<String, ColorScheme> ColorSchemes();
        void AddColorScheme(ColorScheme scheme);
        void RemoveColorScheme(String schemeName);
        ColorScheme DuplicateColorScheme(ColorScheme scheme);

        ActionMap ActionMap { get; };

        // ---- Themes ----
        Windows.Foundation.Collections.IMapView<String, Theme> Themes();
        void AddTheme(Theme theme);
        Theme CurrentTheme(WindowSettings window);

        Boolean ShouldUsePersistedLayout();
    }

    [default_interface] runtimeclass WindowSettings
    {
        WindowSettings();

        String Name { get; };
        Guid DefaultProfile;

        INHERITABLE_SETTING(String, UnparsedDefaultProfile);

        INHERITABLE_SETTING(Int32, InitialRows);
        INHERITABLE_SETTING(Int32, InitialCols);
        INHERITABLE_SETTING(Boolean, AlwaysShowTabs);
        INHERITABLE_SETTING(Boolean, ShowTabsFullscreen);
        INHERITABLE_SETTING(NewTabPosition, NewTabPosition);
        INHERITABLE_SETTING(Boolean, ShowTitleInTitlebar);
        INHERITABLE_SETTING(Microsoft.UI.Xaml.Controls.TabViewWidthMode, TabWidthMode);
        INHERITABLE_SETTING(TabPosition, TabPosition);
        INHERITABLE_SETTING(NewTabButtonPosition, NewTabButtonPosition);
        INHERITABLE_SETTING(SettingsUIHost, SettingsUIHost);
        INHERITABLE_SETTING(UInt32, PaneResizeStep);
        INHERITABLE_SETTING(Boolean, CloseWindowOnLastTab);
        INHERITABLE_SETTING(Boolean, ShowTabIndex);

        // Overrides for theme.tab.iconStyle and theme.tab.showCloseButton.
        // Deliberately absent from defaults.json: HasTabIconStyle() is then
        // false until the user actually sets one, which is what lets the theme
        // keep its say. See doc/json-only-settings.md for why the Settings UI
        // cannot write the theme values directly.
        INHERITABLE_SETTING(IconStyle, TabIconStyle);
        INHERITABLE_SETTING(TabCloseButtonVisibility, TabCloseButton);

        INHERITABLE_SETTING(WindowDock, DockWindow);
        INHERITABLE_SETTING(UInt32, DockSize);
        INHERITABLE_SETTING(Boolean, UseAcrylicInTabRow);
        INHERITABLE_SETTING(Boolean, ShowTabsInTitlebar);
        INHERITABLE_SETTING(String, WordDelimiters);
        INHERITABLE_SETTING(Boolean, CopyOnSelect);
        INHERITABLE_SETTING(Microsoft.Terminal.Control.CopyFormat, CopyFormatting);
        INHERITABLE_SETTING(Boolean, WarnAboutLargePaste);
        INHERITABLE_SETTING(Microsoft.Terminal.Control.WarnAboutMultiLinePaste, WarnAboutMultiLinePaste);
        INHERITABLE_SETTING(Boolean, TrimPaste);
        INHERITABLE_SETTING(LaunchPosition, InitialPosition);
        INHERITABLE_SETTING(Boolean, CenterOnLaunch);
        INHERITABLE_SETTING(Boolean, RememberWindowGeometry);
        INHERITABLE_SETTING(Microsoft.Terminal.Control.DefaultInputScope, DefaultInputScope);
        INHERITABLE_SETTING(LaunchMode, LaunchMode);
        INHERITABLE_SETTING(Boolean, SnapToGridOnResize);
        INHERITABLE_SETTING(Microsoft.Terminal.Control.GraphicsAPI, GraphicsAPI);
        INHERITABLE_SETTING(Boolean, DisablePartialInvalidation);
        INHERITABLE_SETTING(Boolean, SoftwareRendering);
        INHERITABLE_SETTING(Microsoft.Terminal.Control.TextMeasurement, TextMeasurement);
        INHERITABLE_SETTING(Microsoft.Terminal.Control.AmbiguousWidth, AmbiguousWidth);
        INHERITABLE_SETTING(Boolean, UseBackgroundImageForWindow);
        INHERITABLE_SETTING(Boolean, AlwaysOnTop);
        INHERITABLE_SETTING(Boolean, AutoHideWindow);
        INHERITABLE_SETTING(TabSwitcherMode, TabSwitcherMode);
        INHERITABLE_SETTING(Boolean, DisableAnimations);
        INHERITABLE_SETTING(String, StartupActions);
        INHERITABLE_SETTING(Boolean, FocusFollowMouse);
        INHERITABLE_SETTING(Boolean, ScrollToZoom);
        INHERITABLE_SETTING(Boolean, HyperlinkClickable);
        INHERITABLE_SETTING(IVector<String>, HyperlinkClickableKinds);
        INHERITABLE_SETTING(HyperlinkClickModifier, HyperlinkPrimaryClickModifier);
        INHERITABLE_SETTING(HyperlinkClickGesture, HyperlinkPrimaryClickGesture);
        INHERITABLE_SETTING(String, HyperlinkPrimaryAction);
        INHERITABLE_SETTING(HyperlinkClickModifier, HyperlinkAlternativeClickModifier);
        INHERITABLE_SETTING(HyperlinkClickGesture, HyperlinkAlternativeClickGesture);
        INHERITABLE_SETTING(String, HyperlinkAlternativeAction);
        INHERITABLE_SETTING(Int32, HyperlinkTooltipMaxWidth);
        INHERITABLE_SETTING(Int32, HyperlinkTooltipMaxHeight);
        INHERITABLE_SETTING(Boolean, HyperlinkTooltipNested);
        INHERITABLE_SETTING(Int32, HyperlinkTooltipShowDelay);
        INHERITABLE_SETTING(Int32, HyperlinkTooltipHideDelay);
        INHERITABLE_SETTING(Boolean, HyperlinkTooltipActions);
        INHERITABLE_SETTING(IVector<String>, HyperlinkTooltipButtons);
        INHERITABLE_SETTING(Boolean, HyperlinkTooltipHint);
        INHERITABLE_SETTING(Boolean, HyperlinkTooltipShowRule);
        INHERITABLE_SETTING(Boolean, HyperlinkPreviewInPane);
        INHERITABLE_SETTING(Boolean, HyperlinkRemoteFilePreviews);
        INHERITABLE_SETTING(PaneTitlebarVisibility, PaneTitlebarVisibility);
        INHERITABLE_SETTING(HyperlinkIntegrationDisplayMode, HyperlinkIntegrationDisplayMode);
        INHERITABLE_SETTING(HyperlinkActionPlacement, HyperlinkActionPlacement);
        INHERITABLE_SETTING(IVector<HyperlinkTooltipRule>, HyperlinkTooltipRules);
        INHERITABLE_SETTING(Boolean, HyperlinkManualRuleOrder);
        INHERITABLE_SETTING(Boolean, ScrollToChangeOpacity);
        INHERITABLE_SETTING(Boolean, TrimBlockSelection);
        INHERITABLE_SETTING(Boolean, DetectURLs);
        INHERITABLE_SETTING(Boolean, MinimizeToNotificationArea);
        INHERITABLE_SETTING(Boolean, ShowAdminShield);
        INHERITABLE_SETTING(IVector<NewTabMenuEntry>, NewTabMenu);
        INHERITABLE_SETTING(Boolean, EnableShellCompletionMenu);
        INHERITABLE_SETTING(Boolean, EnableUnfocusedAcrylic);
        INHERITABLE_SETTING(String, SearchWebDefaultQueryUrl);
        INHERITABLE_SETTING(IVector<String>, SafeUriSchemes);
        INHERITABLE_SETTING(ThemePair, Theme);
    }
}
