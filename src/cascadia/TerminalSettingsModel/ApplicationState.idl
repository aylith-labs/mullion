import "Command.idl";
import "GlobalAppSettings.idl";

namespace Microsoft.Terminal.Settings.Model
{
    enum InfoBarMessage
    {
        // We need a sentinel value to map deleted keys to, as we can't actually delete them (GH#16874)
        IgnoredDeprecatedEntry = 0,
        CloseOnExitInfo,
    };

    runtimeclass WindowLayout
    {
        WindowLayout();

        static String ToJson(WindowLayout layout);
        static WindowLayout FromJson(String json);

        Windows.Foundation.Collections.IVector<ActionAndArgs> TabLayout;
        Windows.Foundation.IReference<LaunchPosition> InitialPosition;
        Windows.Foundation.IReference<Windows.Foundation.Size> InitialSize;
        Windows.Foundation.IReference<LaunchMode> LaunchMode;
    };

    // The remembered geometry of a single window, saved when the window closes
    // and applied to the next window that opens under the same name. This is
    // deliberately separate from WindowLayout: it stores a real window rect in
    // physical pixels rather than a XAML content size, so that repeatedly
    // closing and reopening a window doesn't make it creep.
    runtimeclass WindowGeometry
    {
        WindowGeometry();

        Int32 Left;
        Int32 Top;
        Int32 Width;
        Int32 Height;
        UInt32 Dpi;
        LaunchMode LaunchMode;
    };

    [default_interface] runtimeclass ApplicationState {
        static ApplicationState SharedInstance();

        void Flush();
        void Reset();

        void AppendPersistedWindowLayout(WindowLayout layout);
        Boolean DismissBadge(String badgeId);
        Boolean BadgeDismissed(String badgeId);

        void SaveWorkspace(String name, WindowLayout layout);
        Boolean RemoveWorkspace(String name);
        Boolean RenameWorkspace(String oldName, String newName);
        WindowLayout TakeWorkspace(String name);
        Windows.Foundation.Collections.IMapView<String, WindowLayout> AllPersistedWorkspaces();

        void SaveWindowGeometry(String name, WindowGeometry geometry);
        WindowGeometry LookupWindowGeometry(String name);

        void SetSettingsGroupExpanded(String key, Boolean expanded);
        Windows.Foundation.IReference<Boolean> SettingsGroupExpanded(String key);

        // Two pieces of Settings UI chrome, kept here rather than in settings.json
        // alongside ExpandedSettingsGroups: they describe how the editor presents
        // itself, not how the Terminal behaves, and they have to persist the moment
        // they are flipped. A global setting would live on the editor's settings
        // clone instead, which would make turning either of them on count as an
        // unsaved change - and both exist to interact with the Save button.
        Boolean SettingsShowDescriptions;
        Boolean SettingsAutoSave;

        // The settings the Settings search box was last used to reach, newest first.
        // Here for the same reason as the two above: it is a record of how the editor
        // was used, not a setting, and it has to survive being written the moment a
        // result is chosen.
        Windows.Foundation.Collections.IVector<String> SettingsSearchHistory;

        String SettingsHash;
        Windows.Foundation.Collections.IVector<WindowLayout> PersistedWindowLayouts;
        Windows.Foundation.Collections.IVector<String> RecentCommands;
        Windows.Foundation.Collections.IVector<InfoBarMessage> DismissedMessages;
        Windows.Foundation.Collections.IVector<String> AllowedCommandlines;
    }
}
