{
    "id": "jira",
    "name": "Jira",
    "icon": "ms-appx:///IntegrationIcons/jira.png",
    "version": 2,
    "cacheSeconds": 300,
    "settings": [
        {
            "key": "host",
            "label": "Site host",
            "placeholder": "acme.atlassian.net",
            "description": "The Jira Cloud site (or Jira Server host) whose links to preview. Credentials are only ever sent to this host.",
            "required": true
        }
    ],
    "credentials": [
        {
            "key": "email",
            "label": "Account email",
            "description": "The Atlassian account the API token belongs to.",
            "secret": false,
            "required": true
        },
        {
            "key": "token",
            "label": "API token",
            "description": "Create one at id.atlassian.com → Security → API tokens.",
            "secret": true,
            "required": true
        }
    ],
    "matchers": [
        {
            "kind": "link",
            "pattern": "^https?://[^/]+/browse/(?<key>[A-Z][A-Z0-9]+-\\d+)",
            "hostSetting": "host"
        },
        {
            "kind": "text",
            "pattern": "\\b(?<key>[A-Z][A-Z0-9]{1,9}-\\d{1,7})\\b",
            "suggested": true,
            "description": "Issue keys in output, like ACME-8209",
            "link": "https://{{settings.host}}/browse/{{key}}"
        }
    ],
    "fetch": [
        {
            "id": "issue",
            "type": "http",
            "method": "GET",
            "url": "https://{{settings.host}}/rest/api/3/issue/{{key}}?fields=summary,status,resolution,assignee,priority,issuetype,updated,reporter,description,parent",
            "auth": { "type": "basic", "user": "{{credentials.email}}", "password": "{{credentials.token}}" },
            "headers": { "Accept": "application/json" },
            "timeoutMs": 8000
        },
        {
            "id": "comments",
            "type": "http",
            "method": "GET",
            "optional": true,
            "deferred": true,
            "url": "https://{{settings.host}}/rest/api/3/issue/{{key}}/comment?maxResults=50",
            "auth": { "type": "basic", "user": "{{credentials.email}}", "password": "{{credentials.token}}" },
            "headers": { "Accept": "application/json" },
            "timeoutMs": 8000
        },
        {
            "id": "transitions",
            "type": "http",
            "method": "GET",
            "optional": true,
            "url": "https://{{settings.host}}/rest/api/3/issue/{{key}}/transitions?expand=transitions.fields",
            "auth": { "type": "basic", "user": "{{credentials.email}}", "password": "{{credentials.token}}" },
            "headers": { "Accept": "application/json" },
            "timeoutMs": 8000
        },
        {
            "id": "devsummary",
            "type": "http",
            "method": "GET",
            "optional": true,
            "when": "{{issue:/id}}",
            "url": "https://{{settings.host}}/rest/dev-status/latest/issue/summary?issueId={{issue:/id}}",
            "auth": { "type": "basic", "user": "{{credentials.email}}", "password": "{{credentials.token}}" },
            "headers": { "Accept": "application/json" },
            "timeoutMs": 8000
        },
        {
            "id": "devdetail",
            "type": "http",
            "method": "GET",
            "optional": true,
            "when": "{{issue:/id}}",
            "url": "https://{{settings.host}}/rest/dev-status/latest/issue/detail?issueId={{issue:/id}}&applicationType=GitHub&dataType=pullrequest",
            "auth": { "type": "basic", "user": "{{credentials.email}}", "password": "{{credentials.token}}" },
            "headers": { "Accept": "application/json" },
            "timeoutMs": 8000
        }
    ],
    "fieldGroups": [
        {
            "key": "details",
            "label": "Details",
            "fields": [ "summary", "parent", "issueKey", "status", "resolution", "type", "priority", "assignee", "reporter", "updated" ]
        },
        {
            "key": "development",
            "label": "Development",
            "fields": [ "devBranches", "devCommits", "devPullRequests", "devPullLinks", "devPullRequestState", "devLatestPull", "devLatestPullState", "devBuilds", "devBuildsFailed", "devDeployments" ]
        }
    ],
    "fields": [
        { "key": "summary", "label": "Summary", "path": "issue:/fields/summary", "kind": "title", "default": true },

        { "key": "parent", "placement": "breadcrumb", "label": "Parent", "path": "issue:/fields/parent/key", "link": "https://{{settings.host}}/browse/{{issue:/fields/parent/key}}", "iconPath": "issue:/fields/parent/fields/issuetype/iconUrl", "kind": "text", "default": true },
        { "key": "issueKey", "placement": "breadcrumb", "label": "Key", "path": "issue:/key", "link": "https://{{settings.host}}/browse/{{issue:/key}}", "iconPath": "issue:/fields/issuetype/iconUrl", "kind": "text", "default": true },

        { "key": "status", "placement": "status", "label": "Status", "path": "issue:/fields/status/name", "kind": "badge", "colorPath": "issue:/fields/status/statusCategory/colorName", "default": true },
        { "key": "resolution", "label": "Resolution", "path": "issue:/fields/resolution/name", "kind": "badge", "default": false },
        { "key": "type", "link": "https://{{settings.host}}/issues/?jql=issuetype%3D{{issue:/fields/issuetype/id}}", "label": "Type", "path": "issue:/fields/issuetype/name", "kind": "text", "iconPath": "issue:/fields/issuetype/iconUrl", "default": true },
        { "key": "priority", "link": "https://{{settings.host}}/issues/?jql=priority%3D{{issue:/fields/priority/id}}", "label": "Priority", "path": "issue:/fields/priority/name", "kind": "text", "iconPath": "issue:/fields/priority/iconUrl", "default": true },
        { "key": "assignee", "label": "Assignee", "path": "issue:/fields/assignee/displayName", "kind": "text", "iconPath": "issue:/fields/assignee/avatarUrls/48x48", "default": true },
        { "key": "reporter", "label": "Reporter", "path": "issue:/fields/reporter/displayName", "kind": "text", "iconPath": "issue:/fields/reporter/avatarUrls/48x48", "default": false },
        { "key": "updated", "label": "Updated", "path": "issue:/fields/updated", "kind": "text", "format": "relativeTime", "default": true },

        { "key": "devBranches", "label": "Branches", "path": "devsummary:/summary/branch/overall/count", "kind": "text", "default": false },
        { "key": "devCommits", "label": "Commits", "path": "devsummary:/summary/repository/overall/count", "kind": "text", "default": false },
        { "key": "devPullRequests", "label": "Pull requests", "path": "devsummary:/summary/pullrequest/overall/count", "kind": "text", "default": false },
        { "key": "devPullLinks", "label": "Pull request", "each": "devdetail:/detail/0/pullRequests", "path": "item:/name", "linkPath": "item:/url", "kind": "link", "default": true },
        { "key": "devPullRequestState", "label": "Pull request state", "path": "devsummary:/summary/pullrequest/overall/state", "kind": "badge", "default": false },
        { "key": "devLatestPull", "label": "Latest pull request", "path": "devdetail:/detail/0/pullRequests/0/name", "kind": "text", "default": false },
        { "key": "devLatestPullState", "label": "Latest pull request status", "path": "devdetail:/detail/0/pullRequests/0/status", "kind": "badge", "default": false },
        { "key": "devBuilds", "label": "Builds", "path": "devsummary:/summary/build/overall/count", "kind": "text", "default": false },
        { "key": "devBuildsFailed", "label": "Failed builds", "path": "devsummary:/summary/build/overall/failedBuildCount", "kind": "text", "default": false },
        { "key": "devDeployments", "label": "Deployments", "path": "devsummary:/summary/deployment-environment/overall/count", "kind": "text", "default": false }
    ],
    "tabs": [
        {
            "key": "description",
            "label": "Description",
            "kind": "body",
            "path": "issue:/fields/description",
            "format": "adf",
            "default": true
        },
        {
            "key": "comments",
            "label": "Comments",
            "kind": "list",
            "step": "comments",
            "path": "comments:/comments",
            "format": "adf",
            "itemAuthorPath": "/author/displayName",
            "itemAvatarPath": "/author/avatarUrls/48x48",
            "itemBodyPath": "/body",
            "itemTimePath": "/created",
            "default": false
        }
    ],
    "actions": [
        {
            "key": "transition",
            "label": "Change status",
            "kind": "choice",
            "optionsPath": "transitions:/transitions",
            "optionIdPath": "/id",
            "optionLabelPath": "/name",
            "optionBadgePath": "/to/name",
            "optionColorPath": "/to/statusCategory/colorName",
            "optionTargetIdPath": "/to/id",
            "optionFieldsPath": "/fields",
            "currentStatePath": "issue:/fields/status/id",
            "method": "POST",
            "url": "https://{{settings.host}}/rest/api/3/issue/{{key}}/transitions",
            "body": "{\"transition\":{\"id\":\"{{choice}}\"}}",
            "auth": { "type": "basic", "user": "{{credentials.email}}", "password": "{{credentials.token}}" },
            "headers": { "Accept": "application/json", "Content-Type": "application/json" },
            "timeoutMs": 8000
        }
    ],
    "account": { "provider": "jira" }
}
