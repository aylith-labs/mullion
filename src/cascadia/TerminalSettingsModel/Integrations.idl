namespace Microsoft.Terminal.Settings.Model
{
    // What an integration matcher runs against: the URI of a hovered link, or
    // plain terminal text (turned hoverable by a text-kind HyperlinkTooltipRule).
    enum IntegrationMatcherKind
    {
        Link = 0,
        Text
    };

    // How a fetch step obtains its JSON result.
    enum IntegrationFetchType
    {
        Http = 0,
        Command
    };

    // How a display field is rendered on the hyperlink card.
    enum IntegrationFieldKind
    {
        Text = 0,
        Title,
        Subtitle,
        Badge,
        Link,
        Image,
        Multiline
    };

    // What a tab holds: one long value (a description) or a repeating list of
    // authored entries (comments).
    enum IntegrationTabKind
    {
        Body = 0,
        List
    };

    // What running an action does: fire one request, or pick from a list the
    // fetch produced and then fire a request for the chosen one.
    enum IntegrationActionKind
    {
        Button = 0,
        Choice
    };

    // A tab of secondary content, shown beside the fields when the user turns
    // it on. Body reads one value; List repeats one entry shape over an array.
    [default_interface] runtimeclass IntegrationTab
    {
        IntegrationTab();

        String Key;
        String Label;
        IntegrationTabKind Kind;
        // Body: the value itself. List: the array to repeat over.
        String Path;
        // "markdown", "adf" (Atlassian Document Format) or "text".
        String Format;
        // List only, relative to each element of Path.
        String ItemAuthorPath;
        String ItemAvatarPath;
        String ItemBodyPath;
        String ItemTimePath;
        // The deferred fetch step this tab's content comes from, if any. The
        // step is skipped by the fetch that paints the card and run when the
        // tab is first opened. Empty means the content is already in the
        // results the card was built from, and only the building is deferred.
        String StepId;
        Boolean DefaultVisible;
    }

    // Something the user can do to the thing behind the link -- a Jira
    // transition, say. Choice actions offer the options a fetch step produced.
    [default_interface] runtimeclass IntegrationAction
    {
        IntegrationAction();

        String Key;
        String Label;
        IntegrationActionKind Kind;

        // --- Choice: where the options are and how to read one ---
        String OptionsPath;
        String OptionIdPath;
        String OptionLabelPath;
        String OptionBadgePath;
        String OptionColorPath;
        // The state this option moves the thing to, and where the thing's
        // current state is: together they let an undo find the way back.
        String OptionTargetIdPath;
        String CurrentStatePath;
        // Per-option fields the far end demands before it will accept the
        // change (Jira's "pick a resolution" dialog).
        String OptionFieldsPath;

        // --- The request. {{choice}} is the chosen option's id and
        //     {{field.<key>}} a value the user filled in. ---
        String Method;
        String Url;
        String Body;
        Windows.Foundation.Collections.IMap<String, String> Headers;
        String AuthType;
        String AuthUser;
        String AuthPassword;
        Boolean AllowUntrustedCertificate;
        Int32 TimeoutMs;
    }

    // A named set of display fields, shown together and turned on or off as a
    // unit in the settings.
    [default_interface] runtimeclass IntegrationFieldGroup
    {
        IntegrationFieldGroup();

        String Key;
        String Label;
        Windows.Foundation.Collections.IVector<String> Fields;
    }

    // A user-provided value the integration needs: a plain setting (stored in
    // settings.json) or a credential (stored in the Windows credential vault,
    // never in settings.json).
    [default_interface] runtimeclass IntegrationField
    {
        IntegrationField();

        String Key;
        String Label;
        String Placeholder;
        String Editor;
        String Description;
        Boolean Required;
        Boolean Secret;
        String DefaultValue;
    }

    // Decides whether a link (or text match) belongs to this integration, and
    // captures the named groups the fetch templates refer to.
    [default_interface] runtimeclass IntegrationMatcher
    {
        IntegrationMatcher();

        IntegrationMatcherKind Kind;
        // ICU regular expression; named groups become template variables.
        String Pattern;
        // For Link matchers: the URI's host must equal the value of this setting.
        // Keeps credentials from ever being sent because of a look-alike link.
        String HostSetting;
        // For Text matchers: how a match becomes a URL (Open / Copy link / click).
        String LinkTemplate;
        // What opening a match should DO, when following a URL is the wrong
        // answer. Names either one of this manifest's own "actions" entries or
        // a built-in button id, and it takes precedence over LinkTemplate on
        // the click path only -- Copy link still copies the URL.
        //
        // This is what lets a scheme the manifest owns act without an OS
        // protocol handler: `stith://focus/<id>` runs the plugin's focus
        // request instead of reaching ShellExecute, which on this machine
        // hands it to a handler that implements only some of the verbs and
        // silently drops the rest.
        String OpenAction;
        // Text matchers only: offered on the Integrations page as "Add as rule".
        Boolean Suggested;
        String Description;
    }

    // One request in the integration's fetch pipeline. Later steps may refer to
    // earlier results through {{stepId:/json/pointer}} template variables.
    [default_interface] runtimeclass IntegrationFetchStep
    {
        IntegrationFetchStep();

        String Id;
        IntegrationFetchType Type;

        // Http
        String Url;
        String Method;
        Windows.Foundation.Collections.IMap<String, String> Headers;
        String AuthType;      // "basic" | "bearer" | "header" | ""
        String AuthUser;      // basic: user template; header: header name
        String AuthPassword;  // basic: password template; bearer/header: value template
        String Body;
        Boolean AllowUntrustedCertificate;

        // Command
        String CommandLine;
        String Stdin;

        Int32 TimeoutMs;
        // Run only when this template expands to a non-empty string.
        String When;
        // Skip when this template expands to a non-empty string.
        String Unless;
        // A failing optional step is recorded and stepped over rather than
        // ending the fetch -- for an endpoint that may not exist on every
        // server, or a probe that is allowed to come back empty.
        Boolean Optional;
        // Not run by the fetch that paints the card: run later, when a tab
        // naming this step is first opened. For a payload nobody has asked to
        // see yet -- a hundred issue comments behind a Comments tab.
        Boolean Deferred;
    }

    // One row of the card's representation of a fetched result.
    [default_interface] runtimeclass IntegrationDisplayField
    {
        IntegrationDisplayField();

        String Key;
        String Label;
        // JSON pointer into a step result: "/a/0/b" or "stepId:/a/0/b".
        String Path;
        IntegrationFieldKind Kind;
        String IconPath;
        // A JSON pointer to an ARRAY. The field then renders once per element,
        // and its own pointers and templates read that element as the step id
        // "item" -- "item:/url". Empty means one row, as usual.
        String EachPath;
        String Placement;
        String LinkTemplate;
        // A URL the result already carries, as a pointer. LinkTemplate builds a
        // URL out of pieces and percent-encodes each one, which is right for a
        // key pasted into a query and wrong for a whole href -- a pull request's
        // own html_url would come back with its scheme escaped.
        String LinkPath;
        String ColorPath;
        String Color;
        String Format;        // "relativeTime" | "date" | ""
        Boolean DefaultVisible;
    }

    // A parsed integration.json: the plugin's knowledge of a tool (how to match
    // it, what to call, how to authenticate) and of its representation.
    [default_interface] runtimeclass IntegrationManifest
    {
        IntegrationManifest();

        String Id;
        String Name;
        String Icon;
        Int32 Version;
        // Where it came from: "built-in" or the manifest's path.
        String Source;
        Boolean IsBuiltIn;
        Int32 CacheSeconds;
        // Optional HTML/CSS/JS representation; empty means "use Fields".
        String Html;
        // Optional URL template of a page that shows the linked thing in full -- the
        // integration's own embeddable view. Offered on the card as "Details".
        String Embed;
        String AccountProvider;

        Windows.Foundation.Collections.IVector<IntegrationField> Settings;
        Windows.Foundation.Collections.IVector<IntegrationField> Credentials;
        Windows.Foundation.Collections.IVector<IntegrationMatcher> Matchers;
        Windows.Foundation.Collections.IVector<IntegrationFetchStep> FetchSteps;
        Windows.Foundation.Collections.IVector<IntegrationDisplayField> Fields;
        Windows.Foundation.Collections.IVector<IntegrationFieldGroup> FieldGroups;
        Windows.Foundation.Collections.IVector<IntegrationTab> Tabs;
        Windows.Foundation.Collections.IVector<IntegrationAction> Actions;
        // Patterns the terminal scans output for while this integration is
        // enabled, so a scheme it owns (stith://, say) is hoverable even when
        // nothing marked it as a link.
        Windows.Foundation.Collections.IVector<String> DetectPatterns;
    }

    // The user's per-integration configuration, persisted in settings.json under
    // "integrations": { "<id>": { ... } }. Secrets never live here.
    [default_interface] runtimeclass IntegrationSettings
    {
        IntegrationSettings();

        Boolean Enabled;
        Windows.Foundation.Collections.IMap<String, String> Values;
        // Which display fields the user turned on, and which off, by key.
        //
        // A key the map does not mention takes the manifest's own default. That
        // is the whole point of the shape: a field a manifest gains later has
        // never been offered to anyone, so it arrives at its default instead of
        // being read as declined -- which is what a list of "the keys to show"
        // could not express, since absence meant both things at once.
        Windows.Foundation.Collections.IMap<String, Boolean> Fields;
        // Same, for tabs.
        Windows.Foundation.Collections.IMap<String, Boolean> Tabs;
    }

    // Discovers manifests: built-ins embedded in this DLL, then
    // %LOCALAPPDATA%\Microsoft\Windows Terminal\Integrations\<id>\integration.json
    // (a user manifest with the same id replaces a built-in).
    static runtimeclass IntegrationRegistry
    {
        static Windows.Foundation.Collections.IVector<IntegrationManifest> All();
        static IntegrationManifest Find(String id);
        static String UserDirectory();
        static void Refresh();
    }

    // Credentials in the Windows credential vault (Credential Manager -> Web
    // Credentials), keyed by integration id and field key.
    static runtimeclass IntegrationCredentialStore
    {
        static String Get(String integrationId, String key);
        static void Set(String integrationId, String key, String value);
        static void Remove(String integrationId, String key);
        static Boolean Has(String integrationId, String key);
    }
}
