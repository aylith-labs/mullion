<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Keep the version in step with WebView2PackageRoot in src\common.nugetversions.targets. -->
    <MullionWebView2Arch>$(Platform.ToLowerInvariant())</MullionWebView2Arch>
    <MullionWebView2Arch Condition="'$(MullionWebView2Arch)'=='win32'">x86</MullionWebView2Arch>
    <MullionWebView2Loader>$(OpenConsoleDir)packages\Microsoft.Web.WebView2.1.0.1661.34\build\native\$(MullionWebView2Arch)\WebView2Loader.dll</MullionWebView2Loader>
  </PropertyGroup>
  <Target Name="MullionCheckWebView2Loader" BeforeTargets="Build">
    <Error Condition="!Exists('$(MullionWebView2Loader)')" Text="WebView2Loader.dll not found at $(MullionWebView2Loader); the link card's Details page would silently never appear. Was dep\nuget\packages.config restored?" />
  </Target>
  <ItemGroup>
    <!-- License Info -->
    <Content Include="$(OpenConsoleDir)src\cascadia\CascadiaPackage\NOTICE.html">
      <DeploymentContent>true</DeploymentContent>
      <Link>%(FileName)%(Extension)</Link>
    </Content>
    <!-- Images -->
    <Content Include="$(OpenConsoleDir)res\terminal\images$(WindowsTerminalAssetSuffix)\**\*">
      <DeploymentContent>true</DeploymentContent>
      <Link>Images\%(RecursiveDir)%(FileName)%(Extension)</Link>
    </Content>
    <!-- Fonts -->
    <Content Include="$(OpenConsoleDir)res\fonts\*.ttf" Condition="'$(WindowsTerminalOfficialBuild)'=='true'">
      <DeploymentContent>true</DeploymentContent>
      <Link>%(FileName)%(Extension)</Link>
    </Content>
    <!-- Profile Icons -->
    <Content Include="$(OpenConsoleDir)src\cascadia\CascadiaPackage\ProfileIcons\**\*">
      <DeploymentContent>true</DeploymentContent>
      <Link>ProfileIcons\%(RecursiveDir)%(FileName)%(Extension)</Link>
    </Content>
    <!-- Profile Generator Icons -->
    <Content Include="$(OpenConsoleDir)src\cascadia\CascadiaPackage\ProfileGeneratorIcons\**\*">
      <DeploymentContent>true</DeploymentContent>
      <Link>ProfileGeneratorIcons\%(RecursiveDir)%(FileName)%(Extension)</Link>
    </Content>
    <!-- Integration Icons -->
    <Content Include="$(OpenConsoleDir)src\cascadia\CascadiaPackage\IntegrationIcons\**\*">
      <DeploymentContent>true</DeploymentContent>
      <Link>IntegrationIcons\%(RecursiveDir)%(FileName)%(Extension)</Link>
    </Content>
    <!-- In-app documentation. The Settings UI's Documentation page reads these off
         disk at Docs\<topic>.md beside the binaries, which is exactly what this Link
         produces; without the Link they would land in the package root instead, and
         the page would draw its "not installed" message with a green build behind it. -->
    <Content Include="$(OpenConsoleDir)src\cascadia\CascadiaPackage\Docs\**\*">
      <DeploymentContent>true</DeploymentContent>
      <Link>Docs\%(RecursiveDir)%(FileName)%(Extension)</Link>
    </Content>
    <!-- WebView2's loader, beside the binaries, for the link card's HTML host and its
         Details page (HyperlinkHtmlHost). It is loaded by name at runtime (nothing
         links it), so a package without it still runs, it just never offers Details.
         That makes a miss here silent, hence the explicit check target below. -->
    <Content Include="$(MullionWebView2Loader)">
      <DeploymentContent>true</DeploymentContent>
      <Link>%(FileName)%(Extension)</Link>
    </Content>
    <!-- Default Settings -->
    <Content Include="$(OpenConsoleDir)src\cascadia\TerminalSettingsModel\defaults.json">
      <DeploymentContent>true</DeploymentContent>
      <Link>%(RecursiveDir)%(FileName)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <!-- Reprint all content as Nones for Universal project type to include it in the resources -->
  <ItemGroup>
    <None Include="@(Content)" />
  </ItemGroup>
</Project>
